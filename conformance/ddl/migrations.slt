# Advisory locks: session locks are reentrant and block other sessions
query
SELECT pg_advisory_lock(1), pg_try_advisory_lock(1)
----
pg_advisory_lock:void | pg_try_advisory_lock:bool
(empty) | t

connection other
query
SELECT pg_try_advisory_lock(1)
----
pg_try_advisory_lock:bool
f

query
SELECT pg_advisory_unlock(1), pg_advisory_unlock(1), pg_advisory_unlock(1)
----
pg_advisory_unlock:bool | pg_advisory_unlock:bool | pg_advisory_unlock:bool
t | t | f

connection other
query
SELECT pg_try_advisory_lock(1), pg_advisory_unlock_all()
----
pg_try_advisory_lock:bool | pg_advisory_unlock_all:void
t | (empty)

query
SELECT pg_advisory_lock(3, 4), pg_advisory_unlock(3, 4), pg_advisory_lock(12345::bigint), pg_advisory_unlock(12345::bigint)
----
pg_advisory_lock:void | pg_advisory_unlock:bool | pg_advisory_lock:void | pg_advisory_unlock:bool
(empty) | t | (empty) | t

# Transaction-level advisory locks are released at commit
statement ok
BEGIN

query
SELECT pg_try_advisory_xact_lock(7)
----
pg_try_advisory_xact_lock:bool
t

connection other
query
SELECT pg_try_advisory_lock(7)
----
pg_try_advisory_lock:bool
f

statement ok
COMMIT

connection other
query
SELECT pg_try_advisory_lock(7), pg_advisory_unlock(7)
----
pg_try_advisory_lock:bool | pg_advisory_unlock:bool
t | t

# LOCK TABLE
statement ok
BEGIN; LOCK TABLE schema_migrations IN ACCESS EXCLUSIVE MODE; COMMIT

statement error 25P01 LOCK TABLE can only be used in transaction blocks
LOCK TABLE schema_migrations

# DO blocks
statement ok
DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'status') THEN CREATE TYPE status AS ENUM ('a', 'b'); END IF; END $$; DO $$ BEGIN CREATE TYPE status AS ENUM ('a'); EXCEPTION WHEN duplicate_object THEN null; END $$

statement ok
DO $$ DECLARE i int; BEGIN FOR i IN 1..3 LOOP INSERT INTO schema_migrations VALUES ('do_' || i); END LOOP; END $$; DO $$ BEGIN EXECUTE 'ALTER TABLE schema_migrations ADD COLUMN IF NOT EXISTS dirty boolean NOT NULL DEFAULT false'; END $$

query
SELECT version, dirty FROM schema_migrations ORDER BY version
----
version:varchar | dirty:bool
20240101000000 | f
20240102000000 | f
do_1 | f
do_2 | f
do_3 | f

