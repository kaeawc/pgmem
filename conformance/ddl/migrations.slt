DO $$ BEGIN RAISE EXCEPTION 'boom'; END $$

# SQL functions and procedures
statement ok
CREATE FUNCTION add_one(x int) RETURNS int LANGUAGE sql IMMUTABLE AS $$ SELECT x + 1 $$

statement error 42723 function "add_one" already exists with same argument types
CREATE FUNCTION add_one(x int) RETURNS int LANGUAGE sql AS $$ SELECT x + 2 $$

statement ok
CREATE OR REPLACE FUNCTION add_one(x int) RETURNS int LANGUAGE sql AS $$ SELECT x + 2 $$

statement error 42P13 cannot change return type of existing function
CREATE OR REPLACE FUNCTION add_one(x int) RETURNS bigint LANGUAGE sql AS $$ SELECT (x + 2)::bigint $$

statement ok
CREATE FUNCTION add_one(x text) RETURNS text LANGUAGE sql AS $$ SELECT x || '1' $$

query
SELECT add_one(40), add_one('a')
----
add_one:int4 | add_one:text
42 | a1

statement error 42725 function name "add_one" is not unique
DROP FUNCTION add_one

statement ok
CREATE FUNCTION versions() RETURNS SETOF text LANGUAGE sql STABLE AS $$ SELECT version FROM schema_migrations WHERE version LIKE '2024%' ORDER BY version $$; CREATE FUNCTION mul(a int, b int) RETURNS int LANGUAGE sql RETURN a * b

query
SELECT v, mul(6, 7) FROM versions() AS v
----
v:text | mul:int4
20240101000000 | 42
20240102000000 | 42

statement ok
CREATE PROCEDURE log_version(v text) LANGUAGE sql AS $$ INSERT INTO schema_migrations VALUES (v) $$; CALL log_version('proc')

query
SELECT count(*) FROM schema_migrations WHERE version = 'proc'
----
count:int8
1

# plpgsql functions
statement ok
CREATE FUNCTION classify(n int) RETURNS text LANGUAGE plpgsql AS $$ DECLARE r text; BEGIN IF n < 0 THEN r := 'neg'; ELSIF n = 0 THEN r := 'zero'; ELSE r := 'pos'; END IF; RETURN r; END $$; CREATE FUNCTION safe_div(a int, b int) RETURNS int LANGUAGE plpgsql AS $$ BEGIN RETURN a / b; EXCEPTION WHEN division_by_zero THEN RETURN NULL; END $$

query
SELECT classify(-5), classify(0), classify(9), safe_div(10, 2), safe_div(1, 0)
----
classify:text | classify:text | classify:text | safe_div:int4 | safe_div:int4
neg | zero | pos | 5 | NULL

statement ok
CREATE FUNCTION fail_if(b boolean) RETURNS void LANGUAGE plpgsql AS $$ BEGIN IF b THEN RAISE EXCEPTION 'custom failure %', 42 USING ERRCODE = '22023'; END IF; END $$

statement error 22023 custom failure 42
SELECT fail_if(true)

# Triggers: BEFORE UPDATE maintaining version / updated_at
statement ok
CREATE TABLE docs (id int PRIMARY KEY, body text, version int NOT NULL DEFAULT 0, updated_at timestamptz); CREATE FUNCTION bump_version() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN NEW.version := OLD.version + 1; NEW.updated_at := '2024-06-01 00:00:00+00'; RETURN NEW; END $$; CREATE TRIGGER docs_bump BEFORE UPDATE ON docs FOR EACH ROW EXECUTE FUNCTION bump_version(); INSERT INTO docs (id, body) VALUES (1, 'v0'); UPDATE docs SET body = 'v1'; UPDATE docs SET body = 'v2'

query
SELECT id, body, version, updated_at FROM docs
----
id:int4 | body:text | version:int4 | updated_at:timestamptz
1 | v2 | 2 | 2024-06-01 00:00:00+00

# AFTER trigger with TG_OP (audit log)
statement ok
CREATE TABLE audit (op text, doc_id int); CREATE FUNCTION audit_docs() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF TG_OP = 'DELETE' THEN INSERT INTO audit VALUES (TG_OP, OLD.id); RETURN OLD; END IF; INSERT INTO audit VALUES (TG_OP, NEW.id); RETURN NEW; END $$; CREATE TRIGGER docs_audit AFTER INSERT OR UPDATE OR DELETE ON docs FOR EACH ROW EXECUTE PROCEDURE audit_docs(); INSERT INTO docs (id, body) VALUES (2, 'x'); UPDATE docs SET body = 'y' WHERE id = 2; DELETE FROM docs WHERE id = 2

query
SELECT op, doc_id FROM audit ORDER BY op
----
op:text | doc_id:int4
DELETE | 2
INSERT | 2
UPDATE | 2

# BEFORE trigger rejecting rows; WHEN clause; DISABLE TRIGGER
statement ok
CREATE FUNCTION no_empty() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.body = '' THEN RAISE EXCEPTION 'empty body' USING ERRCODE = 'check_violation'; END IF; RETURN NEW; END $$; CREATE TRIGGER docs_no_empty BEFORE INSERT ON docs FOR EACH ROW EXECUTE FUNCTION no_empty()

statement error 23514 empty body
INSERT INTO docs (id, body) VALUES (3, '')

statement ok
CREATE OR REPLACE TRIGGER docs_no_empty BEFORE INSERT ON docs FOR EACH ROW WHEN (NEW.id > 100) EXECUTE FUNCTION no_empty(); INSERT INTO docs (id, body) VALUES (3, ''); ALTER TABLE docs DISABLE TRIGGER docs_bump; UPDATE docs SET body = 'v3' WHERE id = 1

query
SELECT id, body, version FROM docs ORDER BY id
----
id:int4 | body:text | version:int4
1 | v3 | 2
3 | (empty) | 0

statement ok
DROP TRIGGER docs_audit ON docs

statement error 42704 trigger "docs_audit" for table "docs" does not exist
DROP TRIGGER docs_audit ON docs

query
SELECT trigger_name, event_manipulation, action_timing FROM information_schema.triggers WHERE event_object_table = 'docs' ORDER BY trigger_name, event_manipulation
----
trigger_name:name | event_manipulation:varchar | action_timing:varchar
docs_bump | UPDATE | BEFORE
docs_no_empty | INSERT | BEFORE

# Transactional DDL: a failed migration leaves nothing behind
statement ok
BEGIN; CREATE TABLE half_done (a int)

statement error 42701 column "a" of relation "half_done" already exists
ALTER TABLE half_done ADD COLUMN a int

statement error 25P02 current transaction is aborted, commands ignored until end of transaction block
CREATE INDEX ON half_done (a)

statement ok
ROLLBACK

statement error 42P01 relation "half_done" does not exist
SELECT * FROM half_done
