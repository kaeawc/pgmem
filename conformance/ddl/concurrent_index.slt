statement error 42P07 relation "d_a_idx" already exists
CREATE INDEX d_a_idx ON d (a)

statement ok
CREATE INDEX CONCURRENTLY IF NOT EXISTS d_a_idx ON d (a)

# It is not maintained, so not enforced and not an ON CONFLICT arbiter
statement ok
INSERT INTO d VALUES (1)

statement error 42P10 there is no unique or exclusion constraint matching the ON CONFLICT specification
INSERT INTO d VALUES (1) ON CONFLICT (a) DO NOTHING

statement ok
INSERT INTO d VALUES (1) ON CONFLICT DO NOTHING

