# An error while building leaves one too; errors before the build do not
statement ok
CREATE TABLE x (a int); INSERT INTO x VALUES (0), (1)

statement error 22012 division by zero
CREATE INDEX CONCURRENTLY x_expr ON x ((1 / a))

statement error 22012 division by zero
CREATE INDEX CONCURRENTLY x_pred ON x (a) WHERE 1 / a > 0

statement error 22012 division by zero
CREATE INDEX x_plain ON x ((1 / a))

statement error 22012 division by zero
CREATE INDEX x_plain_pred ON x (a) WHERE 1 / a > 0

statement error 42703 column "nope" does not exist
