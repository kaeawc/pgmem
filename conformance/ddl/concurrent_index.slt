# CONCURRENTLY commands: refused in a transaction block (explicit or implicit), DROP INDEX
# CONCURRENTLY's restrictions, and the invalid index a failed CREATE INDEX CONCURRENTLY leaves.

statement ok
CREATE TABLE t (id int, a int); CREATE INDEX i1 ON t (id); CREATE INDEX i2 ON t (a)

# Refused inside a transaction block
statement ok
BEGIN

statement error 25001 DROP INDEX CONCURRENTLY cannot run inside a transaction block
DROP INDEX CONCURRENTLY i1

statement ok
ROLLBACK

statement error 25001 DROP INDEX CONCURRENTLY cannot run inside a transaction block
BEGIN; DROP INDEX CONCURRENTLY i1; COMMIT

statement ok
ROLLBACK

statement error 25001 DROP INDEX CONCURRENTLY cannot run inside a transaction block
SELECT 1; DROP INDEX CONCURRENTLY i1

statement error 25001 DROP INDEX CONCURRENTLY cannot run inside a transaction block
DROP INDEX CONCURRENTLY i1; SELECT 1

statement error 25001 CREATE INDEX CONCURRENTLY cannot run inside a transaction block
SELECT 1; CREATE INDEX CONCURRENTLY i3 ON t (a)

statement error 25001 REINDEX CONCURRENTLY cannot run inside a transaction block
SELECT 1; REINDEX INDEX CONCURRENTLY i1

statement ok
BEGIN

statement error 25001 REINDEX CONCURRENTLY cannot run inside a transaction block
REINDEX TABLE CONCURRENTLY t

statement ok
ROLLBACK

statement ok
BEGIN

statement error 25001 REINDEX CONCURRENTLY cannot run inside a transaction block
REINDEX (CONCURRENTLY) INDEX i1

statement ok
ROLLBACK

statement ok
BEGIN

statement error 25001 REINDEX SCHEMA cannot run inside a transaction block
REINDEX SCHEMA public

statement ok
ROLLBACK

# Allowed in a block
statement ok
BEGIN; REINDEX INDEX i1; REINDEX TABLE t; REINDEX (CONCURRENTLY false) INDEX i1; COMMIT

statement ok
CREATE MATERIALIZED VIEW mv AS SELECT 1 AS x; CREATE UNIQUE INDEX mv_x ON mv (x)

statement ok
BEGIN; REFRESH MATERIALIZED VIEW CONCURRENTLY mv; COMMIT

query
SELECT indexname FROM pg_indexes WHERE tablename = 't' ORDER BY 1
----
indexname:name
i1
i2

# One index, no CASCADE
statement error 0A000 DROP INDEX CONCURRENTLY does not support dropping multiple objects
DROP INDEX CONCURRENTLY i1, i2

statement error 0A000 DROP INDEX CONCURRENTLY does not support dropping multiple objects
DROP INDEX CONCURRENTLY IF EXISTS nosuch, nosuch2

statement error 0A000 DROP INDEX CONCURRENTLY does not support CASCADE
DROP INDEX CONCURRENTLY i1 CASCADE

statement error 0A000 DROP INDEX CONCURRENTLY does not support CASCADE
DROP INDEX CONCURRENTLY nosuch CASCADE

statement error 0A000 DROP INDEX CONCURRENTLY does not support dropping multiple objects
DROP INDEX CONCURRENTLY i1, i2 CASCADE

statement ok
DROP INDEX CONCURRENTLY IF EXISTS nosuch

statement error 42704 index "nosuch" does not exist
DROP INDEX CONCURRENTLY nosuch

statement ok
DROP INDEX CONCURRENTLY i1 RESTRICT

statement ok
DROP INDEX CONCURRENTLY i2

query
SELECT indexname FROM pg_indexes WHERE tablename = 't' ORDER BY 1
----
indexname:name

# REINDEX names the right kind of relation
statement ok
CREATE INDEX t_id_idx ON t (id)

statement error 42809 "t" is not an index
REINDEX INDEX t

statement error 42809 "t_id_idx" is not a table or materialized view
REINDEX TABLE t_id_idx

statement error 42P01 relation "nosuch" does not exist
REINDEX INDEX nosuch

statement error 3F000 schema "nosuch" does not exist
REINDEX SCHEMA nosuch

statement ok
CREATE TABLE e (a int)

statement ok
REINDEX TABLE e

statement ok
REINDEX TABLE CONCURRENTLY e

# A failed unique build leaves an invalid index: neither valid nor ready
statement ok
CREATE TABLE d (a int); INSERT INTO d VALUES (1), (1)

statement error 23505 could not create unique index "d_a_idx"
CREATE UNIQUE INDEX CONCURRENTLY d_a_idx ON d (a)

query
SELECT indexrelid::regclass, indisvalid, indisready, indisunique FROM pg_index WHERE indrelid = 'd'::regclass
----
indexrelid:regclass | indisvalid:bool | indisready:bool | indisunique:bool
d_a_idx | f | f | t

query
SELECT pg_get_indexdef('d_a_idx'::regclass)
----
pg_get_indexdef:text
CREATE UNIQUE INDEX d_a_idx ON public.d USING btree (a)

query
