# DROP COLUMN drops every index and key constraint that reads the column (#249).

statement ok
CREATE TABLE t (a int, b int, c int, d text, e int); CREATE INDEX t_ab ON t (a, b); CREATE INDEX t_expr ON t ((a + c)); CREATE INDEX t_lower ON t (lower(d)); CREATE INDEX t_part ON t (a) WHERE e > 0; CREATE INDEX t_incl ON t (a) INCLUDE (e); CREATE INDEX t_a ON t (a)

statement ok
ALTER TABLE t DROP COLUMN b

query
SELECT to_regclass('t_ab')
----
to_regclass:regclass
NULL

statement ok
ALTER TABLE t DROP COLUMN c; ALTER TABLE t DROP COLUMN d

query
SELECT to_regclass('t_expr'), to_regclass('t_lower')
----
to_regclass:regclass | to_regclass:regclass
NULL | NULL

statement ok
ALTER TABLE t DROP COLUMN e

query
SELECT indexrelid::regclass FROM pg_index WHERE indrelid = 't'::regclass ORDER BY 1::text
----
indexrelid:regclass
t_a

# Key constraints over a dropped column go with their index, multi-column ones included.
statement ok
CREATE TABLE u (a int, b int, c int, PRIMARY KEY (a, b), UNIQUE (c, a), CONSTRAINT u_c_key2 UNIQUE (c)); CREATE UNIQUE INDEX u_uidx ON u (b, c)

statement ok
ALTER TABLE u DROP COLUMN b

query
SELECT conname, contype FROM pg_constraint WHERE conrelid = 'u'::regclass ORDER BY 1
----
conname:name | contype:char
u_a_not_null | n
u_c_a_key | u
u_c_key2 | u

query
SELECT indexrelid::regclass FROM pg_index WHERE indrelid = 'u'::regclass ORDER BY 1::text
----
indexrelid:regclass
u_c_a_key
u_c_key2

statement error 23505 duplicate key value violates unique constraint "u_c_a_key"
INSERT INTO u VALUES (1, 1), (1, 1)

statement ok
ALTER TABLE u DROP COLUMN c; INSERT INTO u VALUES (1), (1)

query
SELECT conname, contype FROM pg_constraint WHERE conrelid = 'u'::regclass ORDER BY 1
----
conname:name | contype:char
u_a_not_null | n

# Mixed column/expression unique indexes and exclusion constraints.
statement ok
CREATE TABLE m (a int, b text, c int); CREATE UNIQUE INDEX m_mixed ON m (a, lower(b)); CREATE UNIQUE INDEX m_mixed2 ON m (lower(b), c); CREATE TABLE x (a int, b int, EXCLUDE USING btree (b WITH =))

statement ok
ALTER TABLE m DROP COLUMN c; ALTER TABLE x DROP COLUMN b

query
SELECT indexrelid::regclass FROM pg_index WHERE indrelid IN ('m'::regclass, 'x'::regclass) ORDER BY 1::text
----
indexrelid:regclass
m_mixed

query
SELECT conname FROM pg_constraint WHERE conrelid = 'x'::regclass
----
conname:name

# Partitioned indexes go from the partitions too.
statement ok
CREATE TABLE pt (a int, b int, c int) PARTITION BY RANGE (a); CREATE TABLE pt1 PARTITION OF pt FOR VALUES FROM (0) TO (10); CREATE INDEX pt_bc ON pt ((b + c)); CREATE INDEX pt_a ON pt (a) WHERE c > 0; CREATE INDEX pt_ab ON pt (a, b)

statement ok
ALTER TABLE pt DROP COLUMN c

query
SELECT c.relname, i.inhparent::regclass FROM pg_class c JOIN pg_index x ON x.indexrelid = c.oid LEFT JOIN pg_inherits i ON i.inhrelid = c.oid WHERE x.indrelid IN ('pt'::regclass, 'pt1'::regclass) ORDER BY 1
----
relname:name | inhparent:regclass
pt1_a_b_idx | pt_ab
pt_ab | NULL
