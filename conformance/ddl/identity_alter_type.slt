# ALTER COLUMN TYPE on an identity column changes its sequence's type (AlterSequence AS):
# bounds at the old type's limits move, explicit ones stay, the current value must fit.

statement ok
CREATE TABLE up (id int GENERATED BY DEFAULT AS IDENTITY, v int)

statement ok
INSERT INTO up (v) VALUES (1), (2)

statement ok
ALTER TABLE up ALTER COLUMN id TYPE bigint

query
SELECT format_type(seqtypid, NULL), seqstart, seqincrement, seqmax, seqmin, seqcache, seqcycle FROM pg_sequence WHERE seqrelid = 'up_id_seq'::regclass
----
format_type:text | seqstart:int8 | seqincrement:int8 | seqmax:int8 | seqmin:int8 | seqcache:int8 | seqcycle:bool
bigint | 1 | 1 | 9223372036854775807 | 1 | 1 | f

query
SELECT schemaname, sequencename, data_type, start_value, min_value, max_value, increment_by, cycle, cache_size, last_value FROM pg_sequences WHERE sequencename = 'up_id_seq'
----
schemaname:name | sequencename:name | data_type:regtype | start_value:int8 | min_value:int8 | max_value:int8 | increment_by:int8 | cycle:bool | cache_size:int8 | last_value:int8
public | up_id_seq | bigint | 1 | 1 | 9223372036854775807 | 1 | f | 1 | 2

query
SELECT count(*) FROM information_schema.sequences WHERE sequence_name = 'up_id_seq'
----
count:int8
0

query
SELECT last_value, is_called FROM up_id_seq
----
last_value:int8 | is_called:bool
2 | t

query
INSERT INTO up (v) VALUES (3) RETURNING id
----
id:int8
3

