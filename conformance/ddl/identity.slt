# serial and identity columns.

# serial / bigserial / smallserial
statement ok
CREATE TABLE ser (id serial PRIMARY KEY, big bigserial, small smallserial, v text); INSERT INTO ser (v) VALUES ('a'), ('b')

query
SELECT id, big, small, v FROM ser ORDER BY id
----
id:int4 | big:int8 | small:int2 | v:text
1 | 1 | 1 | a
2 | 2 | 2 | b

statement ok
INSERT INTO ser (id, v) VALUES (10, 'explicit')

query
INSERT INTO ser (v) VALUES ('c') RETURNING id
----
id:int4
3

query
SELECT column_name, data_type, column_default, is_nullable FROM information_schema.columns WHERE table_name = 'ser' ORDER BY ordinal_position
----
column_name:name | data_type:varchar | column_default:varchar | is_nullable:varchar
id | integer | nextval('ser_id_seq'::regclass) | NO
big | bigint | nextval('ser_big_seq'::regclass) | NO
small | smallint | nextval('ser_small_seq'::regclass) | NO
v | text | NULL | YES

query
SELECT pg_get_serial_sequence('ser', 'id'), pg_get_serial_sequence('public.ser', 'big')
----
pg_get_serial_sequence:text | pg_get_serial_sequence:text
public.ser_id_seq | public.ser_big_seq

# Explicit ids collide with the sequence later; the setval fix-up
statement ok
CREATE TABLE ser2 (id serial PRIMARY KEY); INSERT INTO ser2 VALUES (1)

statement error 23505 duplicate key value violates unique constraint "ser2_pkey"
INSERT INTO ser2 DEFAULT VALUES

query
SELECT setval(pg_get_serial_sequence('ser2', 'id'), (SELECT max(id) FROM ser2))
----
setval:int8
1

query
INSERT INTO ser2 DEFAULT VALUES RETURNING id
----
id:int4
2

# GENERATED ALWAYS AS IDENTITY
statement ok
CREATE TABLE ida (id int GENERATED ALWAYS AS IDENTITY PRIMARY KEY, v text); INSERT INTO ida (v) VALUES ('a'), ('b')

statement error 428C9 cannot insert a non-DEFAULT value into column "id"
INSERT INTO ida (id, v) VALUES (100, 'x')

statement ok
INSERT INTO ida (id, v) OVERRIDING SYSTEM VALUE VALUES (100, 'x'); INSERT INTO ida (id, v) VALUES (DEFAULT, 'c')

statement error 428C9 column "id" can only be updated to DEFAULT
UPDATE ida SET id = 5 WHERE v = 'a'

statement ok
UPDATE ida SET id = DEFAULT WHERE v = 'a'

query
SELECT id, v FROM ida ORDER BY id
----
id:int4 | v:text
2 | b
3 | c
4 | a
100 | x

# GENERATED BY DEFAULT AS IDENTITY
statement ok
CREATE TABLE idd (id bigint GENERATED BY DEFAULT AS IDENTITY, v text); INSERT INTO idd (v) VALUES ('a'); INSERT INTO idd (id, v) VALUES (50, 'b'); INSERT INTO idd (v) VALUES ('c'); INSERT INTO idd (id, v) OVERRIDING USER VALUE VALUES (999, 'd')

query
SELECT id, v FROM idd ORDER BY v
----
id:int8 | v:text
1 | a
50 | b
2 | c
3 | d

statement error 23502 null value in column "id" of relation "idd" violates not-null constraint
INSERT INTO idd (id, v) VALUES (NULL, 'n')

# Identity options and catalog view
statement ok
CREATE TABLE idopt (id int GENERATED ALWAYS AS IDENTITY (START WITH 1000 INCREMENT BY 5), v text); INSERT INTO idopt (v) VALUES ('a'), ('b')

query
SELECT id FROM idopt ORDER BY id
----
id:int4
1000
1005

query
SELECT table_name, is_identity, identity_generation, identity_start, identity_increment, is_nullable FROM information_schema.columns WHERE table_name IN ('ida', 'idd', 'idopt') AND column_name = 'id' ORDER BY table_name
----
table_name:name | is_identity:varchar | identity_generation:varchar | identity_start:varchar | identity_increment:varchar | is_nullable:varchar
ida | YES | ALWAYS | 1 | 1 | NO
idd | YES | BY DEFAULT | 1 | 1 | NO
idopt | YES | ALWAYS | 1000 | 5 | NO

# Invalid identity definitions
statement error 22023 identity column type must be smallint, integer, or bigint
CREATE TABLE badid (id text GENERATED ALWAYS AS IDENTITY)

# ALTER identity
statement ok
ALTER TABLE idd ALTER COLUMN id SET GENERATED ALWAYS

statement error 428C9 cannot insert a non-DEFAULT value into column "id"
INSERT INTO idd (id, v) VALUES (1, 'z')

statement ok
ALTER TABLE idd ALTER COLUMN id RESTART WITH 500

query
INSERT INTO idd (v) VALUES ('r') RETURNING id
----
id:int8
500

statement ok
ALTER TABLE idd ALTER COLUMN id DROP IDENTITY

statement error 23502 null value in column "id" of relation "idd" violates not-null constraint
INSERT INTO idd (v) VALUES ('noid')

statement ok
CREATE TABLE addid (id int NOT NULL, v text); ALTER TABLE addid ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY; INSERT INTO addid (v) VALUES ('x'); ALTER TABLE addid ADD COLUMN id2 int GENERATED ALWAYS AS IDENTITY

query
SELECT id, id2, v FROM addid
----
id:int4 | id2:int4 | v:text
1 | 1 | x

# TRUNCATE RESTART / CONTINUE IDENTITY
statement ok
TRUNCATE ida RESTART IDENTITY; INSERT INTO ida (v) VALUES ('fresh')

query
SELECT id, v FROM ida
----
id:int4 | v:text
1 | fresh

statement ok
TRUNCATE ser CONTINUE IDENTITY

query
INSERT INTO ser (v) VALUES ('after') RETURNING id
----
id:int4
4

# Upsert on an identity table burns sequence values
statement ok
CREATE TABLE tags (id int GENERATED ALWAYS AS IDENTITY PRIMARY KEY, name text UNIQUE)

query
INSERT INTO tags (name) VALUES ('go'), ('rust') ON CONFLICT (name) DO NOTHING RETURNING id, name
----
id:int4 | name:text
1 | go
2 | rust

query
INSERT INTO tags (name) VALUES ('go'), ('sql') ON CONFLICT (name) DO UPDATE SET name = EXCLUDED.name RETURNING id, name
----
id:int4 | name:text
1 | go
4 | sql
