s193_c_b_key | UNIQUE (b)
s193_c_pkey | PRIMARY KEY (d)
s193_ex | EXCLUDE USING btree (e WITH =) WITH (fillfactor='40') WHERE ((a > 0))
s193_u_c | UNIQUE (c)

