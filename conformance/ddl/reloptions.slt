# SET drops the old entry and appends; RESET ignores unknown names
statement ok
ALTER TABLE t SET (fillfactor = 80, parallel_workers = 2)

query
SELECT reloptions FROM pg_class WHERE relname = 't'
----
reloptions:_text
{autovacuum_enabled=false,fillfactor=80,parallel_workers=2}

statement ok
ALTER TABLE t RESET (fillfactor, nonsense, toast.whatever)

query
SELECT reloptions FROM pg_class WHERE relname = 't'
----
reloptions:_text
{autovacuum_enabled=false,parallel_workers=2}

statement ok
ALTER TABLE t RESET (autovacuum_enabled, parallel_workers)

query
