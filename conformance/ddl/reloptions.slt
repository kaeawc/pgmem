s193_c_pkey | CREATE UNIQUE INDEX s193_c_pkey ON public.s193_c USING btree (d) WITH (fillfactor='70')
s193_u_c | CREATE UNIQUE INDEX s193_u_c ON public.s193_c USING btree (c) WITH (fillfactor='50')

