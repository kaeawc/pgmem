# Constraint-level options
statement ok
CREATE TABLE s193_c (a int, b int UNIQUE WITH (fillfactor = 60), c int, d int PRIMARY KEY WITH (fillfactor = 70), e int, CONSTRAINT s193_u_c UNIQUE (c) WITH (fillfactor = 0x32) USING INDEX TABLESPACE pg_default, CONSTRAINT s193_ex EXCLUDE USING btree (e WITH =) WITH (fillfactor = 40) WHERE (a > 0))

query
