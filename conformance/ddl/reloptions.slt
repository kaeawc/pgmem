# Views
statement ok
CREATE VIEW v1 WITH (security_barrier, security_invoker = true) AS SELECT * FROM t; CREATE VIEW v2 WITH (check_option = CASCADED, security_barrier = 1) AS SELECT * FROM t WHERE n > 0; CREATE VIEW v3 AS SELECT * FROM t WHERE n > 0 WITH LOCAL CHECK OPTION; CREATE VIEW v4 AS SELECT * FROM t WHERE n > 0 WITH CHECK OPTION; CREATE VIEW v5 AS SELECT * FROM t

query
SELECT relname, reloptions FROM pg_class WHERE relname IN ('v1', 'v2', 'v3', 'v4', 'v5') ORDER BY relname
----
relname:name | reloptions:_text
v1 | {security_barrier=true,security_invoker=true}
v2 | {check_option=cascaded,security_barrier=1}
v3 | {check_option=local}
v4 | {check_option=cascaded}
v5 | NULL

query
SELECT table_name, check_option FROM information_schema.views WHERE table_name IN ('v1', 'v2', 'v3', 'v4', 'v5') ORDER BY 1
----
table_name:name | check_option:varchar
v1 | NONE
v2 | CASCADED
v3 | LOCAL
v4 | CASCADED
v5 | NONE

