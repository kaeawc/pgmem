# Table inheritance: CREATE TABLE ... INHERITS with column merging, inherited CHECK / NOT NULL
# constraints and defaults, scans of a parent with and without ONLY, UPDATE / DELETE recursion,
# ALTER TABLE recursion and ALTER TABLE ... [NO] INHERIT, and the catalogs.

statement ok
CREATE TABLE inh_p (a int NOT NULL, b text DEFAULT 'pb', CONSTRAINT inh_pc CHECK (a > 0), CONSTRAINT inh_pn CHECK (a < 1000) NO INHERIT)

statement ok
CREATE TABLE inh_q (a int, d int NOT NULL)

statement ok
CREATE TABLE inh_c (b text, c int, a int) INHERITS (inh_p)

statement ok
CREATE TABLE inh_m (e int) INHERITS (inh_p, inh_q)

query
SELECT attrelid::regclass, attname, attnum, attnotnull, attislocal, attinhcount FROM pg_attribute WHERE attrelid IN ('inh_c'::regclass, 'inh_m'::regclass) AND attnum > 0 ORDER BY attrelid::regclass::text, 3
----
attrelid:regclass | attname:name | attnum:int2 | attnotnull:bool | attislocal:bool | attinhcount:int2
inh_c | a | 1 | t | t | 1
inh_c | b | 2 | f | t | 1
inh_c | c | 3 | f | t | 0
inh_m | a | 1 | t | f | 2
inh_m | b | 2 | f | f | 1
inh_m | d | 3 | t | f | 1
inh_m | e | 4 | f | t | 0

query
SELECT conrelid::regclass, conname, contype, conislocal, coninhcount, connoinherit FROM pg_constraint WHERE conrelid IN ('inh_p'::regclass, 'inh_c'::regclass, 'inh_m'::regclass) ORDER BY conrelid::regclass::text, 2
----
conrelid:regclass | conname:name | contype:char | conislocal:bool | coninhcount:int2 | connoinherit:bool
inh_c | inh_p_a_not_null | n | f | 1 | f
inh_c | inh_pc | c | f | 1 | f
inh_m | inh_p_a_not_null | n | f | 1 | f
inh_m | inh_pc | c | f | 1 | f
inh_m | inh_q_d_not_null | n | f | 1 | f
inh_p | inh_p_a_not_null | n | t | 0 | f
inh_p | inh_pc | c | t | 0 | f
inh_p | inh_pn | c | t | 0 | t

query
SELECT inhrelid::regclass, inhparent::regclass, inhseqno FROM pg_inherits WHERE inhparent IN ('inh_p'::regclass, 'inh_q'::regclass) ORDER BY inhrelid::regclass::text, 3
----
inhrelid:regclass | inhparent:regclass | inhseqno:int4
inh_c | inh_p | 1
inh_m | inh_p | 1
inh_m | inh_q | 2

query
SELECT relname, relhassubclass FROM pg_class WHERE relname IN ('inh_p', 'inh_q', 'inh_c', 'inh_m') ORDER BY 1
----
relname:name | relhassubclass:bool
inh_c | f
inh_m | f
inh_p | t
inh_q | t

statement error 42804 column "a" has a type conflict
CREATE TABLE inh_bad (a bigint) INHERITS (inh_p)

statement error 42P07 relation "inh_p" would be inherited from more than once
CREATE TABLE inh_bad () INHERITS (inh_p, inh_p)

statement error 42P21 column "b" has a collation conflict
CREATE TABLE inh_bad (b text COLLATE "C") INHERITS (inh_p)

statement error 42710 constraint "inh_pc" for relation "inh_bad" already exists
CREATE TABLE inh_bad (CONSTRAINT inh_pc CHECK (a > 5)) INHERITS (inh_p)

