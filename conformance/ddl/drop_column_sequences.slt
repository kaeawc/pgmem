# DROP COLUMN drops the sequences OWNED BY the column: serial, identity and OWNED BY (#203).

statement ok
CREATE TABLE t (id serial, g int GENERATED ALWAYS AS IDENTITY, o int, x int); CREATE SEQUENCE o_seq OWNED BY t.o; CREATE SEQUENCE x_seq OWNED BY t.x

statement ok
ALTER TABLE t DROP COLUMN id

statement ok
ALTER TABLE t DROP COLUMN g, DROP COLUMN o

query
SELECT to_regclass('t_id_seq'), to_regclass('t_g_seq'), to_regclass('o_seq'), to_regclass('x_seq')
----
to_regclass:regclass | to_regclass:regclass | to_regclass:regclass | to_regclass:regclass
NULL | NULL | NULL | x_seq

# A new serial column of the same name gets a fresh sequence.
statement ok
ALTER TABLE t ADD COLUMN id serial

query
SELECT pg_get_serial_sequence('t', 'id'), nextval('t_id_seq')
----
pg_get_serial_sequence:text | nextval:int8
public.t_id_seq | 1

# Defaults drawing from the sequence block the drop; CASCADE drops them too.
statement ok
CREATE TABLE d (id serial, y int DEFAULT nextval('d_id_seq')); CREATE TABLE e (z int DEFAULT nextval('d_id_seq'))

statement error 2BP01 cannot drop column id of table d because other objects depend on it
ALTER TABLE d DROP COLUMN id

query
SELECT to_regclass('d_id_seq'), count(*) FROM pg_attribute WHERE attrelid = 'd'::regclass AND attname = 'id'
----
to_regclass:regclass | count:int8
d_id_seq | 1

statement ok
ALTER TABLE d DROP COLUMN id CASCADE

query
SELECT to_regclass('d_id_seq'), (SELECT count(*) FROM pg_attrdef WHERE adrelid IN ('d'::regclass, 'e'::regclass))
----
to_regclass:regclass | count:int8
NULL | 0

# ROLLBACK brings the sequence back.
statement ok
CREATE TABLE r (id serial, x int)

statement ok
BEGIN; ALTER TABLE r DROP COLUMN id

query
SELECT to_regclass('r_id_seq')
----
to_regclass:regclass
NULL

statement ok
ROLLBACK

query
SELECT to_regclass('r_id_seq'), nextval('r_id_seq')
----
to_regclass:regclass | nextval:int8
r_id_seq | 1

# Inheritance children and partitions: the drop recurses and takes their sequences too.
statement ok
CREATE TABLE p (id serial, k int, x int); CREATE TABLE c () INHERITS (p); CREATE SEQUENCE c_seq OWNED BY c.k

statement ok
ALTER TABLE p DROP COLUMN id, DROP COLUMN k

query
SELECT to_regclass('p_id_seq'), to_regclass('c_seq')
----
to_regclass:regclass | to_regclass:regclass
NULL | NULL

statement ok
CREATE TABLE pt (id serial, g int GENERATED BY DEFAULT AS IDENTITY, x int) PARTITION BY RANGE (x); CREATE TABLE pt1 PARTITION OF pt FOR VALUES FROM (0) TO (10)

statement ok
ALTER TABLE pt DROP COLUMN id, DROP COLUMN g

query
SELECT to_regclass('pt_id_seq'), to_regclass('pt_g_seq')
----
to_regclass:regclass | to_regclass:regclass
NULL | NULL
