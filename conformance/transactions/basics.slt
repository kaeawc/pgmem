# BEGIN / COMMIT / ROLLBACK and transaction characteristics
statement ok
CREATE TABLE t (id int PRIMARY KEY, v text)

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (1, 'committed')

statement ok
COMMIT

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (2, 'rolled back')

query
SELECT id FROM t ORDER BY id
----
id:int4
1
2

statement ok
ROLLBACK

query
SELECT id, v FROM t ORDER BY id
----
id:int4 | v:text
1 | committed

# Alternative spellings
statement ok
START TRANSACTION

statement ok
INSERT INTO t VALUES (3, 'work')

statement ok
COMMIT WORK

statement ok
BEGIN TRANSACTION

statement ok
UPDATE t SET v = 'abort' WHERE id = 3

statement ok
ABORT

statement ok
BEGIN WORK

statement ok
END

query
SELECT id, v FROM t ORDER BY id
----
id:int4 | v:text
1 | committed
3 | work

# COMMIT / ROLLBACK outside a transaction only warn; nested BEGIN only warns
statement ok
COMMIT

statement ok
ROLLBACK

statement ok
BEGIN

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (4, 'nested begin')

statement ok
COMMIT

query
SELECT count(*) FROM t WHERE id = 4
----
count:int8
1

# An error aborts the transaction: 25P02 until it ends
statement ok
BEGIN

statement ok
INSERT INTO t VALUES (5, 'lost')

statement error 23505 duplicate key value violates unique constraint "t_pkey"
INSERT INTO t VALUES (1, 'duplicate')

statement error 25P02 current transaction is aborted, commands ignored until end of transaction block
SELECT 1

statement error 25P02 current transaction is aborted, commands ignored until end of transaction block
INSERT INTO t VALUES (6, 'also lost')

statement ok
COMMIT

query
SELECT count(*) FROM t WHERE id IN (5, 6)
----
count:int8
0

statement ok
BEGIN

statement error 22012 division by zero
SELECT 1 / 0

statement ok
ROLLBACK

query
SELECT 1 AS ok
----
ok:int4
1

# Statement-level atomicity: a failing multi-row INSERT inserts nothing
statement error 23505 duplicate key value violates unique constraint "t_pkey"
INSERT INTO t VALUES (7, 'a'), (8, 'b'), (1, 'dup')

query
SELECT count(*) FROM t WHERE id IN (7, 8)
----
count:int8
0

# A multi-statement simple query is one implicit transaction
statement error 22012 division by zero
INSERT INTO t VALUES (9, 'implicit'); SELECT 1 / 0

query
SELECT count(*) FROM t WHERE id = 9
----
count:int8
0

statement ok
INSERT INTO t VALUES (10, 'x'); INSERT INTO t VALUES (11, 'y')

statement error 23505 duplicate key value violates unique constraint "t_pkey"
INSERT INTO t VALUES (12, 'kept'); COMMIT; INSERT INTO t VALUES (1, 'dup')

query
SELECT id FROM t WHERE id >= 10 ORDER BY id
----
id:int4
10
11
12

# Isolation levels and access modes
query
SHOW transaction_isolation
----
transaction_isolation:text
read committed

statement ok
BEGIN ISOLATION LEVEL REPEATABLE READ

query
SHOW transaction_isolation
----
transaction_isolation:text
repeatable read

statement ok
COMMIT

statement ok
START TRANSACTION ISOLATION LEVEL SERIALIZABLE, READ ONLY

query
SELECT current_setting('transaction_isolation') AS iso, current_setting('transaction_read_only') AS ro
----
iso:text | ro:text
serializable | on

statement ok
COMMIT

statement ok
BEGIN

statement ok
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ

query
SHOW transaction_isolation
----
transaction_isolation:text
repeatable read

statement ok
COMMIT

statement ok
BEGIN ISOLATION LEVEL READ UNCOMMITTED

query
SHOW transaction_isolation
----
transaction_isolation:text
read uncommitted

statement ok
COMMIT

# SET TRANSACTION must come before the first query
statement ok
BEGIN

statement ok
SELECT 1

statement error 25001 SET TRANSACTION ISOLATION LEVEL must be called before any query
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE

statement ok
ROLLBACK

# Read-only transactions reject writes
statement ok
BEGIN READ ONLY

query
SELECT count(*) FROM t
----
count:int8
6

statement error 25006 cannot execute INSERT in a read-only transaction
INSERT INTO t VALUES (20, 'ro')

statement ok
ROLLBACK

statement ok
BEGIN

statement ok
SET TRANSACTION READ ONLY

statement error 25006 cannot execute UPDATE in a read-only transaction
UPDATE t SET v = 'ro'

statement ok
ROLLBACK

statement ok
BEGIN READ ONLY

statement error 25006 cannot execute CREATE TABLE in a read-only transaction
CREATE TABLE ro (a int)

statement ok
ROLLBACK

# Session defaults
statement ok
SET SESSION CHARACTERISTICS AS TRANSACTION ISOLATION LEVEL REPEATABLE READ

statement ok
BEGIN

query
SHOW transaction_isolation
----
transaction_isolation:text
repeatable read

statement ok
COMMIT

query
SHOW default_transaction_isolation
----
default_transaction_isolation:text
repeatable read

statement ok
SET default_transaction_isolation = 'read committed'

statement ok
SET default_transaction_read_only = on

statement error 25006 cannot execute INSERT in a read-only transaction
INSERT INTO t VALUES (21, 'ro default')

statement ok
SET default_transaction_read_only = off

# SET TRANSACTION outside a block warns and does nothing
statement ok
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE

query
SHOW transaction_isolation
----
transaction_isolation:text
read committed

statement error 42601 syntax error at or near "BOGUS"
BEGIN ISOLATION LEVEL BOGUS
