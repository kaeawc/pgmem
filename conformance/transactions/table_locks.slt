statement ok
BEGIN

statement ok
ALTER TABLE lk_u ADD COLUMN z int

statement ok
CREATE INDEX lk_u_t_id ON lk_t (v)

query
SELECT relation::regclass::text AS relation, mode, granted FROM pg_locks WHERE pid = pg_backend_pid() AND locktype = 'relation' AND relation <> 'pg_locks'::regclass ORDER BY relation::regclass::text COLLATE "C", mode COLLATE "C"
----
relation:text | mode:text | granted:bool
lk_t | ShareLock | t
lk_u | AccessExclusiveLock | t
lk_u_t_id | AccessExclusiveLock | t

statement ok
ROLLBACK

statement ok
BEGIN

statement ok
ALTER TABLE lk_u ADD CONSTRAINT lk_fk FOREIGN KEY (t_id) REFERENCES lk_t NOT VALID

query
SELECT relation::regclass::text AS relation, mode, granted FROM pg_locks WHERE pid = pg_backend_pid() AND locktype = 'relation' AND relation <> 'pg_locks'::regclass ORDER BY relation::regclass::text COLLATE "C", mode COLLATE "C"
----
relation:text | mode:text | granted:bool
lk_t | AccessShareLock | t
lk_t | ShareRowExclusiveLock | t
lk_t_pkey | AccessShareLock | t
lk_u | AccessShareLock | t
lk_u | ShareRowExclusiveLock | t

statement ok
ROLLBACK

