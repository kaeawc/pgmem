BEGIN

statement ok
ANALYZE lk_u

statement ok
COMMENT ON TABLE lk_t IS 'x'

query
SELECT relation::regclass::text AS relation, mode, granted FROM pg_locks WHERE pid = pg_backend_pid() AND locktype = 'relation' AND relation <> 'pg_locks'::regclass ORDER BY relation::regclass::text COLLATE "C", mode COLLATE "C"
----
relation:text | mode:text | granted:bool
lk_t | ShareUpdateExclusiveLock | t
lk_u | ShareUpdateExclusiveLock | t
lk_u_pkey | AccessShareLock | t
pg_description | RowExclusiveLock | t

statement ok
