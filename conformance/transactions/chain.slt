# COMMIT AND CHAIN / ROLLBACK AND CHAIN keep the transaction characteristics
statement ok
CREATE TABLE t (id int PRIMARY KEY)

statement ok
BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY

statement ok
COMMIT AND CHAIN

query
SELECT current_setting('transaction_isolation') AS iso, current_setting('transaction_read_only') AS ro
----
iso:text | ro:text
repeatable read | on

statement error 25006 cannot execute INSERT in a read-only transaction
INSERT INTO t VALUES (1)

statement ok
ROLLBACK AND CHAIN

query
SELECT current_setting('transaction_isolation') AS iso, current_setting('transaction_read_only') AS ro
----
iso:text | ro:text
repeatable read | on

statement ok
ROLLBACK

query
SELECT current_setting('transaction_isolation') AS iso, current_setting('transaction_read_only') AS ro
----
iso:text | ro:text
read committed | off

# Work before COMMIT AND CHAIN is committed, work before ROLLBACK AND CHAIN is not
statement ok
BEGIN

statement ok
INSERT INTO t VALUES (1)

statement ok
COMMIT AND CHAIN

statement ok
INSERT INTO t VALUES (2)

statement ok
ROLLBACK AND CHAIN

statement ok
INSERT INTO t VALUES (3)

statement ok
COMMIT AND NO CHAIN

query
SELECT id FROM t ORDER BY id
----
id:int4
1
3

# After AND NO CHAIN we are back in autocommit
statement ok
COMMIT

# AND CHAIN outside a transaction block is an error
statement error 25P01 COMMIT AND CHAIN can only be used in transaction blocks
COMMIT AND CHAIN

statement error 25P01 ROLLBACK AND CHAIN can only be used in transaction blocks
ROLLBACK AND CHAIN

# COMMIT AND CHAIN in an aborted transaction rolls back and starts a new one
statement ok
BEGIN ISOLATION LEVEL SERIALIZABLE

statement ok
INSERT INTO t VALUES (4)

statement error 23505 duplicate key value violates unique constraint "t_pkey"
INSERT INTO t VALUES (1)

statement ok
COMMIT AND CHAIN

query
SHOW transaction_isolation
----
transaction_isolation:text
read committed

query
SELECT count(*) FROM t WHERE id = 4
----
count:int8
0

# Still inside a transaction block?
statement ok
SAVEPOINT probe

statement ok
COMMIT
