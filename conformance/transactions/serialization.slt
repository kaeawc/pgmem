connection b
statement ok
BEGIN ISOLATION LEVEL SERIALIZABLE

query
SELECT count(*) FROM booking WHERE room = 1
----
count:int8
0

connection b
query
SELECT count(*) FROM booking WHERE room = 1
----
count:int8
0

statement ok
INSERT INTO booking VALUES (1, 1)

connection b
statement ok
INSERT INTO booking VALUES (1, 2)

statement ok
COMMIT

connection b
statement error 40001 could not serialize access due to read/write dependencies among transactions
COMMIT

query
