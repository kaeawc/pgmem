# Serialization failures (40001) that do not need a session to block.
statement ok
CREATE TABLE item (id int PRIMARY KEY, n int NOT NULL)

statement ok
INSERT INTO item VALUES (1, 0), (2, 0)

# REPEATABLE READ: updating a row changed and committed since the snapshot
statement ok
BEGIN ISOLATION LEVEL REPEATABLE READ

query
SELECT n FROM item WHERE id = 1
----
n:int4
0

connection b
statement ok
UPDATE item SET n = n + 1 WHERE id = 1

statement error 40001 could not serialize access due to concurrent update
UPDATE item SET n = n + 10 WHERE id = 1

statement error 25P02 current transaction is aborted, commands ignored until end of transaction block
SELECT 1

statement ok
ROLLBACK

query
SELECT id, n FROM item ORDER BY id
----
id:int4 | n:int4
1 | 1
2 | 0

# REPEATABLE READ: deleting a row changed since the snapshot
statement ok
BEGIN ISOLATION LEVEL REPEATABLE READ

query
SELECT count(*) FROM item
----
count:int8
2

connection b
statement ok
UPDATE item SET n = 5 WHERE id = 2

statement error 40001 could not serialize access due to concurrent update
DELETE FROM item WHERE id = 2

statement ok
ROLLBACK

# REPEATABLE READ: rows that were not touched can be updated
statement ok
BEGIN ISOLATION LEVEL REPEATABLE READ

query
SELECT count(*) FROM item
----
count:int8
2

connection b
statement ok
UPDATE item SET n = 7 WHERE id = 2

statement ok
UPDATE item SET n = 9 WHERE id = 1

statement ok
COMMIT

query
SELECT id, n FROM item ORDER BY id
----
id:int4 | n:int4
1 | 9
2 | 7

# REPEATABLE READ: SELECT FOR UPDATE of a concurrently updated row
statement ok
BEGIN ISOLATION LEVEL REPEATABLE READ

query
SELECT n FROM item WHERE id = 1
----
n:int4
9

connection b
statement ok
UPDATE item SET n = 11 WHERE id = 1

statement error 40001 could not serialize access due to concurrent update
SELECT n FROM item WHERE id = 1 FOR UPDATE

statement ok
ROLLBACK

# A REPEATABLE READ retry succeeds once restarted
statement ok
BEGIN ISOLATION LEVEL REPEATABLE READ

query
UPDATE item SET n = n + 1 WHERE id = 1 RETURNING n
----
n:int4
12

statement ok
COMMIT

# READ COMMITTED does not fail in the same situation
statement ok
BEGIN ISOLATION LEVEL READ COMMITTED

query
SELECT n FROM item WHERE id = 1
----
n:int4
12

connection b
statement ok
UPDATE item SET n = 100 WHERE id = 1

query
UPDATE item SET n = n + 1 WHERE id = 1 RETURNING n
----
n:int4
101

statement ok
COMMIT

# SERIALIZABLE write skew: both read, both write, the second commit fails
statement ok
CREATE TABLE oncall (doctor text PRIMARY KEY, on_duty boolean NOT NULL)

statement ok
INSERT INTO oncall VALUES ('alice', true), ('bob', true)

statement ok
BEGIN ISOLATION LEVEL SERIALIZABLE

connection b
statement ok
BEGIN ISOLATION LEVEL SERIALIZABLE

query
SELECT count(*) FROM oncall WHERE on_duty
----
count:int8
2

connection b
query
SELECT count(*) FROM oncall WHERE on_duty
----
count:int8
2

statement ok
UPDATE oncall SET on_duty = false WHERE doctor = 'alice'

connection b
statement ok
UPDATE oncall SET on_duty = false WHERE doctor = 'bob'

statement ok
COMMIT

connection b
statement error 40001 could not serialize access due to read/write dependencies among transactions
COMMIT

query
SELECT doctor, on_duty FROM oncall ORDER BY doctor
----
doctor:text | on_duty:bool
alice | f
bob | t

# SERIALIZABLE: update of a row changed since the snapshot
statement ok
BEGIN ISOLATION LEVEL SERIALIZABLE

query
SELECT on_duty FROM oncall WHERE doctor = 'bob'
----
on_duty:bool
t

connection b
statement ok
UPDATE oncall SET on_duty = false WHERE doctor = 'bob'

statement error 40001 could not serialize access due to concurrent update
UPDATE oncall SET on_duty = true WHERE doctor = 'bob'

statement ok
ROLLBACK

