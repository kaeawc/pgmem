# Two sessions: READ COMMITTED visibility and REPEATABLE READ snapshots.
statement ok
CREATE TABLE acct (id int PRIMARY KEY, bal int NOT NULL)

statement ok
INSERT INTO acct VALUES (1, 100), (2, 200)

# Uncommitted changes are invisible to other sessions
statement ok
BEGIN

statement ok
INSERT INTO acct VALUES (3, 300)

statement ok
UPDATE acct SET bal = 0 WHERE id = 1

query
SELECT id, bal FROM acct ORDER BY id
----
id:int4 | bal:int4
1 | 0
2 | 200
3 | 300

connection b
query
SELECT id, bal FROM acct ORDER BY id
----
id:int4 | bal:int4
1 | 100
2 | 200

statement ok
COMMIT

connection b
query
SELECT id, bal FROM acct ORDER BY id
----
id:int4 | bal:int4
1 | 0
2 | 200
3 | 300

# Rolled back changes are never visible
statement ok
BEGIN

statement ok
DELETE FROM acct WHERE id = 3

statement ok
ROLLBACK

connection b
query
SELECT count(*) FROM acct
----
count:int8
3

# READ COMMITTED: each statement sees the latest committed data
statement ok
BEGIN

query
SELECT bal FROM acct WHERE id = 2
----
bal:int4
200

connection b
statement ok
UPDATE acct SET bal = 250 WHERE id = 2

query
SELECT bal FROM acct WHERE id = 2
----
bal:int4
250

connection b
statement ok
INSERT INTO acct VALUES (4, 400)

query
SELECT count(*) FROM acct
----
count:int8
4

statement ok
COMMIT

# READ COMMITTED: an UPDATE after another session's committed update applies on top of it
statement ok
BEGIN

query
SELECT bal FROM acct WHERE id = 4
----
bal:int4
400

connection b
statement ok
UPDATE acct SET bal = bal + 1 WHERE id = 4

statement ok
UPDATE acct SET bal = bal + 10 WHERE id = 4

statement ok
COMMIT

query
SELECT bal FROM acct WHERE id = 4
----
bal:int4
411

# REPEATABLE READ: the snapshot is taken at the first statement, not at BEGIN
statement ok
BEGIN ISOLATION LEVEL REPEATABLE READ

connection b
statement ok
INSERT INTO acct VALUES (5, 500)

query
SELECT count(*) FROM acct
----
count:int8
5

connection b
statement ok
INSERT INTO acct VALUES (6, 600)

connection b
statement ok
UPDATE acct SET bal = 1 WHERE id = 1

connection b
statement ok
DELETE FROM acct WHERE id = 2

query
SELECT id, bal FROM acct ORDER BY id
----
id:int4 | bal:int4
1 | 0
2 | 250
3 | 300
4 | 411
5 | 500

# The transaction still sees its own writes
statement ok
INSERT INTO acct VALUES (7, 700)

query
SELECT count(*) FROM acct
----
count:int8
6

statement ok
COMMIT

query
SELECT id, bal FROM acct ORDER BY id
----
id:int4 | bal:int4
1 | 1
3 | 300
4 | 411
5 | 500
6 | 600
7 | 700

# Session b sees its own uncommitted work; main does not
connection b
statement ok
BEGIN

connection b
statement ok
UPDATE acct SET bal = bal * 2

connection b
query
SELECT sum(bal) FROM acct
----
sum:int8
5024

query
SELECT sum(bal) FROM acct
----
sum:int8
2512

connection b
statement ok
ROLLBACK

query
SELECT sum(bal) FROM acct
----
sum:int8
2512

# SERIALIZABLE read-only snapshot also stays stable
statement ok
BEGIN ISOLATION LEVEL SERIALIZABLE READ ONLY

query
SELECT sum(bal) FROM acct
----
sum:int8
2512

connection b
statement ok
UPDATE acct SET bal = bal + 1000 WHERE id = 1

query
SELECT sum(bal) FROM acct
----
sum:int8
2512

statement ok
COMMIT

query
SELECT sum(bal) FROM acct
----
sum:int8
3512

