# float4 / float8 (real / double precision).

# Shortest round-trip output (extra_float_digits default = 1)
query
SELECT 0.1::float8, 0.1::float4, 1.0::float8 / 3, (1.0::float4 / 3)::float4
----
float8:float8 | float4:float4 | ?column?:float8 | float4:float4
0.1 | 0.1 | 0.3333333333333333 | 0.33333334

query
SELECT 0.1::float8 + 0.2::float8, 1e300::float8 * 10, 123456789.0::float4
----
?column?:float8 | ?column?:float8 | float4:float4
0.30000000000000004 | 1e+301 | 1.2345679e+08

query
SELECT 1e15::float8, 1e16::float8, 1e-5::float8, 123456789012345678::float8
----
float8:float8 | float8:float8 | float8:float8 | float8:float8
1e+15 | 1e+16 | 1e-05 | 1.2345678901234568e+17

query
SELECT pg_typeof(1.5::real), pg_typeof(1.5::double precision), pg_typeof(1::float4 + 1::float8)
----
pg_typeof:regtype | pg_typeof:regtype | pg_typeof:regtype
real | double precision | double precision

# Infinity and NaN
query
SELECT 'Infinity'::float8, '-Infinity'::float8, 'inf'::float4, 'NaN'::float8
----
float8:float8 | float8:float8 | float4:float4 | float8:float8
Infinity | -Infinity | Infinity | NaN

query
SELECT 'NaN'::float8 = 'NaN'::float8, 'NaN'::float8 > 'Infinity'::float8, 'Infinity'::float8 + 1
----
?column?:bool | ?column?:bool | ?column?:float8
t | t | Infinity

query
SELECT 'Infinity'::float8 - 'Infinity'::float8, 0 * 'Infinity'::float8
----
?column?:float8 | ?column?:float8
NaN | NaN

# Division by zero is an error, not Infinity
statement error 22012 division by zero
SELECT 1.0::float8 / 0

statement error 22003 value out of range: overflow
SELECT 1e308::float8 * 10

statement error 22003 "1e400" is out of range for type double precision
SELECT '1e400'::float8

statement error 22003 "1e40" is out of range for type real
SELECT '1e40'::float4

statement error 22P02 invalid input syntax for type double precision: "abc"
SELECT 'abc'::float8

# Underflow on input
statement error 22003 "1e-400" is out of range for type double precision
SELECT '1e-400'::float8

# Negative zero
query
SELECT '-0'::float8, -0.0::float8, '-0'::float8 = '0'::float8
----
float8:float8 | ?column?:float8 | ?column?:bool
-0 | -0 | t

# float to int rounding (round half to even)
query
SELECT 0.5::float8::int4, 1.5::float8::int4, 2.5::float8::int4, (-0.5)::float8::int4
----
int4:int4 | int4:int4 | int4:int4 | int4:int4
0 | 2 | 2 | 0

# Math functions on float8
query
SELECT sqrt(2::float8), power(2::float8, 10), cbrt(27::float8), round(2.5::float8), round(3.5::float8)
----
sqrt:float8 | power:float8 | cbrt:float8 | round:float8 | round:float8
1.4142135623730951 | 1024 | 3.0000000000000004 | 2 | 4

query
SELECT floor(-1.5::float8), ceil(-1.5::float8), trunc(1.9::float8), abs(-1.5::float4)
----
floor:float8 | ceil:float8 | trunc:float8 | abs:float4
-2 | -1 | 1 | 1.5

statement error 2201F cannot take square root of a negative number
SELECT sqrt(-1::float8)

statement error 2201E cannot take logarithm of zero
SELECT ln(0::float8)

# Float columns
statement ok
CREATE TABLE f (id int, r real, d double precision)

statement ok
INSERT INTO f VALUES (1, 1.1, 1.1), (2, 'NaN', 'Infinity'), (3, 3.4028235e38, -1e-300)

query
SELECT id, r, d FROM f ORDER BY id
----
id:int4 | r:float4 | d:float8
1 | 1.1 | 1.1
2 | NaN | Infinity
3 | 3.4028235e+38 | -1e-300

# NaN sorts above all other values
query
SELECT r FROM f ORDER BY r
----
r:float4
1.1
3.4028235e+38
NaN

query
SELECT sum(r)::text IS NOT NULL, max(d), min(d) FROM f
----
?column?:bool | max:float8 | min:float8
t | Infinity | -1e-300
