# Every table, view, materialized view and composite type has an array type (#172): `_name`, or
# the name makeArrayTypeName picks when that is taken; columns can be declared with it
statement ok
CREATE TABLE zpoint (x int, y int)

statement ok
CREATE VIEW zview AS SELECT 1 AS a

statement ok
CREATE TYPE zcomp AS (a int)

query
SELECT t.typname, a.typname AS arr, a.typcategory, a.typelem = t.oid AS elem, a.typsubscript FROM pg_type t JOIN pg_type a ON a.oid = t.typarray WHERE t.typname IN ('zpoint', 'zview', 'zcomp') ORDER BY 1
----
typname:name | arr:name | typcategory:char | elem:bool | typsubscript:regproc
zcomp | _zcomp | A | t | array_subscript_handler
zpoint | _zpoint | A | t | array_subscript_handler
zview | _zview | A | t | array_subscript_handler

statement ok
CREATE TABLE path (id int, pts zpoint[], alt _zpoint)

query
SELECT attname, format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid = 'path'::regclass AND attnum > 0 ORDER BY attnum
----
attname:name | format_type:text
id | integer
pts | zpoint[]
alt | zpoint[]

statement ok
INSERT INTO path VALUES (1, ARRAY[ROW(1,2)::zpoint, ROW(3,4)::zpoint], '{}'), (2, '{"(5,6)",NULL,"(7,)"}', NULL)

query
SELECT id, pts, pts[1].x, (pts[2]).y, alt FROM path ORDER BY id
----
id:int4 | pts:_zpoint | x:int4 | y:int4 | alt:_zpoint
1 | {"(1,2)","(3,4)"} | 1 | 4 | {}
2 | {"(5,6)",NULL,"(7,)"} | 5 | NULL | NULL

query
SELECT p.id, u.* FROM path p, unnest(p.pts) WITH ORDINALITY u ORDER BY 1, 4
----
id:int4 | x:int4 | y:int4 | ordinality:int8
1 | 1 | 2 | 1
1 | 3 | 4 | 2
2 | 5 | 6 | 1
2 | NULL | NULL | 2
2 | 7 | NULL | 3

query
SELECT * FROM unnest('{"(1,2)","(3,4)"}'::zpoint[]) AS u(a, b)
----
a:int4 | b:int4
1 | 2
3 | 4

query
SELECT pg_typeof(pts), pg_typeof(pts[1]), '_zpoint'::regtype FROM path WHERE id = 1
----
pg_typeof:regtype | pg_typeof:regtype | regtype:regtype
zpoint[] | zpoint | zpoint[]

statement error 22P02 invalid input syntax for type integer: "x"
SELECT '{"(1,x)"}'::zpoint[]

query
SELECT array_agg(ROW(x, y)::zpoint ORDER BY x) FROM (VALUES (2, 1), (1, 2)) v(x, y)
----
array_agg:_zpoint
{"(1,2)","(2,1)"}

# Name collisions: `_zz` is a table, so zz gets `_zz_1`; a new type named like an array type
# renames that array type
statement ok
CREATE TABLE _zz (a int)

statement ok
CREATE TABLE zz (x int)

statement ok
CREATE TABLE __zz (b int)

statement ok
CREATE TYPE ___zz AS (c int)

query
SELECT t.typname, a.typname AS arr FROM pg_type t JOIN pg_type a ON a.oid = t.typarray WHERE t.typname LIKE '%zz' ORDER BY 1
----
typname:name | arr:name
___zz | ____zz_1
__zz | ___zz_1
_zz | ____zz
zz | _zz_1

# Renames rename the array type too
statement ok
ALTER TABLE zpoint RENAME TO zpoint2

query
SELECT t.typname, a.typname AS arr FROM pg_type t JOIN pg_type a ON a.oid = t.typarray WHERE t.typname LIKE 'zpoint%'
----
typname:name | arr:name
zpoint2 | _zpoint2

query
SELECT attname, format_type(atttypid, atttypmod) FROM pg_attribute WHERE attrelid = 'path'::regclass AND attname = 'pts'
----
attname:name | format_type:text
pts | zpoint2[]

statement ok
CREATE TABLE _zx (a int)

statement ok
ALTER TABLE _zx RENAME TO zx

statement ok
CREATE TABLE zw (a int)

statement ok
ALTER TABLE zw RENAME TO _zw

query
SELECT t.typname, a.typname AS arr FROM pg_type t JOIN pg_type a ON a.oid = t.typarray WHERE t.typname IN ('zx', '_zw') ORDER BY 1
----
typname:name | arr:name
_zw | __zw
zx | _zx_1
