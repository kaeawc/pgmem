# boolean.

query
SELECT 't'::bool, 'true'::bool, 'yes'::bool, 'on'::bool, '1'::bool, 'y'::bool
----
bool:bool | bool:bool | bool:bool | bool:bool | bool:bool | bool:bool
t | t | t | t | t | t

query
SELECT 'f'::bool, 'FALSE'::bool, 'no'::bool, 'off'::bool, '0'::bool, ' n '::bool
----
bool:bool | bool:bool | bool:bool | bool:bool | bool:bool | bool:bool
f | f | f | f | f | f

statement error 22P02 invalid input syntax for type boolean: "maybe"
