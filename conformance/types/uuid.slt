# uuid.

query
SELECT 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid
----
uuid:uuid
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

# Accepted input forms: upper case, braces, no hyphens, hyphen groups of four
query
SELECT 'A0EEBC99-9C0B-4EF8-BB6D-6BB9BD380A11'::uuid, '{a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}'::uuid, 'a0eebc999c0b4ef8bb6d6bb9bd380a11'::uuid, 'a0ee-bc99-9c0b-4ef8-bb6d-6bb9-bd38-0a11'::uuid
----
uuid:uuid | uuid:uuid | uuid:uuid | uuid:uuid
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11 | a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11 | a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11 | a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

statement error 22P02 invalid input syntax for type uuid: "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a1"
SELECT 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a1'::uuid

statement error 22P02 invalid input syntax for type uuid: "not-a-uuid"
SELECT 'not-a-uuid'::uuid

statement error 22P02 invalid input syntax for type uuid: "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a1g"
SELECT 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a1g'::uuid

# Comparisons and ordering
query
SELECT u FROM (VALUES ('ffffffff-ffff-ffff-ffff-ffffffffffff'::uuid), ('00000000-0000-0000-0000-000000000000'), ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11')) v(u) ORDER BY u
----
u:uuid
00000000-0000-0000-0000-000000000000
a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
ffffffff-ffff-ffff-ffff-ffffffffffff

query
SELECT 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11'::uuid = 'A0EEBC999C0B4EF8BB6D6BB9BD380A11'::uuid
----
?column?:bool
t

# Generated uuids have the right shape and version
query
SELECT length(gen_random_uuid()::text), uuid_extract_version(gen_random_uuid()), uuid_extract_version(uuidv7())
----
length:int4 | uuid_extract_version:int2 | uuid_extract_version:int2
36 | 4 | 7

query
SELECT uuid_extract_timestamp('019366f7-2a0e-7c4a-9c6a-3a5f1d2b4c6e'::uuid)
----
uuid_extract_timestamp:timestamptz
2024-11-26 05:34:54.478+00

# uuid primary key column
statement ok
CREATE TABLE users (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), name text)

statement ok
INSERT INTO users (id, name) VALUES ('11111111-1111-1111-1111-111111111111', 'a')

statement ok
INSERT INTO users (name) VALUES ('b')

statement error 23505 duplicate key value violates unique constraint "users_pkey"
INSERT INTO users (id, name) VALUES ('{11111111-1111-1111-1111-111111111111}', 'dup')

statement error 22P02 invalid input syntax for type uuid: "xyz"
INSERT INTO users (id, name) VALUES ('xyz', 'bad')

query
SELECT count(*), count(DISTINCT id) FROM users
----
count:int8 | count:int8
2 | 2

query
SELECT name FROM users WHERE id = '11111111111111111111111111111111'
----
name:text
a

# Casts to and from text
query
SELECT '11111111-1111-1111-1111-111111111111'::uuid::text, pg_typeof('11111111-1111-1111-1111-111111111111'::uuid::text)
----
text:text | pg_typeof:regtype
11111111-1111-1111-1111-111111111111 | text

statement error 42846 cannot cast type uuid to bytea
SELECT '11111111-1111-1111-1111-111111111111'::uuid::bytea
