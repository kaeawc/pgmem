# DEFERRABLE constraints.

statement ok
CREATE TABLE nodes (id int PRIMARY KEY, next_id int REFERENCES nodes DEFERRABLE INITIALLY DEFERRED)

# A deferred FK is checked at COMMIT
statement ok
BEGIN; INSERT INTO nodes VALUES (1, 2); INSERT INTO nodes VALUES (2, 1); COMMIT

statement ok
BEGIN; INSERT INTO nodes VALUES (3, 99)

statement error 23503 insert or update on table "nodes" violates foreign key constraint "nodes_next_id_fkey"
COMMIT

query
SELECT id, next_id FROM nodes ORDER BY id
----
id:int4 | next_id:int4
1 | 2
2 | 1

# Outside a transaction block it is checked at statement end
statement error 23503 insert or update on table "nodes" violates foreign key constraint "nodes_next_id_fkey"
INSERT INTO nodes VALUES (4, 99)

# SET CONSTRAINTS ... IMMEDIATE checks pending rows right away
statement ok
BEGIN; INSERT INTO nodes VALUES (5, 6)

statement error 23503 insert or update on table "nodes" violates foreign key constraint "nodes_next_id_fkey"
SET CONSTRAINTS ALL IMMEDIATE

statement ok
ROLLBACK

statement ok
BEGIN; SET CONSTRAINTS nodes_next_id_fkey IMMEDIATE

statement error 23503 insert or update on table "nodes" violates foreign key constraint "nodes_next_id_fkey"
INSERT INTO nodes VALUES (5, 6)

statement ok
ROLLBACK

# DEFERRABLE INITIALLY IMMEDIATE can be deferred per transaction
statement ok
CREATE TABLE parent (id int PRIMARY KEY); CREATE TABLE child (pid int REFERENCES parent DEFERRABLE INITIALLY IMMEDIATE)

statement error 23503 insert or update on table "child" violates foreign key constraint "child_pid_fkey"
INSERT INTO child VALUES (1)

statement ok
BEGIN; SET CONSTRAINTS ALL DEFERRED; INSERT INTO child VALUES (1); INSERT INTO parent VALUES (1); COMMIT

query
SELECT pid FROM child
----
pid:int4
1

# Non-deferrable constraints are unaffected by SET CONSTRAINTS ALL
statement ok
CREATE TABLE strict_child (pid int CONSTRAINT strict_fk REFERENCES parent)

statement ok
BEGIN

statement error 42809 constraint "strict_fk" is not deferrable
SET CONSTRAINTS strict_fk DEFERRED

statement ok
ROLLBACK

statement ok
BEGIN; SET CONSTRAINTS ALL DEFERRED

statement error 23503 insert or update on table "strict_child" violates foreign key constraint "strict_fk"
INSERT INTO strict_child VALUES (42)

statement ok
ROLLBACK

# Deferrable unique constraints are checked at statement end, so shifts work
statement ok
CREATE TABLE positions (id int, pos int UNIQUE DEFERRABLE INITIALLY IMMEDIATE); INSERT INTO positions VALUES (1, 1), (2, 2), (3, 3); UPDATE positions SET pos = pos + 1

statement ok
BEGIN; SET CONSTRAINTS ALL DEFERRED; UPDATE positions SET pos = 2 WHERE id = 2; UPDATE positions SET pos = 3 WHERE id = 1; COMMIT

query
SELECT id, pos FROM positions ORDER BY id
----
id:int4 | pos:int4
1 | 3
2 | 2
3 | 4

statement ok
BEGIN; SET CONSTRAINTS ALL DEFERRED; UPDATE positions SET pos = 2 WHERE id = 3

statement error 23505 duplicate key value violates unique constraint "positions_pos_key"
COMMIT

# Deferred primary key tolerates transient duplicates
statement ok
CREATE TABLE dpk (id int PRIMARY KEY DEFERRABLE INITIALLY DEFERRED, tag text)

statement ok
BEGIN; INSERT INTO dpk VALUES (1, 'a'), (1, 'b'); DELETE FROM dpk WHERE tag = 'a'; COMMIT

query
SELECT id, tag FROM dpk
----
id:int4 | tag:text
1 | b

statement error 55000 ON CONFLICT does not support deferrable unique constraints/exclusion constraints as arbiters
INSERT INTO dpk VALUES (1, 'c') ON CONFLICT (id) DO NOTHING

# Invalid deferrability
statement error 42601 misplaced DEFERRABLE clause
CREATE TABLE bad (a int CHECK (a > 0) DEFERRABLE)

statement error 42601 constraint declared INITIALLY DEFERRED must be DEFERRABLE
CREATE TABLE bad (a int UNIQUE NOT DEFERRABLE INITIALLY DEFERRED)

query
SELECT constraint_name, is_deferrable, initially_deferred FROM information_schema.table_constraints WHERE table_name IN ('nodes', 'child', 'positions', 'dpk', 'strict_child') AND constraint_type IN ('FOREIGN KEY', 'UNIQUE', 'PRIMARY KEY') ORDER BY constraint_name
----
constraint_name:name | is_deferrable:varchar | initially_deferred:varchar
child_pid_fkey | YES | NO
dpk_pkey | YES | YES
nodes_next_id_fkey | YES | YES
nodes_pkey | NO | NO
positions_pos_key | YES | NO
strict_fk | NO | NO

# ALTER CONSTRAINT changes deferrability
statement ok
ALTER TABLE strict_child ALTER CONSTRAINT strict_fk DEFERRABLE INITIALLY DEFERRED

statement ok
BEGIN; INSERT INTO strict_child VALUES (77); INSERT INTO parent VALUES (77); COMMIT

query
SELECT pid FROM strict_child
----
pid:int4
77
