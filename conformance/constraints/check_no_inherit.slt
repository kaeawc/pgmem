# CHECK ... NO INHERIT: connoinherit and pg_get_constraintdef (also with NOT VALID, in either
# order), not inherited by INHERITS / ALTER TABLE ... INHERIT children nor enforced on their rows,
# the merge errors when NO INHERIT differs, and the partitioned-table error.

statement ok
CREATE TABLE p (a int CHECK (a > 0) NO INHERIT, b int, CONSTRAINT pb CHECK (b > 0) NO INHERIT, CHECK (a < 1000) NO INHERIT)

statement ok
ALTER TABLE p ADD CONSTRAINT nv1 CHECK (b < 100) NO INHERIT NOT VALID

statement ok
ALTER TABLE p ADD CONSTRAINT nv2 CHECK (b < 200) NOT VALID NO INHERIT

statement ok
ALTER TABLE p ADD CONSTRAINT nv3 CHECK (b < 300) NOT VALID

statement ok
ALTER TABLE p ADD CHECK (b <> 7) NO INHERIT

query
SELECT conname, connoinherit, convalidated, pg_get_constraintdef(oid) FROM pg_constraint WHERE conrelid = 'p'::regclass ORDER BY 1
----
conname:name | connoinherit:bool | convalidated:bool | pg_get_constraintdef:text
nv1 | t | f | CHECK ((b < 100)) NO INHERIT NOT VALID
nv2 | t | f | CHECK ((b < 200)) NO INHERIT NOT VALID
nv3 | f | f | CHECK ((b < 300)) NOT VALID
p_a_check | t | t | CHECK ((a > 0)) NO INHERIT
p_a_check1 | t | t | CHECK ((a < 1000)) NO INHERIT
p_b_check | t | t | CHECK ((b <> 7)) NO INHERIT
pb | t | t | CHECK ((b > 0)) NO INHERIT

statement ok
ALTER TABLE p VALIDATE CONSTRAINT nv1

query
SELECT pg_get_constraintdef(oid), pg_get_constraintdef(oid, true) FROM pg_constraint WHERE conname = 'nv1'
----
pg_get_constraintdef:text | pg_get_constraintdef:text
CHECK ((b < 100)) NO INHERIT | CHECK (b < 100) NO INHERIT

query
SELECT constraint_name, check_clause FROM information_schema.check_constraints WHERE constraint_name IN ('pb', 'nv1') ORDER BY 1
----
constraint_name:name | check_clause:varchar
nv1 | (b < 100)
pb | (b > 0)

statement error 23514 new row for relation "p" violates check constraint "p_a_check"
INSERT INTO p VALUES (0, 1)

statement ok
CREATE TABLE c1 () INHERITS (p)

statement ok
CREATE TABLE c2 (a int, b int, CONSTRAINT nv3 CHECK (b < 300))

statement ok
ALTER TABLE c2 INHERIT p

query
SELECT conrelid::regclass, conname, conislocal, coninhcount, connoinherit FROM pg_constraint WHERE conrelid IN ('c1'::regclass, 'c2'::regclass) ORDER BY conrelid::regclass::text, 2
----
conrelid:regclass | conname:name | conislocal:bool | coninhcount:int2 | connoinherit:bool
c1 | nv3 | f | 1 | f
c2 | nv3 | t | 1 | f

statement ok
INSERT INTO c1 VALUES (-1, 7)

statement ok
