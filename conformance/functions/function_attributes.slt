# Function attributes in pg_proc and pg_get_functiondef; ALTER FUNCTION / PROCEDURE.

statement ok
CREATE FUNCTION f1() RETURNS int LANGUAGE sql SECURITY DEFINER SET search_path = pg_catalog PARALLEL SAFE COST 5 AS 'select 1'

statement ok
CREATE FUNCTION f2() RETURNS setof int LANGUAGE sql STABLE STRICT LEAKPROOF PARALLEL RESTRICTED ROWS 7 SET work_mem = '1MB' SET search_path TO a, "B c", 'd' SET statement_timeout = 5 AS 'select 1'

statement ok
CREATE FUNCTION f3() RETURNS int LANGUAGE sql SET x.y = on SET DateStyle = 'ISO, DMY' PARALLEL UNSAFE COST 0.5 AS 'select 1'

statement ok
CREATE FUNCTION f4() RETURNS setof int LANGUAGE sql ROWS 1000 COST 100 AS 'select 1'

statement ok
CREATE PROCEDURE p1() LANGUAGE sql SECURITY DEFINER SET search_path = public AS 'select 1'

query
SELECT proname, prosecdef, proconfig, proparallel, procost, prorows, proleakproof, proisstrict, provolatile FROM pg_proc WHERE proname IN ('f1', 'f2', 'f3', 'f4', 'p1') ORDER BY proname
----
proname:name | prosecdef:bool | proconfig:_text | proparallel:char | procost:float4 | prorows:float4 | proleakproof:bool | proisstrict:bool | provolatile:char
f1 | t | {search_path=pg_catalog} | s | 5 | 0 | f | f | v
f2 | f | {work_mem=1MB,"search_path=a, \"B c\", d",statement_timeout=5} | r | 100 | 7 | t | t | s
f3 | f | {x.y=on,"DateStyle=ISO, DMY"} | u | 0.5 | 0 | f | f | v
f4 | f | NULL | u | 100 | 1000 | f | f | v
p1 | t | {search_path=public} | u | 100 | 0 | f | f | v

query
SELECT replace(pg_get_functiondef(oid), E'\n', '~') FROM pg_proc WHERE proname IN ('f1', 'f2', 'f3', 'f4', 'p1') ORDER BY proname
----
replace:text
CREATE OR REPLACE FUNCTION public.f1()~ RETURNS integer~ LANGUAGE sql~ PARALLEL SAFE SECURITY DEFINER COST 5~ SET search_path TO 'pg_catalog'~AS $function$select 1$function$~
CREATE OR REPLACE FUNCTION public.f2()~ RETURNS SETOF integer~ LANGUAGE sql~ STABLE PARALLEL RESTRICTED STRICT LEAKPROOF ROWS 7~ SET work_mem TO '1MB'~ SET search_path TO 'a', 'B c', 'd'~ SET statement_timeout TO '5'~AS $function$select 1$function$~
CREATE OR REPLACE FUNCTION public.f3()~ RETURNS integer~ LANGUAGE sql~ COST 0.5~ SET "x.y" TO 'on'~ SET "DateStyle" TO 'ISO, DMY'~AS $function$select 1$function$~
CREATE OR REPLACE FUNCTION public.f4()~ RETURNS SETOF integer~ LANGUAGE sql~AS $function$select 1$function$~
CREATE OR REPLACE PROCEDURE public.p1()~ LANGUAGE sql~ SECURITY DEFINER~ SET search_path TO 'public'~AS $procedure$select 1$procedure$~

