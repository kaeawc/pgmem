# Date/time functions. Fixed literals only; session time zone is UTC.

# extract / date_part fields
query
SELECT extract(year FROM timestamp '2024-03-15 14:30:45.123456'), extract(month FROM timestamp '2024-03-15 14:30:45.123456'), extract(day FROM timestamp '2024-03-15 14:30:45.123456')
----
extract:numeric | extract:numeric | extract:numeric
2024 | 3 | 15

query
SELECT extract(hour FROM timestamp '2024-03-15 14:30:45.123456'), extract(minute FROM timestamp '2024-03-15 14:30:45.123456'), extract(second FROM timestamp '2024-03-15 14:30:45.123456')
----
extract:numeric | extract:numeric | extract:numeric
14 | 30 | 45.123456

query
SELECT extract(millisecond FROM timestamp '2024-03-15 14:30:45.123456'), extract(microsecond FROM timestamp '2024-03-15 14:30:45.123456')
----
extract:numeric | extract:numeric
45123.456 | 45123456

query
SELECT extract(dow FROM timestamp '2024-03-15 14:30:45.123456'), extract(isodow FROM timestamp '2024-03-15 14:30:45.123456'), extract(doy FROM timestamp '2024-03-15 14:30:45.123456')
----
extract:numeric | extract:numeric | extract:numeric
5 | 5 | 75

query
SELECT extract(week FROM timestamp '2024-03-15 14:30:45.123456'), extract(isoyear FROM date '2021-01-01'), extract(week FROM date '2021-01-01')
----
extract:numeric | extract:numeric | extract:numeric
11 | 2020 | 53

query
SELECT extract(quarter FROM timestamp '2024-03-15 14:30:45.123456'), extract(decade FROM timestamp '2024-03-15 14:30:45.123456'), extract(century FROM timestamp '2024-03-15 14:30:45.123456'), extract(millennium FROM timestamp '2024-03-15 14:30:45.123456')
----
extract:numeric | extract:numeric | extract:numeric | extract:numeric
1 | 202 | 21 | 3

query
SELECT extract(epoch FROM timestamp '2024-03-15 14:30:45.123456'), extract(epoch FROM timestamptz '2024-03-15 14:30:45.123456+00')
----
extract:numeric | extract:numeric
1710513045.123456 | 1710513045.123456

query
SELECT extract(julian FROM date '2024-03-15')
----
extract:numeric
2460385

query
SELECT extract(timezone FROM timestamptz '2024-03-15 12:00+00'), extract(timezone_hour FROM timestamptz '2024-03-15 12:00+00')
----
extract:numeric | extract:numeric
0 | 0

query
SELECT extract(year FROM date '2024-03-15'), extract(dow FROM date '2024-03-17')
----
extract:numeric | extract:numeric
2024 | 0

statement error 0A000 unit "hour" not supported for type date
SELECT extract(hour FROM date '2024-03-15')

query
SELECT extract(century FROM date '0001-01-01'), extract(century FROM date '2000-12-31'), extract(year FROM date '0044-03-15 BC')
----
extract:numeric | extract:numeric | extract:numeric
1 | 20 | -44

query
SELECT extract(hour FROM time '13:45:10.5'), extract(second FROM time '13:45:10.5')
----
extract:numeric | extract:numeric
13 | 10.500000

query
SELECT extract(day FROM interval '40 days 5 hours'), extract(epoch FROM interval '1 day 2 hours'), extract(month FROM interval '14 months')
----
extract:numeric | extract:numeric | extract:numeric
40 | 93600.000000 | 2

query
SELECT date_part('year', timestamp '2024-03-15 14:30:45.123456'), date_part('epoch', timestamp '2024-03-15 14:30:45.123456'), pg_typeof(date_part('day', timestamp '2024-03-15 14:30:45.123456')), pg_typeof(extract(day FROM timestamp '2024-03-15 14:30:45.123456'))
----
date_part:float8 | date_part:float8 | pg_typeof:regtype | pg_typeof:regtype
2024 | 1710513045.123456 | double precision | numeric

query
SELECT date_part('month', interval '2 years 3 months')
----
date_part:float8
3

statement error 22023 unit "fortnight" not recognized for type timestamp without time zone
SELECT extract(fortnight FROM timestamp '2024-01-01')


# date_trunc
query
SELECT date_trunc('year', timestamp '2024-03-15 14:30:45.123456'), date_trunc('quarter', timestamp '2024-03-15 14:30:45.123456'), date_trunc('month', timestamp '2024-03-15 14:30:45.123456')
----
date_trunc:timestamp | date_trunc:timestamp | date_trunc:timestamp
2024-01-01 00:00:00 | 2024-01-01 00:00:00 | 2024-03-01 00:00:00

query
SELECT date_trunc('week', timestamp '2024-03-15 14:30:45.123456'), date_trunc('day', timestamp '2024-03-15 14:30:45.123456'), date_trunc('hour', timestamp '2024-03-15 14:30:45.123456')
----
date_trunc:timestamp | date_trunc:timestamp | date_trunc:timestamp
2024-03-11 00:00:00 | 2024-03-15 00:00:00 | 2024-03-15 14:00:00

query
SELECT date_trunc('minute', timestamp '2024-03-15 14:30:45.123456'), date_trunc('second', timestamp '2024-03-15 14:30:45.123456'), date_trunc('milliseconds', timestamp '2024-03-15 14:30:45.123456')
----
date_trunc:timestamp | date_trunc:timestamp | date_trunc:timestamp
2024-03-15 14:30:00 | 2024-03-15 14:30:45 | 2024-03-15 14:30:45.123

query
SELECT date_trunc('decade', timestamp '2024-03-15 14:30:45.123456'), date_trunc('century', timestamp '2024-03-15 14:30:45.123456'), date_trunc('millennium', timestamp '2024-03-15 14:30:45.123456')
----
date_trunc:timestamp | date_trunc:timestamp | date_trunc:timestamp
2020-01-01 00:00:00 | 2001-01-01 00:00:00 | 2001-01-01 00:00:00

query
SELECT date_trunc('day', timestamptz '2024-03-15 14:30:45.123456+00'), pg_typeof(date_trunc('day', timestamptz '2024-03-15 14:30:45.123456+00'))
----
date_trunc:timestamptz | pg_typeof:regtype
2024-03-15 00:00:00+00 | timestamp with time zone

query
SELECT date_trunc('day', timestamptz '2024-03-15 02:30+00', 'America/New_York')
----
date_trunc:timestamptz
2024-03-14 04:00:00+00

query
SELECT date_trunc('month', timestamptz '2024-03-01 03:00+00', 'Asia/Tokyo')
----
date_trunc:timestamptz
2024-02-29 15:00:00+00

query
SELECT date_trunc('day', date '2024-03-15'), pg_typeof(date_trunc('day', date '2024-03-15'))
----
date_trunc:timestamptz | pg_typeof:regtype
2024-03-15 00:00:00+00 | timestamp with time zone

query
SELECT date_trunc('hour', interval '3 days 5 hours 30 minutes'), date_trunc('year', interval '2 years 5 months')
----
date_trunc:interval | date_trunc:interval
3 days 05:00:00 | 2 years

statement error 22023 unit "fortnight" not recognized for type timestamp without time zone
SELECT date_trunc('fortnight', timestamp '2024-01-01')


# age
query
SELECT age(timestamp '2001-04-10', timestamp '1957-06-13')
----
age:interval
43 years 9 mons 27 days

query
SELECT age(timestamp '2024-03-01', timestamp '2024-01-31'), age(timestamp '2024-01-31', timestamp '2024-03-01')
----
age:interval | age:interval
1 mon 1 day | -1 mons -1 days

query
SELECT age(date '2024-03-15', date '2023-03-15'), age(timestamptz '2024-03-15 10:00+00', timestamptz '2024-03-14 12:00+00')
----
age:interval | age:interval
1 year | 22:00:00


# constructors
query
SELECT make_date(2024, 2, 29), make_date(-44, 3, 15)
----
make_date:date | make_date:date
2024-02-29 | 0044-03-15 BC

statement error 22008 date field value out of range: 2023-02-29
SELECT make_date(2023, 2, 29)

query
SELECT make_time(8, 15, 23.5), make_timestamp(2024, 3, 15, 14, 30, 45.5)
----
make_time:time | make_timestamp:timestamp
08:15:23.5 | 2024-03-15 14:30:45.5

query
SELECT make_timestamptz(2024, 3, 15, 14, 30, 0, 'America/New_York'), make_timestamptz(2024, 7, 1, 0, 0, 0, '+02')
----
make_timestamptz:timestamptz | make_timestamptz:timestamptz
2024-03-15 18:30:00+00 | 2024-06-30 22:00:00+00

query
SELECT make_interval(days => 10), make_interval(1, 2, 3, 4, 5, 6, 7.5), make_interval(hours => -3, mins => 30)
----
make_interval:interval | make_interval:interval | make_interval:interval
10 days | 1 year 2 mons 25 days 05:06:07.5 | -02:30:00

query
SELECT to_timestamp(1710513045), to_timestamp(1710513045.5), to_timestamp(0)
----
to_timestamp:timestamptz | to_timestamp:timestamptz | to_timestamp:timestamptz
2024-03-15 14:30:45+00 | 2024-03-15 14:30:45.5+00 | 1970-01-01 00:00:00+00


# to_char
query
SELECT to_char(timestamp '2024-03-15 14:30:45.123456', 'YYYY-MM-DD HH24:MI:SS')
----
to_char:text
2024-03-15 14:30:45

query
SELECT to_char(timestamp '2024-03-15 14:30:45.123456', 'HH12:MI:SS AM'), to_char(timestamp '2024-03-15 14:30:45.123456', 'hh12 pm'), to_char(timestamp '2024-03-15 14:30:45.123456', 'US MS')
----
to_char:text | to_char:text | to_char:text
02:30:45 PM | 02 pm | 123456 123

query
SELECT to_char(timestamp '2024-03-15 14:30:45.123456', 'Day Month YYYY'), to_char(timestamp '2024-03-15 14:30:45.123456', 'FMDay FMMonth'), to_char(timestamp '2024-03-15 14:30:45.123456', 'Dy Mon dd')
----
to_char:text | to_char:text | to_char:text
Friday    March     2024 | Friday March | Fri Mar 15

query
SELECT to_char(timestamp '2024-03-15 14:30:45.123456', 'DY MON'), to_char(timestamp '2024-03-15 14:30:45.123456', 'day month')
----
to_char:text | to_char:text
FRI MAR | friday    march    

query
SELECT to_char(timestamp '2024-03-15 14:30:45.123456', 'Q WW IW IYYY DDD D ID J')
----
to_char:text
1 11 11 2024 075 6 5 2460385

query
SELECT to_char(timestamp '2024-03-15 14:30:45.123456', 'YYYY"年"MM'), to_char(timestamp '2024-03-15 14:30:45.123456', '"Quarter" Q'), to_char(timestamp '2024-03-15 14:30:45.123456', 'FMDDth FMMMth DDTH')
----
to_char:text | to_char:text | to_char:text
2024年03 | Quarter 1 | 15th 3rd 15TH

query
SELECT to_char(timestamp '2024-03-15 14:30:45.123456', 'CC Y YY YYY Y,YYY'), to_char(timestamp '2024-03-15 14:30:45.123456', 'RM rm')
----
to_char:text | to_char:text
21 4 24 024 2,024 | III  iii 

query
SELECT to_char(timestamptz '2024-03-15 14:30:45.123456+00', 'YYYY-MM-DD"T"HH24:MI:SSOF TZ'), to_char(timestamptz '2024-03-15 14:30:45.123456+00', 'TZH:TZM')
----
to_char:text | to_char:text
2024-03-15T14:30:45+00 UTC | +00:00

query
SELECT to_char(interval '15 hours 2 minutes 12 seconds', 'HH24:MI:SS'), to_char(interval '3 days 5 hours', 'DD HH24')
----
to_char:text | to_char:text
15:02:12 | 03 05

query
SELECT to_char(date '2024-03-05', 'FMMM/FMDD/YYYY')
----
to_char:text
3/5/2024


# to_char for numbers
query
SELECT to_char(125, '999'), to_char(-125.8, '999D99S'), to_char(1234567.891, '9,999,999.99')
----
to_char:text | to_char:text | to_char:text
 125 | 125.80- |  1,234,567.89

query
SELECT to_char(5.2, 'FM9990.00'), to_char(0.5, '0.99'), to_char(12, '0009'), to_char(485, 'RN')
----
to_char:text | to_char:text | to_char:text | to_char:text
5.20 |  0.50 |  0012 |         CDLXXXV

query
SELECT to_char(1234.5::float8, '99999.999'), to_char(-0.1, 'FM90.9'), to_char(12345, '99')
----
to_char:text | to_char:text | to_char:text
  1234.500 | -0.1 |  ##

query
SELECT to_char(1234, 'S9999'), to_char(42, 'PL999'), to_char(-42, 'MI999'), to_char(3, 'FM9th')
----
to_char:text | to_char:text | to_char:text | to_char:text
+1234 | +  42 | - 42 | 3rd


# to_date / to_timestamp parsing
query
SELECT to_date('05 Dec 2000', 'DD Mon YYYY'), to_date('2024-03-15', 'YYYY-MM-DD'), to_date('20240315', 'YYYYMMDD')
----
to_date:date | to_date:date | to_date:date
2000-12-05 | 2024-03-15 | 2024-03-15

query
SELECT to_date('March 15, 2024', 'Month DD, YYYY'), to_date('2024-075', 'YYYY-DDD')
----
to_date:date | to_date:date
2024-03-15 | 2024-03-15

statement error 22008 date/time field value out of range: "2024-02-30"
SELECT to_date('2024-02-30', 'YYYY-MM-DD')

query
SELECT to_timestamp('2024-03-15 14:30:45', 'YYYY-MM-DD HH24:MI:SS'), to_timestamp('15/03/2024 02:30 PM', 'DD/MM/YYYY HH:MI AM')
----
to_timestamp:timestamptz | to_timestamp:timestamptz
2024-03-15 14:30:45+00 | 2024-03-15 14:30:00+00

query
SELECT to_timestamp('2024-03-15 14:30:45.123', 'YYYY-MM-DD HH24:MI:SS.MS'), to_timestamp('2024-03-15 14:30 +05', 'YYYY-MM-DD HH24:MI TZH')
----
to_timestamp:timestamptz | to_timestamp:timestamptz
2024-03-15 14:30:45.123+00 | 2024-03-15 09:30:00+00

statement error 22008 date/time field value out of range: "2024-13-01"
SELECT to_timestamp('2024-13-01', 'YYYY-MM-DD')


# justify
query
SELECT justify_days(interval '35 days'), justify_hours(interval '27 hours'), justify_interval(interval '1 mon -1 hour')
----
justify_days:interval | justify_hours:interval | justify_interval:interval
1 mon 5 days | 1 day 03:00:00 | 29 days 23:00:00

query
SELECT justify_days(interval '-35 days'), justify_interval(interval '-1 mon 32 days 25 hours')
----
justify_days:interval | justify_interval:interval
-1 mons -5 days | 3 days 01:00:00


# date_bin
query
SELECT date_bin('15 minutes', timestamp '2020-02-11 15:44:17', timestamp '2001-01-01')
----
date_bin:timestamp
2020-02-11 15:30:00

query
SELECT date_bin('15 minutes', timestamp '2020-02-11 15:44:17', timestamp '2001-01-01 00:02:30')
----
date_bin:timestamp
2020-02-11 15:32:30

query
SELECT date_bin('1 day', timestamptz '2024-03-15 14:30+00', timestamptz '2024-01-01 06:00+00')
----
date_bin:timestamptz
2024-03-15 06:00:00+00

statement error 0A000 timestamps cannot be binned into intervals containing months or years
SELECT date_bin('1 month', timestamp '2024-03-15', timestamp '2024-01-01')


# AT TIME ZONE
query
SELECT timestamptz '2024-03-15 12:00+00' AT TIME ZONE 'America/New_York', timestamptz '2024-01-15 12:00+00' AT TIME ZONE 'America/New_York'
----
timezone:timestamp | timezone:timestamp
2024-03-15 08:00:00 | 2024-01-15 07:00:00

query
SELECT timestamp '2024-03-15 12:00' AT TIME ZONE 'America/New_York', timestamp '2024-07-01 12:00' AT TIME ZONE 'Europe/Paris'
----
timezone:timestamptz | timezone:timestamptz
2024-03-15 16:00:00+00 | 2024-07-01 10:00:00+00

query
SELECT timestamptz '2024-03-15 12:00+00' AT TIME ZONE 'UTC', timestamptz '2024-03-15 12:00+00' AT TIME ZONE '+05', timestamptz '2024-03-15 12:00+00' AT TIME ZONE interval '-03:30'
----
timezone:timestamp | timezone:timestamp | timezone:timestamp
2024-03-15 12:00:00 | 2024-03-15 07:00:00 | 2024-03-15 08:30:00

query
SELECT timestamp '2024-03-10 02:30' AT TIME ZONE 'America/New_York', timestamp '2024-11-03 01:30' AT TIME ZONE 'America/New_York'
----
timezone:timestamptz | timezone:timestamptz
2024-03-10 07:30:00+00 | 2024-11-03 06:30:00+00

query
SELECT timezone('Asia/Kolkata', timestamptz '2024-03-15 12:00+00'), timestamptz '2024-03-15 12:00+00' AT LOCAL
----
timezone:timestamp | timezone:timestamp
2024-03-15 17:30:00 | 2024-03-15 12:00:00

query
SELECT timestamptz '2024-03-15 12:00 America/Los_Angeles', timestamptz '2024-03-15 12:00 EST', timestamptz '2024-06-15 12:00 Europe/London'
----
timestamptz:timestamptz | timestamptz:timestamptz | timestamptz:timestamptz
2024-03-15 19:00:00+00 | 2024-03-15 17:00:00+00 | 2024-06-15 11:00:00+00

statement error 22023 time zone "Mars/Olympus" not recognized
SELECT timestamptz '2024-03-15 12:00+00' AT TIME ZONE 'Mars/Olympus'

statement ok
SET TIME ZONE 'America/New_York'

query
SELECT timestamptz '2024-03-15 12:00+00', timestamptz '2024-12-15 12:00+00', timestamp '2024-03-15 12:00'::timestamptz
----
timestamptz:timestamptz | timestamptz:timestamptz | timestamptz:timestamptz
2024-03-15 08:00:00-04 | 2024-12-15 07:00:00-05 | 2024-03-15 12:00:00-04

query
SELECT date_trunc('day', timestamptz '2024-03-10 12:00+00'), extract(hour FROM timestamptz '2024-03-15 12:00+00'), to_char(timestamptz '2024-03-15 12:00+00', 'HH24 TZ OF')
----
date_trunc:timestamptz | extract:numeric | to_char:text
2024-03-10 00:00:00-05 | 8 | 08 EDT -04

query
SELECT timestamptz '2024-03-09 12:00' + interval '1 day', timestamptz '2024-03-09 12:00' + interval '24 hours'
----
?column?:timestamptz | ?column?:timestamptz
2024-03-10 12:00:00-04 | 2024-03-10 13:00:00-04

statement ok
SET TIME ZONE 'UTC'


# interval arithmetic
query
SELECT date '2024-01-31' + interval '1 month', timestamp '2024-02-29 10:00' + interval '1 year', date '2024-03-15' - interval '1 day'
----
?column?:timestamp | ?column?:timestamp | ?column?:timestamp
2024-02-29 00:00:00 | 2025-02-28 10:00:00 | 2024-03-14 00:00:00

query
SELECT interval '1 day' + interval '2 hours', interval '1 hour' * 3.5, interval '1 day' / 3, interval '1 month' - interval '1 day'
----
?column?:interval | ?column?:interval | ?column?:interval | ?column?:interval
1 day 02:00:00 | 03:30:00 | 08:00:00 | 1 mon -1 days

query
SELECT -interval '1 day 2 hours', interval '90 minutes', interval '1.5 days', interval '1 year 2 months 3 days 04:05:06.789'
----
?column?:interval | interval:interval | interval:interval | interval:interval
-1 days -02:00:00 | 01:30:00 | 1 day 12:00:00 | 1 year 2 mons 3 days 04:05:06.789

query
SELECT interval 'P1Y2M3DT4H5M6S', interval '2 weeks', interval '-1 day +2 hours', interval '1 mon' = interval '30 days'
----
interval:interval | interval:interval | interval:interval | ?column?:bool
1 year 2 mons 3 days 04:05:06 | 14 days | -1 days +02:00:00 | t

query
SELECT date '2024-03-15' + 10, date '2024-03-15' - 10, date '2024-03-15' - date '2024-01-01', pg_typeof(date '2024-03-15' - date '2024-01-01')
----
?column?:date | ?column?:date | ?column?:int4 | pg_typeof:regtype
2024-03-25 | 2024-03-05 | 74 | integer

query
SELECT timestamp '2024-03-15 10:00' - timestamp '2024-03-14 08:30', timestamp '2024-03-15' - timestamp '2023-03-15'
----
?column?:interval | ?column?:interval
1 day 01:30:00 | 366 days

query
SELECT timestamptz '2024-03-15 10:00+00' - timestamptz '2024-03-15 08:00+02'
----
?column?:interval
04:00:00

query
SELECT date '2024-03-15' + time '10:30', time '10:30' + interval '15 hours', time '10:00' - time '08:30'
----
?column?:timestamp | ?column?:time | ?column?:interval
2024-03-15 10:30:00 | 01:30:00 | 01:30:00

query
SELECT interval '1 day' > interval '23 hours', interval '1 month' > interval '29 days'
----
?column?:bool | ?column?:bool
t | t

query
SELECT sum(i), avg(i) FROM (VALUES (interval '1 hour'), (interval '2 hours 30 minutes')) v(i)
----
sum:interval | avg:interval
03:30:00 | 01:45:00

query
SELECT (date '2024-03-15', date '2024-03-20') OVERLAPS (date '2024-03-18', date '2024-03-25')
----
overlaps:bool
t


# infinity and isfinite
query
SELECT isfinite(date '2024-03-15'), isfinite(date 'infinity'), isfinite(timestamp '-infinity'), isfinite(interval '1 day'), isfinite(interval 'infinity')
----
isfinite:bool | isfinite:bool | isfinite:bool | isfinite:bool | isfinite:bool
t | f | f | t | f

query
SELECT date 'infinity' > date '9999-12-31', timestamp 'infinity' - interval '1 day', 'infinity'::timestamp - timestamp '2024-01-01'
----
?column?:bool | ?column?:timestamp | ?column?:interval
t | infinity | infinity


# special inputs and formats
query
SELECT date 'epoch', timestamp 'epoch', timestamp '2024-03-15T14:30:00', date '15 March 2024', date '2024-03-15 BC'
----
date:date | timestamp:timestamp | timestamp:timestamp | date:date | date:date
1970-01-01 | 1970-01-01 00:00:00 | 2024-03-15 14:30:00 | 2024-03-15 | 2024-03-15 BC

query
SELECT timestamp '2024-03-15 14:30:45.1234567', time '24:00', timestamptz '2024-03-15 14:30:45.5-08'
----
timestamp:timestamp | time:time | timestamptz:timestamptz
2024-03-15 14:30:45.123457 | 24:00:00 | 2024-03-15 22:30:45.5+00

statement error 22008 date/time field value out of range: "2024-02-30"
SELECT date '2024-02-30'

statement error 22008 date/time field value out of range: "2024-03-15 25:00"
SELECT timestamp '2024-03-15 25:00'

statement ok
SET DateStyle = 'SQL, DMY'

query
SELECT date '2024-03-15', timestamp '2024-03-15 14:30', timestamptz '2024-03-15 14:30+00'
----
date:date | timestamp:timestamp | timestamptz:timestamptz
15/03/2024 | 15/03/2024 14:30:00 | 15/03/2024 14:30:00 UTC

statement ok
SET DateStyle = 'ISO, MDY'

statement ok
SET IntervalStyle = 'iso_8601'

query
SELECT interval '1 year 2 months 3 days 4 hours 5 minutes 6.5 seconds', interval '-1 day'
----
interval:interval | interval:interval
P1Y2M3DT4H5M6.5S | P-1D

statement ok
SET IntervalStyle = 'sql_standard'

query
SELECT interval '1 year 2 months', interval '3 days 04:05:06'
----
interval:interval | interval:interval
1-2 | 3 4:05:06

statement ok
SET IntervalStyle = 'postgres'
