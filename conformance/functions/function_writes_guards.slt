# Writes by functions obey READ ONLY transactions; PL/pgSQL exception blocks undo the writes of
# functions they call; non-volatile functions refuse utility statements (#174).

statement ok
CREATE TABLE log (m text); CREATE TEMP TABLE tmp (x int)

statement ok
CREATE FUNCTION f() RETURNS int LANGUAGE plpgsql AS $$ BEGIN INSERT INTO log VALUES ('f'); RETURN 1; END $$; CREATE FUNCTION fd() RETURNS int LANGUAGE plpgsql AS $$ BEGIN DROP TABLE log; RETURN 1; END $$; CREATE FUNCTION ft() RETURNS int LANGUAGE plpgsql AS $$ BEGIN INSERT INTO tmp VALUES (1); RETURN (SELECT count(*) FROM tmp); END $$; CREATE PROCEDURE p() LANGUAGE plpgsql AS $$ BEGIN INSERT INTO log VALUES ('p'); END $$

statement ok
BEGIN READ ONLY

statement error 25006 cannot execute INSERT in a read-only transaction
SELECT f()

statement ok
ROLLBACK

statement ok
BEGIN READ ONLY

statement error 25006 cannot execute DROP TABLE in a read-only transaction
SELECT fd()

statement ok
ROLLBACK

statement ok
BEGIN READ ONLY

statement error 25006 cannot execute INSERT in a read-only transaction
CALL p()

statement ok
ROLLBACK

statement ok
BEGIN READ ONLY

statement error 25006 cannot execute INSERT in a read-only transaction
DO $$ BEGIN INSERT INTO log VALUES ('d'); END $$

statement ok
ROLLBACK

statement ok
BEGIN READ ONLY

statement error 25006 cannot execute CREATE TABLE in a read-only transaction
CREATE TEMP TABLE t2 (x int)

statement ok
ROLLBACK

statement ok
BEGIN READ ONLY

query
SELECT ft()
----
ft:int4
1

statement ok
COMMIT

statement ok
SET default_transaction_read_only = on

statement error 25006 cannot execute INSERT in a read-only transaction
SELECT f()

statement ok
SET default_transaction_read_only = off

query
SELECT count(*) FROM log
----
count:int8
0

statement ok
CREATE FUNCTION vf() RETURNS int LANGUAGE plpgsql AS $$ BEGIN INSERT INTO log VALUES ('vf'); RAISE EXCEPTION 'boom'; END $$; CREATE FUNCTION vok() RETURNS int LANGUAGE plpgsql AS $$ BEGIN INSERT INTO log VALUES ('ok'); RETURN 1; END $$; CREATE FUNCTION sf() RETURNS int STABLE LANGUAGE plpgsql AS $$ BEGIN PERFORM vok(); BEGIN PERFORM vok(); PERFORM vf(); EXCEPTION WHEN raise_exception THEN RETURN 0; END; RETURN 1; END $$; CREATE FUNCTION wf() RETURNS int LANGUAGE plpgsql AS $$ BEGIN INSERT INTO log VALUES ('w1'); BEGIN INSERT INTO log VALUES ('w2'); PERFORM vf(); EXCEPTION WHEN raise_exception THEN INSERT INTO log VALUES ('caught'); END; RETURN 1; END $$

query
SELECT sf()
----
sf:int4
0

query
SELECT wf()
----
wf:int4
1

query
SELECT m FROM log ORDER BY m
----
m:text
caught
ok
w1

statement ok
CREATE TABLE s (id int GENERATED BY DEFAULT AS IDENTITY, v int); INSERT INTO s (v) VALUES (1), (2), (3); CREATE FUNCTION rs() RETURNS int LANGUAGE plpgsql AS $$ BEGIN ALTER SEQUENCE s_id_seq RESTART WITH 50; RETURN 1; END $$

statement ok
BEGIN; TRUNCATE s RESTART IDENTITY; SELECT rs(); ROLLBACK

query
INSERT INTO s (v) VALUES (4) RETURNING id
----
id:int4
4

statement ok
CREATE FUNCTION sdrop() RETURNS int STABLE LANGUAGE plpgsql AS $$ BEGIN DROP TABLE log; RETURN 1; END $$; CREATE FUNCTION sidx() RETURNS int STABLE LANGUAGE plpgsql AS $$ BEGIN CREATE INDEX ON log (m); RETURN 1; END $$; CREATE FUNCTION scomment() RETURNS int STABLE LANGUAGE plpgsql AS $$ BEGIN COMMENT ON TABLE log IS 'x'; RETURN 1; END $$; CREATE FUNCTION sshow() RETURNS int STABLE LANGUAGE sql AS $$ SHOW work_mem; SELECT 1 $$

statement error 0A000 DROP TABLE is not allowed in a non-volatile function
SELECT sdrop()

statement error 0A000 CREATE INDEX is not allowed in a non-volatile function
SELECT sidx()

statement error 0A000 COMMENT is not allowed in a non-volatile function
SELECT scomment()

statement error 0A000 SHOW is not allowed in a non-volatile function
SELECT sshow()
