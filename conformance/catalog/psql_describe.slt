# The queries psql sends for \d, \dt, \di, \dv, \ds, \dn, \dT, with literal OIDs replaced by regclass
# lookups and OID columns dropped from the select lists.

statement ok
CREATE TABLE customers (
  id int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  name text NOT NULL COLLATE "C",
  code varchar(8) UNIQUE,
  score int DEFAULT 10 CHECK (score BETWEEN 0 AND 100),
  full_name text GENERATED ALWAYS AS (upper(name)) STORED
)

statement ok
CREATE TABLE orders (
  id serial PRIMARY KEY,
  customer_id int REFERENCES customers (id) DEFERRABLE INITIALLY DEFERRED,
  total numeric(10,2)
)

statement ok
CREATE INDEX orders_customer_idx ON orders USING btree (customer_id DESC)

statement ok
CREATE VIEW big_orders AS SELECT * FROM orders WHERE total > 100

statement ok
CREATE TYPE status AS ENUM ('open', 'closed')

# \d customers: find the relation
statement ok
SELECT n.nspname, c.relname
FROM pg_catalog.pg_class c
     LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
WHERE c.relname OPERATOR(pg_catalog.~) '^(customers)$' COLLATE pg_catalog.default
  AND pg_catalog.pg_table_is_visible(c.oid)
ORDER BY 1, 2

# \d customers: relation properties
query
SELECT c.relchecks, c.relkind, c.relhasindex, c.relhasrules, c.relhastriggers, c.relrowsecurity, c.relforcerowsecurity,
  false AS relhasoids, c.relispartition, '', c.reltablespace,
  CASE WHEN c.reloftype = 0 THEN '' ELSE c.reloftype::pg_catalog.regtype::pg_catalog.text END,
  c.relpersistence, c.relreplident, am.amname
FROM pg_catalog.pg_class c
 LEFT JOIN pg_catalog.pg_class tc ON (c.reltoastrelid = tc.oid)
LEFT JOIN pg_catalog.pg_am am ON (c.relam = am.oid)
WHERE c.oid = 'customers'::regclass
----
relchecks:int2 | relkind:char | relhasindex:bool | relhasrules:bool | relhastriggers:bool | relrowsecurity:bool | relforcerowsecurity:bool | relhasoids:bool | relispartition:bool | ?column?:text | reltablespace:oid | reloftype:text | relpersistence:char | relreplident:char | amname:name
1 | r | t | f | t | f | f | f | f | (empty) | 0 | (empty) | p | d | heap

# \d customers: columns
query
SELECT a.attname,
  pg_catalog.format_type(a.atttypid, a.atttypmod),
  (SELECT pg_catalog.pg_get_expr(d.adbin, d.adrelid, true)
   FROM pg_catalog.pg_attrdef d
   WHERE d.adrelid = a.attrelid AND d.adnum = a.attnum AND a.atthasdef),
  a.attnotnull,
  (SELECT c.collname FROM pg_catalog.pg_collation c, pg_catalog.pg_type t
   WHERE c.oid = a.attcollation AND t.oid = a.atttypid AND a.attcollation <> t.typcollation) AS attcollation,
  a.attidentity,
  a.attgenerated
FROM pg_catalog.pg_attribute a
WHERE a.attrelid = 'customers'::regclass AND a.attnum > 0 AND NOT a.attisdropped
ORDER BY a.attnum
----
attname:name | format_type:text | pg_get_expr:text | attnotnull:bool | attcollation:name | attidentity:char | attgenerated:char
id | integer | NULL | t | NULL | d | (empty)
name | text | NULL | t | C | (empty) | (empty)
code | character varying(8) | NULL | f | NULL | (empty) | (empty)
score | integer | 10 | f | NULL | (empty) | (empty)
full_name | text | upper(name) | f | NULL | (empty) | s

# \d customers: indexes
query
SELECT c2.relname, i.indisprimary, i.indisunique, i.indisclustered, i.indisvalid,
  pg_catalog.pg_get_indexdef(i.indexrelid, 0, true),
  pg_catalog.pg_get_constraintdef(con.oid, true), contype, condeferrable, condeferred, i.indisreplident, c2.reltablespace
FROM pg_catalog.pg_class c, pg_catalog.pg_class c2, pg_catalog.pg_index i
  LEFT JOIN pg_catalog.pg_constraint con ON (conrelid = i.indrelid AND conindid = i.indexrelid AND contype IN ('p','u','x'))
WHERE c.oid = 'customers'::regclass AND c.oid = i.indrelid AND i.indexrelid = c2.oid
ORDER BY i.indisprimary DESC, c2.relname
----
relname:name | indisprimary:bool | indisunique:bool | indisclustered:bool | indisvalid:bool | pg_get_indexdef:text | pg_get_constraintdef:text | contype:char | condeferrable:bool | condeferred:bool | indisreplident:bool | reltablespace:oid
customers_pkey | t | t | f | t | CREATE UNIQUE INDEX customers_pkey ON customers USING btree (id) | PRIMARY KEY (id) | p | f | f | f | 0
customers_code_key | f | t | f | t | CREATE UNIQUE INDEX customers_code_key ON customers USING btree (code) | UNIQUE (code) | u | f | f | f | 0

# \d customers: check constraints
query
SELECT r.conname, pg_catalog.pg_get_constraintdef(r.oid, true)
FROM pg_catalog.pg_constraint r
WHERE r.conrelid = 'customers'::regclass AND r.contype = 'c'
ORDER BY 1
----
conname:name | pg_get_constraintdef:text
customers_score_check | CHECK (score >= 0 AND score <= 100)

# \d orders: foreign keys
query
SELECT true as sametable, conname,
  pg_catalog.pg_get_constraintdef(r.oid, true) as condef,
  conrelid::pg_catalog.regclass AS ontable
FROM pg_catalog.pg_constraint r
WHERE r.conrelid = 'orders'::regclass AND r.contype = 'f' AND conparentid = 0
ORDER BY conname
----
sametable:bool | conname:name | condef:text | ontable:regclass
t | orders_customer_id_fkey | FOREIGN KEY (customer_id) REFERENCES customers(id) DEFERRABLE INITIALLY DEFERRED | orders

# \d customers: referenced by
query
SELECT conname, conrelid::pg_catalog.regclass AS ontable,
       pg_catalog.pg_get_constraintdef(oid, true) AS condef
FROM pg_catalog.pg_constraint c
WHERE confrelid IN (SELECT pg_catalog.pg_partition_ancestors('customers'::regclass)
                    UNION ALL VALUES ('customers'::pg_catalog.regclass))
      AND contype = 'f' AND conparentid = 0
ORDER BY conname
----
conname:name | ontable:regclass | condef:text
orders_customer_id_fkey | orders | FOREIGN KEY (customer_id) REFERENCES customers(id) DEFERRABLE INITIALLY DEFERRED

# \d orders: policies, triggers, inheritance (all empty)
query
SELECT pol.polname FROM pg_catalog.pg_policy pol WHERE pol.polrelid = 'orders'::regclass ORDER BY 1
----
polname:name

query
SELECT t.tgname FROM pg_catalog.pg_trigger t WHERE t.tgrelid = 'orders'::regclass AND NOT t.tgisinternal ORDER BY 1
----
tgname:name

query
SELECT c.oid::pg_catalog.regclass FROM pg_catalog.pg_class c, pg_catalog.pg_inherits i
WHERE c.oid = i.inhparent AND i.inhrelid = 'orders'::regclass AND c.relkind != 'p' AND c.relkind != 'I'
ORDER BY inhseqno
----
oid:regclass

# \dt
query
SELECT n.nspname as "Schema",
  c.relname as "Name",
  CASE c.relkind WHEN 'r' THEN 'table' WHEN 'v' THEN 'view' WHEN 'm' THEN 'materialized view' WHEN 'i' THEN 'index' WHEN 'S' THEN 'sequence' WHEN 't' THEN 'TOAST table' WHEN 'f' THEN 'foreign table' WHEN 'p' THEN 'partitioned table' WHEN 'I' THEN 'partitioned index' END as "Type"
FROM pg_catalog.pg_class c
     LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
     LEFT JOIN pg_catalog.pg_am am ON am.oid = c.relam
WHERE c.relkind IN ('r','p','')
      AND n.nspname <> 'pg_catalog'
      AND n.nspname !~ '^pg_toast'
      AND n.nspname <> 'information_schema'
  AND pg_catalog.pg_table_is_visible(c.oid)
ORDER BY 1,2
----
Schema:name | Name:name | Type:text
public | customers | table
public | orders | table

# \d (all relations)
query
SELECT n.nspname as "Schema",
  c.relname as "Name",
  CASE c.relkind WHEN 'r' THEN 'table' WHEN 'v' THEN 'view' WHEN 'm' THEN 'materialized view' WHEN 'i' THEN 'index' WHEN 'S' THEN 'sequence' WHEN 't' THEN 'TOAST table' WHEN 'f' THEN 'foreign table' WHEN 'p' THEN 'partitioned table' WHEN 'I' THEN 'partitioned index' END as "Type"
FROM pg_catalog.pg_class c
     LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
WHERE c.relkind IN ('r','p','v','m','S','f','')
      AND n.nspname <> 'pg_catalog'
      AND n.nspname !~ '^pg_toast'
      AND n.nspname <> 'information_schema'
  AND pg_catalog.pg_table_is_visible(c.oid)
ORDER BY 1,2
----
Schema:name | Name:name | Type:text
public | big_orders | view
public | customers | table
public | customers_id_seq | sequence
public | orders | table
public | orders_id_seq | sequence

# \di
query
SELECT n.nspname as "Schema", c.relname as "Name", c2.relname as "Table"
FROM pg_catalog.pg_class c
     LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
     LEFT JOIN pg_catalog.pg_index i ON i.indexrelid = c.oid
     LEFT JOIN pg_catalog.pg_class c2 ON i.indrelid = c2.oid
WHERE c.relkind IN ('i','I','')
      AND n.nspname <> 'pg_catalog'
      AND n.nspname !~ '^pg_toast'
      AND n.nspname <> 'information_schema'
  AND pg_catalog.pg_table_is_visible(c.oid)
ORDER BY 1,2
----
Schema:name | Name:name | Table:name
public | customers_code_key | customers
public | customers_pkey | customers
public | orders_customer_idx | orders
public | orders_pkey | orders

# \dn (user schemas only)
query
SELECT n.nspname AS "Name"
FROM pg_catalog.pg_namespace n
WHERE n.nspname !~ '^pg_' AND n.nspname <> 'information_schema'
ORDER BY 1
----
Name:name
public

# \dT status
query
SELECT n.nspname as "Schema",
  pg_catalog.format_type(t.oid, NULL) AS "Name",
  pg_catalog.array_to_string(
      ARRAY(SELECT e.enumlabel FROM pg_catalog.pg_enum e WHERE e.enumtypid = t.oid ORDER BY e.enumsortorder),
      E'\n') AS "Elements"
FROM pg_catalog.pg_type t
     LEFT JOIN pg_catalog.pg_namespace n ON n.oid = t.typnamespace
WHERE (t.typrelid = 0 OR (SELECT c.relkind = 'c' FROM pg_catalog.pg_class c WHERE c.oid = t.typrelid))
  AND NOT EXISTS(SELECT 1 FROM pg_catalog.pg_type el WHERE el.oid = t.typelem AND el.typarray = t.oid)
  AND n.nspname <> 'pg_catalog'
  AND n.nspname <> 'information_schema'
  AND pg_catalog.pg_type_is_visible(t.oid)
ORDER BY 1, 2
----
Schema:name | Name:text | Elements:text
public | status | open\nclosed

# \d+ big_orders: view definition
query
SELECT pg_catalog.pg_get_viewdef('big_orders'::regclass, true)
----
pg_get_viewdef:text
 SELECT id,\n    customer_id,\n    total\n   FROM orders\n  WHERE total > 100::numeric;

# \ds: sequences
query
SELECT n.nspname as "Schema", c.relname as "Name"
FROM pg_catalog.pg_class c
     LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
WHERE c.relkind IN ('S','')
      AND n.nspname <> 'pg_catalog'
      AND n.nspname !~ '^pg_toast'
      AND n.nspname <> 'information_schema'
  AND pg_catalog.pg_table_is_visible(c.oid)
ORDER BY 1,2
----
Schema:name | Name:name
public | customers_id_seq
public | orders_id_seq
