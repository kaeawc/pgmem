# pg_depend, pg_rewrite and the object-address functions for user objects (toast tables and the
# internal RI triggers of foreign keys are not modelled, so they are filtered out).

statement ok
CREATE TYPE status AS ENUM ('open', 'closed')

statement ok
CREATE TABLE owners (id serial PRIMARY KEY, name text UNIQUE)

statement ok
CREATE TABLE items (id integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, owner_id integer REFERENCES owners (id), st status, label text CHECK (label <> ''))

statement ok
CREATE INDEX items_lower_label ON items (lower(label))

statement ok
CREATE VIEW owner_items AS SELECT o.name, i.label FROM owners o JOIN items i ON i.owner_id = o.id

statement ok
CREATE MATERIALIZED VIEW item_counts AS SELECT owner_id, count(*) AS n FROM items GROUP BY owner_id

statement ok
CREATE FUNCTION touch() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NEW; END $$

statement ok
CREATE TRIGGER items_touch BEFORE UPDATE OF label ON items FOR EACH ROW EXECUTE FUNCTION touch()

statement ok
CREATE FUNCTION is_open(s status) RETURNS boolean LANGUAGE sql AS $$ SELECT s = 'open' $$

query
SELECT * FROM (
  SELECT pg_describe_object(classid, objid, objsubid) AS obj, pg_describe_object(refclassid, refobjid, refobjsubid) AS ref, deptype
  FROM pg_depend
  WHERE (objid >= 16384 OR refobjid >= 16384)
    AND pg_describe_object(classid, objid, objsubid) !~ 'toast|RI_ConstraintTrigger'
) d ORDER BY obj COLLATE "C", ref COLLATE "C", deptype
----
obj:text | ref:text | deptype:char
column st of table items | type status | n
constraint items_id_not_null on table items | column id of table items | a
constraint items_label_check on table items | column label of table items | a
constraint items_label_check on table items | column label of table items | n
constraint items_owner_id_fkey on table items | column id of table owners | n
constraint items_owner_id_fkey on table items | column owner_id of table items | a
constraint items_owner_id_fkey on table items | index owners_pkey | n
constraint items_pkey on table items | column id of table items | a
constraint owners_id_not_null on table owners | column id of table owners | a
constraint owners_name_key on table owners | column name of table owners | a
constraint owners_pkey on table owners | column id of table owners | a
default value for column id of table owners | column id of table owners | a
default value for column id of table owners | sequence owners_id_seq | n
function is_open(status) | schema public | n
function is_open(status) | type status | n
function touch() | language plpgsql | n
function touch() | schema public | n
index items_lower_label | column label of table items | a
index items_lower_label | table items | a
index items_pkey | constraint items_pkey on table items | i
index owners_name_key | constraint owners_name_key on table owners | i
index owners_pkey | constraint owners_pkey on table owners | i
materialized view item_counts | schema public | n
rule _RETURN on materialized view item_counts | column owner_id of table items | n
rule _RETURN on materialized view item_counts | materialized view item_counts | i
rule _RETURN on view owner_items | column id of table owners | n
rule _RETURN on view owner_items | column label of table items | n
rule _RETURN on view owner_items | column name of table owners | n
rule _RETURN on view owner_items | column owner_id of table items | n
rule _RETURN on view owner_items | view owner_items | i
sequence items_id_seq | column id of table items | i
sequence items_id_seq | schema public | n
sequence owners_id_seq | column id of table owners | a
sequence owners_id_seq | schema public | n
table items | schema public | n
table owners | schema public | n
trigger items_touch on table items | column label of table items | n
trigger items_touch on table items | function touch() | n
trigger items_touch on table items | table items | a
type item_counts | materialized view item_counts | i
type item_counts[] | type item_counts | i
type items | table items | i
type items[] | type items | i
type owner_items | view owner_items | i
type owner_items[] | type owner_items | i
type owners | table owners | i
type owners[] | type owners | i
type status | schema public | n
type status[] | type status | i
view owner_items | schema public | n

query
SELECT * FROM (
  SELECT ev_class::regclass::text AS rel, rulename, ev_type, ev_enabled, is_instead, ev_qual::text, ev_action IS NOT NULL AS has_action
  FROM pg_rewrite WHERE ev_class >= 16384
) r ORDER BY rel COLLATE "C"
----
rel:text | rulename:name | ev_type:char | ev_enabled:char | is_instead:bool | ev_qual:text | has_action:bool
item_counts | _RETURN | 1 | O | t | <> | t
owner_items | _RETURN | 1 | O | t | <> | t

query
SELECT * FROM (
  SELECT relname::text AS rel, relhasrules FROM pg_class WHERE relname IN ('owners', 'owner_items', 'item_counts')
) c ORDER BY rel COLLATE "C"
----
rel:text | relhasrules:bool
item_counts | t
owner_items | t
owners | f

query
SELECT * FROM (
  SELECT DISTINCT i.type, i.schema, i.name, i.identity, a.object_names, a.object_args
  FROM pg_depend d, pg_identify_object(d.classid, d.objid, d.objsubid) i,
    pg_identify_object_as_address(d.classid, d.objid, d.objsubid) a
  WHERE d.objid >= 16384 AND i.identity !~ 'toast|RI_ConstraintTrigger'
) o ORDER BY identity COLLATE "C", type COLLATE "C"
----
type:text | schema:text | name:text | identity:text | object_names:_text | object_args:_text
rule | NULL | NULL | "_RETURN" on public.item_counts | {public,item_counts,_RETURN} | {}
rule | NULL | NULL | "_RETURN" on public.owner_items | {public,owner_items,_RETURN} | {}
default value | NULL | NULL | for public.owners.id | {public,owners,id} | {}
table constraint | public | NULL | items_id_not_null on public.items | {public,items,items_id_not_null} | {}
table constraint | public | NULL | items_label_check on public.items | {public,items,items_label_check} | {}
table constraint | public | NULL | items_owner_id_fkey on public.items | {public,items,items_owner_id_fkey} | {}
table constraint | public | NULL | items_pkey on public.items | {public,items,items_pkey} | {}
trigger | NULL | NULL | items_touch on public.items | {public,items,items_touch} | {}
table constraint | public | NULL | owners_id_not_null on public.owners | {public,owners,owners_id_not_null} | {}
table constraint | public | NULL | owners_name_key on public.owners | {public,owners,owners_name_key} | {}
table constraint | public | NULL | owners_pkey on public.owners | {public,owners,owners_pkey} | {}
function | public | NULL | public.is_open(public.status) | {public,is_open} | {public.status}
materialized view | public | item_counts | public.item_counts | {public,item_counts} | {}
type | public | item_counts | public.item_counts | {public.item_counts} | {}
type | public | _item_counts | public.item_counts[] | {public.item_counts[]} | {}
table | public | items | public.items | {public,items} | {}
type | public | items | public.items | {public.items} | {}
table column | public | items | public.items.st | {public,items,st} | {}
type | public | _items | public.items[] | {public.items[]} | {}
sequence | public | items_id_seq | public.items_id_seq | {public,items_id_seq} | {}
index | public | items_lower_label | public.items_lower_label | {public,items_lower_label} | {}
index | public | items_pkey | public.items_pkey | {public,items_pkey} | {}
type | public | owner_items | public.owner_items | {public.owner_items} | {}
view | public | owner_items | public.owner_items | {public,owner_items} | {}
type | public | _owner_items | public.owner_items[] | {public.owner_items[]} | {}
table | public | owners | public.owners | {public,owners} | {}
type | public | owners | public.owners | {public.owners} | {}
type | public | _owners | public.owners[] | {public.owners[]} | {}
sequence | public | owners_id_seq | public.owners_id_seq | {public,owners_id_seq} | {}
index | public | owners_name_key | public.owners_name_key | {public,owners_name_key} | {}
index | public | owners_pkey | public.owners_pkey | {public,owners_pkey} | {}
type | public | status | public.status | {public.status} | {}
type | public | _status | public.status[] | {public.status[]} | {}
function | public | NULL | public.touch() | {public,touch} | {}

# the rows a drop-order tool reads: what depends on a table
query
SELECT * FROM (
  SELECT pg_describe_object(classid, objid, objsubid) AS obj, deptype
  FROM pg_depend
  WHERE refobjid = 'items'::regclass AND pg_describe_object(classid, objid, objsubid) !~ 'toast|RI_ConstraintTrigger'
) d ORDER BY obj COLLATE "C", deptype
----
obj:text | deptype:char
constraint items_id_not_null on table items | a
constraint items_label_check on table items | a
constraint items_label_check on table items | n
constraint items_owner_id_fkey on table items | a
constraint items_pkey on table items | a
index items_lower_label | a
index items_lower_label | a
rule _RETURN on materialized view item_counts | n
rule _RETURN on view owner_items | n
rule _RETURN on view owner_items | n
sequence items_id_seq | i
trigger items_touch on table items | a
trigger items_touch on table items | n
type items | i

query
SELECT pg_describe_object('pg_type'::regclass, 'status[]'::regtype, 0), pg_describe_object('pg_proc'::regclass, 'is_open'::regproc, 0)
----
pg_describe_object:text | pg_describe_object:text
type status[] | function is_open(status)
