# Schema reflection and type loading queries in the style of Rails, Django, SQLAlchemy, Prisma,
# Hibernate (pgjdbc), pgx and npgsql. Literal OIDs are replaced by names, and OIDs are never selected.

statement ok
CREATE TYPE role_kind AS ENUM ('admin', 'member', 'guest')

statement ok
CREATE TABLE users (
  id bigserial PRIMARY KEY,
  login varchar(40) NOT NULL,
  kind role_kind NOT NULL DEFAULT 'member',
  score double precision,
  created_at timestamp(6) NOT NULL
)

statement ok
CREATE UNIQUE INDEX index_users_on_login ON users (login)

statement ok
CREATE TABLE posts (
  id serial PRIMARY KEY,
  user_id bigint NOT NULL,
  title text,
  CONSTRAINT fk_posts_user FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE
)

statement ok
COMMENT ON TABLE users IS 'app users'

statement ok
COMMENT ON COLUMN users.login IS 'login name'

# Rails: data_sources / table_exists?
query
SELECT c.relname FROM pg_class c LEFT JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = ANY (current_schemas(false)) AND c.relkind IN ('r','p')
ORDER BY c.relname
----
relname:name
posts
users

query
SELECT current_schemas(false), current_schemas(true)
----
current_schemas:_name | current_schemas:_name
{public} | {pg_catalog,public}

# Rails: column_definitions
query
SELECT a.attname, format_type(a.atttypid, a.atttypmod),
       pg_get_expr(d.adbin, d.adrelid), a.attnotnull, c.collname,
       col_description(a.attrelid, a.attnum) AS comment,
       attidentity AS identity, attgenerated as attgenerated
FROM pg_attribute a
LEFT JOIN pg_attrdef d ON a.attrelid = d.adrelid AND a.attnum = d.adnum
LEFT JOIN pg_type t ON a.atttypid = t.oid
LEFT JOIN pg_collation c ON a.attcollation = c.oid AND a.attcollation <> t.typcollation
WHERE a.attrelid = '"users"'::regclass
  AND a.attnum > 0 AND NOT a.attisdropped
ORDER BY a.attnum
----
attname:name | format_type:text | pg_get_expr:text | attnotnull:bool | collname:name | comment:text | identity:char | attgenerated:char
id | bigint | nextval('users_id_seq'::regclass) | t | NULL | NULL | (empty) | (empty)
login | character varying(40) | NULL | t | NULL | login name | (empty) | (empty)
kind | role_kind | 'member'::role_kind | t | NULL | NULL | (empty) | (empty)
score | double precision | NULL | f | NULL | NULL | (empty) | (empty)
created_at | timestamp(6) without time zone | NULL | t | NULL | NULL | (empty) | (empty)

# Rails: primary_keys
query
SELECT a.attname
FROM (
  SELECT indrelid, indkey, generate_subscripts(indkey, 1) idx
  FROM pg_index
  WHERE indrelid = '"posts"'::regclass AND indisprimary
) i
JOIN pg_attribute a ON a.attrelid = i.indrelid AND a.attnum = i.indkey[i.idx]
ORDER BY i.idx
----
attname:name
id

# Rails: indexes
query
SELECT distinct i.relname, d.indisunique, d.indkey, pg_get_indexdef(d.indexrelid)
FROM pg_class t
INNER JOIN pg_index d ON t.oid = d.indrelid
INNER JOIN pg_class i ON d.indexrelid = i.oid
LEFT JOIN pg_namespace n ON n.oid = t.relnamespace
WHERE i.relkind IN ('i', 'I') AND d.indisprimary = 'f' AND t.relname = 'users'
  AND n.nspname = ANY (current_schemas(false))
ORDER BY i.relname
----
relname:name | indisunique:bool | indkey:int2vector | pg_get_indexdef:text
index_users_on_login | t | 2 | CREATE UNIQUE INDEX index_users_on_login ON public.users USING btree (login)

# Rails: foreign_keys
query
SELECT t2.oid::regclass::text AS to_table, a1.attname AS column, a2.attname AS primary_key,
       c.conname AS name, c.confupdtype AS on_update, c.confdeltype AS on_delete,
       c.convalidated AS valid, c.condeferrable AS deferrable, c.condeferred AS deferred
FROM pg_constraint c
JOIN pg_class t1 ON c.conrelid = t1.oid
JOIN pg_class t2 ON c.confrelid = t2.oid
JOIN pg_attribute a1 ON a1.attnum = c.conkey[1] AND a1.attrelid = t1.oid
JOIN pg_attribute a2 ON a2.attnum = c.confkey[1] AND a2.attrelid = t2.oid
JOIN pg_namespace t3 ON c.connamespace = t3.oid
WHERE c.contype = 'f' AND t1.relname = 'posts' AND t3.nspname = ANY (current_schemas(false))
ORDER BY c.conname
----
to_table:text | column:name | primary_key:name | name:name | on_update:char | on_delete:char | valid:bool | deferrable:bool | deferred:bool
users | user_id | id | fk_posts_user | a | c | t | f | f

# Rails: table_comment
query
SELECT pg_catalog.obj_description(c.oid, 'pg_class')
FROM pg_catalog.pg_class c
LEFT JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE c.relname = 'users' AND c.relkind IN ('r','p') AND n.nspname = ANY (current_schemas(false))
----
obj_description:text
app users

# Rails: type map loading (names only)
query
SELECT t.typname, t.typelem <> 0 AS is_array, t.typtype
FROM pg_type as t
WHERE t.typname IN ('int2', 'int4', 'int8', 'oid', 'float4', 'float8', 'text', 'varchar', 'bool', 'timestamp', 'timestamptz', 'json', 'jsonb', 'uuid')
ORDER BY t.typname
----
typname:name | is_array:bool | typtype:char
bool | f | b
float4 | f | b
float8 | f | b
int2 | f | b
int4 | f | b
int8 | f | b
json | f | b
jsonb | f | b
oid | f | b
text | f | b
timestamp | f | b
timestamptz | f | b
uuid | f | b
varchar | f | b

query
SELECT t.typname, t.typtype
FROM pg_type as t
LEFT JOIN pg_range as r ON t.oid = r.rngtypid
WHERE t.typtype IN ('r', 'e', 'd') AND t.typnamespace = 'public'::regnamespace
ORDER BY t.typname
----
typname:name | typtype:char
role_kind | e

# Django: get_table_list
query
SELECT c.relname,
  CASE WHEN c.relispartition THEN 'p' WHEN c.relkind IN ('m', 'v') THEN 'v' ELSE 't' END,
  obj_description(c.oid, 'pg_class')
FROM pg_catalog.pg_class c
LEFT JOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace
WHERE c.relkind IN ('f', 'm', 'p', 'r', 'v')
  AND n.nspname NOT IN ('pg_catalog', 'pg_toast')
  AND pg_catalog.pg_table_is_visible(c.oid)
ORDER BY c.relname
----
relname:name | case:text | obj_description:text
posts | t | NULL
users | t | app users

# Django: get_sequences
query
SELECT s.relname, a.attname
FROM pg_class s
  JOIN pg_depend d ON d.objid = s.oid AND d.classid = 'pg_class'::regclass AND d.refclassid = 'pg_class'::regclass
  JOIN pg_attribute a ON d.refobjid = a.attrelid AND d.refobjsubid = a.attnum
  JOIN pg_class tbl ON tbl.oid = d.refobjid AND tbl.relname = 'users' AND pg_catalog.pg_table_is_visible(tbl.oid)
WHERE s.relkind = 'S'
----
relname:name | attname:name
users_id_seq | id

# Django: get_constraints
query
SELECT c.conname,
  array(SELECT attname FROM unnest(c.conkey) WITH ORDINALITY cols(colid, arridx)
        JOIN pg_attribute AS ca ON cols.colid = ca.attnum
        WHERE ca.attrelid = c.conrelid ORDER BY cols.arridx),
  c.contype,
  (SELECT fkc.relname || '.' || fka.attname FROM pg_attribute AS fka
   JOIN pg_class AS fkc ON fka.attrelid = fkc.oid
   WHERE fka.attrelid = c.confrelid AND fka.attnum = c.confkey[1]),
  cl.reloptions
FROM pg_constraint AS c
JOIN pg_class AS cl ON c.conrelid = cl.oid
WHERE cl.relname = 'posts' AND pg_catalog.pg_table_is_visible(cl.oid)
ORDER BY c.conname
----
conname:name | array:_name | contype:char | ?column?:text | reloptions:_text
fk_posts_user | {user_id} | f | users.id | NULL
posts_id_not_null | {id} | n | NULL | NULL
posts_pkey | {id} | p | NULL | NULL
posts_user_id_not_null | {user_id} | n | NULL | NULL

# Django: index part of get_constraints
query
SELECT indexname, array_agg(attname ORDER BY arridx), indisunique, indisprimary, amname
FROM (
  SELECT c2.relname as indexname, idx.*, attr.attname, am.amname
  FROM (
    SELECT DISTINCT ON (pi.indexrelid) pi.indexrelid, pi.indrelid, pi.indisunique, pi.indisprimary, c.oid AS coid,
           unnest(pi.indkey) AS colid, generate_series(1, array_length(pi.indkey, 1)) AS arridx
    FROM pg_index pi JOIN pg_class c ON pi.indrelid = c.oid
    WHERE c.relname = 'users' AND pg_catalog.pg_table_is_visible(c.oid)
  ) idx
  LEFT JOIN pg_class c2 ON idx.indexrelid = c2.oid
  LEFT JOIN pg_am am ON c2.relam = am.oid
  LEFT JOIN pg_attribute attr ON attr.attrelid = idx.indrelid AND attr.attnum = idx.colid
) s
GROUP BY indexname, indisunique, indisprimary, amname
ORDER BY indexname
----
indexname:name | array_agg:_name | indisunique:bool | indisprimary:bool | amname:name
index_users_on_login | {login} | t | f | btree
users_pkey | {id} | t | t | btree

