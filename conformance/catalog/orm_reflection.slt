# SQLAlchemy: has_table
query
SELECT pg_catalog.pg_class.relname
FROM pg_catalog.pg_class JOIN pg_catalog.pg_namespace ON pg_catalog.pg_namespace.oid = pg_catalog.pg_class.relnamespace
WHERE pg_catalog.pg_class.relname = 'users'
  AND pg_catalog.pg_class.relkind = ANY (ARRAY['r', 'p', 'f', 'v', 'm'])
  AND pg_catalog.pg_table_is_visible(pg_catalog.pg_class.oid)
  AND pg_catalog.pg_namespace.nspname != 'pg_catalog'
----
relname:name
users

# SQLAlchemy: get_enums
query
SELECT pg_catalog.format_type(pg_catalog.pg_type.oid, NULL) AS name,
       pg_catalog.pg_type_is_visible(pg_catalog.pg_type.oid) AS visible,
       pg_catalog.pg_namespace.nspname AS schema,
       lbl_agg.labels AS labels
FROM pg_catalog.pg_type
JOIN pg_catalog.pg_namespace ON pg_catalog.pg_namespace.oid = pg_catalog.pg_type.typnamespace
LEFT OUTER JOIN (
  SELECT pg_catalog.pg_enum.enumtypid AS enumtypid,
         array_agg(CAST(pg_catalog.pg_enum.enumlabel AS TEXT) ORDER BY pg_catalog.pg_enum.enumsortorder) AS labels
  FROM pg_catalog.pg_enum GROUP BY pg_catalog.pg_enum.enumtypid
) AS lbl_agg ON pg_catalog.pg_type.oid = lbl_agg.enumtypid
WHERE pg_catalog.pg_type.typtype = 'e'
ORDER BY pg_catalog.pg_namespace.nspname, pg_catalog.pg_type.typname
----
name:text | visible:bool | schema:name | labels:_text
role_kind | t | public | {admin,member,guest}

# Prisma: columns
query
SELECT oid.namespace, info.table_name, info.column_name,
       format_type(att.atttypid, att.atttypmod) as formatted_type,
       info.numeric_precision, info.numeric_scale, info.datetime_precision,
       info.data_type, info.udt_schema as type_schema_name, info.udt_name as full_data_type,
       pg_get_expr(attdef.adbin, attdef.adrelid) AS column_default,
       info.is_nullable, info.is_identity, info.character_maximum_length
FROM information_schema.columns info
JOIN pg_attribute att ON att.attname = info.column_name
JOIN (
  SELECT pg_class.oid, relname, pg_namespace.nspname as namespace
  FROM pg_class JOIN pg_namespace on pg_namespace.oid = pg_class.relnamespace
  AND pg_namespace.nspname = ANY (ARRAY['public'])
) as oid on oid.oid = att.attrelid AND relname = info.table_name AND namespace = info.table_schema
LEFT OUTER JOIN pg_attrdef attdef ON attdef.adrelid = att.attrelid AND attdef.adnum = att.attnum AND table_schema = namespace
WHERE table_schema = ANY (ARRAY['public'])
ORDER BY namespace, table_name, ordinal_position
----
namespace:name | table_name:name | column_name:name | formatted_type:text | numeric_precision:int4 | numeric_scale:int4 | datetime_precision:int4 | data_type:varchar | type_schema_name:name | full_data_type:name | column_default:text | is_nullable:varchar | is_identity:varchar | character_maximum_length:int4
public | posts | id | integer | 32 | 0 | NULL | integer | pg_catalog | int4 | nextval('posts_id_seq'::regclass) | NO | NO | NULL
public | posts | user_id | bigint | 64 | 0 | NULL | bigint | pg_catalog | int8 | NULL | NO | NO | NULL
public | posts | title | text | NULL | NULL | NULL | text | pg_catalog | text | NULL | YES | NO | NULL
public | users | id | bigint | 64 | 0 | NULL | bigint | pg_catalog | int8 | nextval('users_id_seq'::regclass) | NO | NO | NULL
public | users | login | character varying(40) | NULL | NULL | NULL | character varying | pg_catalog | varchar | NULL | NO | NO | 40
public | users | kind | role_kind | NULL | NULL | NULL | USER-DEFINED | public | role_kind | 'member'::role_kind | NO | NO | NULL
public | users | score | double precision | 53 | NULL | NULL | double precision | pg_catalog | float8 | NULL | YES | NO | NULL
public | users | created_at | timestamp(6) without time zone | NULL | NULL | 6 | timestamp without time zone | pg_catalog | timestamp | NULL | NO | NO | NULL

# Prisma: enums
query
SELECT t.typname as name, e.enumlabel as value, n.nspname as namespace
FROM pg_type t
JOIN pg_enum e ON t.oid = e.enumtypid
JOIN pg_catalog.pg_namespace n ON n.oid = t.typnamespace
WHERE n.nspname = ANY (ARRAY['public'])
ORDER BY e.enumsortorder
----
name:name | value:name | namespace:name
role_kind | admin | public
role_kind | member | public
role_kind | guest | public

# Prisma: foreign keys
query
SELECT con.conname AS constraint_name, child.attname AS child_column, parent_class.relname AS parent_table,
       parent.attname AS parent_column, con.confdeltype, con.confupdtype, con.condeferrable, con.condeferred
FROM (
  SELECT unnest(con1.conkey) AS parent, unnest(con1.confkey) AS child, con1.oid, con1.conname, con1.confrelid,
         con1.conrelid, con1.confdeltype, con1.confupdtype, con1.condeferrable, con1.condeferred
  FROM pg_class cl
  JOIN pg_namespace ns ON cl.relnamespace = ns.oid
  JOIN pg_constraint con1 ON con1.conrelid = cl.oid
  WHERE ns.nspname = ANY (ARRAY['public']) AND con1.contype = 'f'
) con
JOIN pg_attribute parent ON parent.attrelid = con.confrelid AND parent.attnum = con.child
JOIN pg_class parent_class ON parent_class.oid = con.confrelid
JOIN pg_attribute child ON child.attrelid = con.conrelid AND child.attnum = con.parent
ORDER BY con.conname
----
constraint_name:name | child_column:name | parent_table:name | parent_column:name | confdeltype:char | confupdtype:char | condeferrable:bool | condeferred:bool
fk_posts_user | user_id | users | id | c | a | f | f

# Hibernate / pgjdbc: DatabaseMetaData.getTables
query
SELECT NULL AS TABLE_CAT, n.nspname AS TABLE_SCHEM, c.relname AS TABLE_NAME,
  CASE n.nspname ~ '^pg_' OR n.nspname = 'information_schema'
    WHEN true THEN CASE WHEN n.nspname = 'pg_catalog' OR n.nspname = 'information_schema' THEN 'SYSTEM TABLE' ELSE NULL END
    WHEN false THEN CASE c.relkind WHEN 'r' THEN 'TABLE' WHEN 'p' THEN 'PARTITIONED TABLE' WHEN 'i' THEN 'INDEX'
      WHEN 'S' THEN 'SEQUENCE' WHEN 'v' THEN 'VIEW' WHEN 'c' THEN 'TYPE' WHEN 'f' THEN 'FOREIGN TABLE'
      WHEN 'm' THEN 'MATERIALIZED VIEW' ELSE NULL END
    ELSE NULL END AS TABLE_TYPE,
  d.description AS REMARKS
FROM pg_catalog.pg_namespace n, pg_catalog.pg_class c
LEFT JOIN pg_catalog.pg_description d ON (c.oid = d.objoid AND d.objsubid = 0 AND d.classoid = 'pg_class'::regclass)
WHERE c.relnamespace = n.oid AND n.nspname LIKE 'public' AND c.relname LIKE '%'
ORDER BY TABLE_TYPE, TABLE_SCHEM, TABLE_NAME
----
table_cat:text | table_schem:name | table_name:name | table_type:text | remarks:text
NULL | public | index_users_on_login | INDEX | NULL
NULL | public | posts_pkey | INDEX | NULL
NULL | public | users_pkey | INDEX | NULL
NULL | public | posts_id_seq | SEQUENCE | NULL
NULL | public | users_id_seq | SEQUENCE | NULL
NULL | public | posts | TABLE | NULL
NULL | public | users | TABLE | app users

# Hibernate: sequence discovery
query
SELECT sequence_catalog IS NOT NULL AS has_catalog, sequence_schema, sequence_name, start_value, minimum_value, maximum_value, increment
FROM information_schema.sequences
ORDER BY sequence_name
----
has_catalog:bool | sequence_schema:name | sequence_name:name | start_value:varchar | minimum_value:varchar | maximum_value:varchar | increment:varchar
t | public | posts_id_seq | 1 | 1 | 2147483647 | 1
t | public | users_id_seq | 1 | 1 | 9223372036854775807 | 1

# pgx: LoadType for an enum and its array type
query
SELECT t.typname, t.typtype, coalesce(e.typname, '') AS elem
FROM pg_type t LEFT JOIN pg_type e ON e.oid = t.typelem
WHERE t.oid = to_regtype('role_kind') OR t.oid = to_regtype('role_kind[]')
ORDER BY t.typname
----
typname:name | typtype:char | elem:name
_role_kind | b | role_kind
role_kind | e | (empty)

query
SELECT enumlabel FROM pg_enum WHERE enumtypid = to_regtype('role_kind') ORDER BY enumsortorder
----
enumlabel:name
admin
member
guest

# pgx: composite type fields
statement ok
CREATE TYPE address AS (street text, zip varchar(10))

query
SELECT a.attname, format_type(a.atttypid, a.atttypmod)
FROM pg_attribute a
JOIN pg_type t ON t.typrelid = a.attrelid
WHERE t.oid = to_regtype('address') AND a.attnum > 0 AND NOT a.attisdropped
ORDER BY a.attnum
----
attname:name | format_type:text
street | text
zip | character varying(10)

# npgsql: type loading (filtered to a few builtin and user types)
query
SELECT ns.nspname, typ.typname, typ.typtype, typ.typcategory,
       CASE WHEN typ.typelem <> 0 THEN elemtyp.typname END AS elemname
FROM pg_type AS typ
JOIN pg_namespace AS ns ON (ns.oid = typ.typnamespace)
LEFT OUTER JOIN pg_type AS elemtyp ON (elemtyp.oid = typ.typelem AND typ.typcategory = 'A')
WHERE typ.typname IN ('int4', '_int4', 'text', 'uuid', 'jsonb', 'role_kind', '_role_kind', 'address', 'int4range')
ORDER BY ns.nspname, typ.typname
----
nspname:name | typname:name | typtype:char | typcategory:char | elemname:name
pg_catalog | _int4 | b | A | int4
pg_catalog | int4 | b | N | NULL
pg_catalog | int4range | r | R | NULL
pg_catalog | jsonb | b | U | NULL
pg_catalog | text | b | S | NULL
pg_catalog | uuid | b | U | NULL
public | _role_kind | b | A | role_kind
public | address | c | C | NULL
public | role_kind | e | E | NULL

query
SELECT r.rngsubtype::regtype::text FROM pg_range r WHERE r.rngtypid = 'int4range'::regtype
----
rngsubtype:text
integer
