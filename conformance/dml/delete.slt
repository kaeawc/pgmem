# DELETE: USING, subqueries, RETURNING, foreign key actions.
statement ok
CREATE TABLE author (id int PRIMARY KEY, name text, active boolean DEFAULT true)

statement ok
CREATE TABLE book (id int PRIMARY KEY, author_id int REFERENCES author ON DELETE CASCADE, title text, year int)

statement ok
CREATE TABLE review (id int PRIMARY KEY, book_id int REFERENCES book ON DELETE SET NULL, stars int)

statement ok
CREATE TABLE loan (id int PRIMARY KEY, book_id int REFERENCES book)

statement ok
INSERT INTO author VALUES (1, 'ada', true), (2, 'bea', false), (3, 'cy', true), (4, 'dot', true)

statement ok
INSERT INTO book VALUES (10, 1, 'a1', 2001), (11, 1, 'a2', 2005), (20, 2, 'b1', 1999), (30, 3, 'c1', 2010), (31, 3, 'c2', 2011)

statement ok
INSERT INTO review VALUES (100, 10, 5), (101, 20, 3), (102, 30, 4)

statement ok
INSERT INTO loan VALUES (1000, 31)

# RETURNING
query rowsort
DELETE FROM review WHERE stars < 4 RETURNING *
----
id:int4 | book_id:int4 | stars:int4
101 | 20 | 3

query rowsort
DELETE FROM review WHERE id = 999 RETURNING id
----
id:int4

# DELETE ... USING
query rowsort
DELETE FROM book b USING author a WHERE b.author_id = a.id AND NOT a.active RETURNING b.id, b.title, a.name
----
id:int4 | title:text | name:text
20 | b1 | bea

query rowsort
DELETE FROM book USING (VALUES (2001), (2010)) AS y(year) WHERE book.year = y.year RETURNING book.id
----
id:int4
10
30

query
SELECT id, book_id FROM review ORDER BY id
----
id:int4 | book_id:int4
100 | NULL
102 | NULL

# Subqueries
query rowsort
DELETE FROM author WHERE NOT EXISTS (SELECT 1 FROM book WHERE book.author_id = author.id) AND id > 3 RETURNING id
----
id:int4
4

query rowsort
DELETE FROM review WHERE book_id IS NULL OR book_id NOT IN (SELECT id FROM book) RETURNING id
----
id:int4
100
102

