# RETURNING old (PostgreSQL 18)
query rowsort
DELETE FROM book WHERE id = 11 RETURNING old.title, new.title
----
title:text | title:text
a2 | NULL

# DELETE ... WHERE CURRENT OF
statement ok
INSERT INTO book VALUES (40, 1, 'd1', 2020), (41, 1, 'd2', 2021)

statement ok
BEGIN

statement ok
DECLARE cur CURSOR FOR SELECT id FROM book WHERE id >= 40 ORDER BY id FOR UPDATE

statement ok
FETCH 1 FROM cur

query rowsort
DELETE FROM book WHERE CURRENT OF cur RETURNING id
----
id:int4
40

statement ok
COMMIT

