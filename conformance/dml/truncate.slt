# TRUNCATE, including inside transactions
statement ok
CREATE TABLE parent (id serial PRIMARY KEY, name text)

statement ok
CREATE TABLE child (id int PRIMARY KEY, parent_id int REFERENCES parent)

statement ok
CREATE TABLE solo (id int GENERATED BY DEFAULT AS IDENTITY, v text)

statement ok
INSERT INTO parent (name) VALUES ('a'), ('b'), ('c')

statement ok
INSERT INTO child VALUES (1, 1), (2, 2)

statement ok
INSERT INTO solo (v) VALUES ('x'), ('y')

# Rolled back TRUNCATE restores the rows
statement ok
BEGIN

statement ok
TRUNCATE solo

query
SELECT count(*) FROM solo
----
count:int8
0

statement ok
ROLLBACK

query
SELECT id, v FROM solo ORDER BY id
----
id:int4 | v:text
1 | x
2 | y

# RESTART IDENTITY is transactional too
statement ok
BEGIN

statement ok
TRUNCATE TABLE solo RESTART IDENTITY

query rowsort
INSERT INTO solo (v) VALUES ('z') RETURNING id
----
id:int4
1

statement ok
ROLLBACK

query rowsort
INSERT INTO solo (v) VALUES ('w') RETURNING id
----
id:int4
3

statement ok
TRUNCATE solo CONTINUE IDENTITY

query rowsort
INSERT INTO solo (v) VALUES ('v') RETURNING id
----
id:int4
4

statement ok
TRUNCATE solo RESTART IDENTITY

query rowsort
INSERT INTO solo (v) VALUES ('u') RETURNING id
----
id:int4
1

# Foreign keys
statement error 0A000 cannot truncate a table referenced in a foreign key constraint
TRUNCATE parent

statement ok
BEGIN

statement ok
TRUNCATE parent CASCADE

query
SELECT (SELECT count(*) FROM parent) AS p, (SELECT count(*) FROM child) AS c
----
p:int8 | c:int8
0 | 0

statement ok
ROLLBACK

query
SELECT (SELECT count(*) FROM parent) AS p, (SELECT count(*) FROM child) AS c
----
p:int8 | c:int8
3 | 2

statement ok
TRUNCATE child, parent RESTART IDENTITY

query rowsort
INSERT INTO parent (name) VALUES ('new') RETURNING id, name
----
id:int4 | name:text
1 | new

# TRUNCATE inside a savepoint
statement ok
BEGIN

statement ok
SAVEPOINT s1

statement ok
TRUNCATE parent CASCADE

statement ok
ROLLBACK TO SAVEPOINT s1

query
SELECT name FROM parent
----
name:text
new

statement ok
COMMIT

statement ok
TRUNCATE ONLY solo

query
SELECT count(*) FROM solo
----
count:int8
0

statement error 42P01 relation "no_such_table" does not exist
TRUNCATE no_such_table
