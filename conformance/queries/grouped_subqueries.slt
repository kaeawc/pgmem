# Grouped queries whose subqueries read the grouped row: group keys and the outer query's
# aggregates (#294).

statement ok
CREATE TABLE t (v int, w int)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (2, 5), (3, 30)

statement ok
CREATE TABLE u (k int, z int)

statement ok
INSERT INTO u VALUES (1, 100), (2, 200), (2, 201), (25, 7), (30, 9)

statement ok
CREATE TABLE p (id int PRIMARY KEY, name text, x int)

statement ok
INSERT INTO p VALUES (1, 'a', 5), (2, 'b', 7)

statement ok
CREATE SEQUENCE s3

# Group keys read through a subquery's outer references.
query
SELECT v, (SELECT x FROM generate_series(v, v) x) FROM t GROUP BY v ORDER BY v
----
v:int4 | x:int4
1 | 1
2 | 2
3 | 3

query
SELECT v FROM t GROUP BY v HAVING EXISTS (SELECT 1 FROM generate_series(v, 2)) ORDER BY v
----
v:int4
1
2

query
SELECT v, (SELECT count(*) FROM u WHERE u.k = t.v) FROM t GROUP BY v ORDER BY v
----
v:int4 | count:int8
1 | 1
2 | 2
3 | 0

query
SELECT v, array(SELECT z FROM u WHERE u.k = t.v ORDER BY z) FROM t GROUP BY v ORDER BY v
----
v:int4 | array:_int4
1 | {100}
2 | {200,201}
3 | {}

query
SELECT v, EXISTS (SELECT 1 FROM u WHERE u.k = t.v), t.v IN (SELECT k FROM u) FROM t GROUP BY v ORDER BY v
----
v:int4 | exists:bool | ?column?:bool
1 | t | t
2 | t | t
3 | f | f

query
SELECT v FROM t GROUP BY v ORDER BY (SELECT max(z) FROM u WHERE u.k = t.v) NULLS FIRST, v
----
v:int4
3
1
2

query
SELECT v, (SELECT count(*) FROM u WHERE u.k = t.v) c FROM t GROUP BY v HAVING (SELECT count(*) FROM u WHERE u.k = t.v) > 0 ORDER BY v
----
v:int4 | c:int8
1 | 1
2 | 2

query
SELECT DISTINCT (SELECT count(*) FROM u WHERE u.k = t.v) FROM t GROUP BY v ORDER BY 1
----
count:int8
0
1
2

query
SELECT v, rank() OVER (ORDER BY (SELECT count(*) FROM u WHERE u.k = t.v)) FROM t GROUP BY v ORDER BY v
----
v:int4 | rank:int8
1 | 2
2 | 3
3 | 1

query
SELECT v, sum(w) OVER (), (SELECT count(*) FROM u WHERE u.k = t.v) FROM t GROUP BY v, w ORDER BY 1, 2
----
v:int4 | sum:int8 | count:int8
1 | 65 | 1
2 | 65 | 2
2 | 65 | 2
3 | 65 | 0

# Nested subqueries, derived tables, LATERAL and CTEs inside the subquery.
query
SELECT v, (SELECT (SELECT t.v + count(*) FROM u u2 WHERE u2.k = u.k) FROM u WHERE u.k = t.v LIMIT 1) FROM t GROUP BY v ORDER BY v
----
v:int4 | ?column?:int8
1 | 2
2 | 4
3 | NULL

query
SELECT v, (SELECT max(x) FROM (SELECT u.z + t.v AS x FROM u) q) FROM t GROUP BY v ORDER BY v
----
v:int4 | max:int4
1 | 202
2 | 203
3 | 204

query
SELECT v, (SELECT y FROM u, LATERAL (SELECT u.z + t.v AS y) l WHERE u.k = t.v ORDER BY y LIMIT 1) FROM t GROUP BY v ORDER BY v
----
v:int4 | y:int4
1 | 101
2 | 202
3 | NULL

query
SELECT v, (SELECT sum(g) FROM u, generate_series(u.k, t.v) g) FROM t GROUP BY v ORDER BY v
----
v:int4 | sum:int8
1 | 1
2 | 7
3 | 16

query
SELECT v, (WITH c AS (SELECT z FROM u WHERE u.k = t.v) SELECT sum(z) FROM c) FROM t GROUP BY v ORDER BY v
----
v:int4 | sum:int8
1 | 100
2 | 401
3 | NULL

query
SELECT v, (SELECT max(u.k) FROM u GROUP BY u.k HAVING u.k = t.v) FROM t GROUP BY v ORDER BY v
----
v:int4 | max:int4
1 | 1
2 | 2
3 | NULL

# Columns functionally dependent on a grouped primary key.
query
SELECT id, (SELECT p.name || p.x) FROM p GROUP BY id ORDER BY 1
----
id:int4 | ?column?:text
1 | a5
2 | b7

query
SELECT sum(x), p.name, (SELECT p.name || sum(p.x)) FROM p GROUP BY p.id ORDER BY 2
----
sum:int8 | name:text | ?column?:text
5 | a | a5
7 | b | b7

# An aggregate whose arguments reference only the outer query is the outer query's.
query
SELECT v, sum(w), (SELECT max(z) FROM u WHERE u.k = sum(t.w)) FROM t GROUP BY v ORDER BY v
----
v:int4 | sum:int8 | max:int4
1 | 10 | NULL
2 | 25 | 7
3 | 30 | 9

query
SELECT v, (SELECT sum(t.w)) FROM t GROUP BY v ORDER BY 1
----
v:int4 | sum:int8
1 | 10
2 | 25
3 | 30

query
SELECT (SELECT sum(w)) FROM t
----
sum:int8
65

query
SELECT (SELECT sum(w + z) FROM u) FROM t ORDER BY 1
