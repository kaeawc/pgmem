65 | 4

query
SELECT (SELECT 1 FROM u GROUP BY sum(t.w) LIMIT 1) FROM t
----
?column?:int4
1

query
SELECT v, (SELECT max(z) FROM u WHERE z > sum(t.w) + u.k) FROM t GROUP BY v ORDER BY 1
