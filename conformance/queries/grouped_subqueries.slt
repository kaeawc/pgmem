sum:int8
542
567
617
667

query
SELECT (SELECT (SELECT sum(t.w)) FROM u LIMIT 1) FROM t
----
sum:int8
65

query
SELECT (SELECT x FROM (SELECT sum(t.w) x) s) FROM t
