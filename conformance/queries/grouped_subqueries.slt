# GROUPING SETS / ROLLUP / CUBE.
query
SELECT v, w, (SELECT t.v + t.w) FROM t GROUP BY ROLLUP (v, w) ORDER BY 1, 2
----
v:int4 | w:int4 | ?column?:int4
1 | 10 | 11
1 | NULL | NULL
2 | 5 | 7
2 | 20 | 22
2 | NULL | NULL
3 | 30 | 33
3 | NULL | NULL
NULL | NULL | NULL

query
SELECT v, (SELECT sum(t.w) + count(*) FROM u WHERE u.k = t.v) FROM t GROUP BY GROUPING SETS ((v), ()) ORDER BY 1
----
v:int4 | ?column?:int8
1 | 11
2 | 27
3 | 30
NULL | 65

query
SELECT v, (SELECT GROUPING(t.v)) FROM t GROUP BY ROLLUP (v) ORDER BY 1
----
v:int4 | grouping:int4
1 | 0
2 | 0
3 | 0
NULL | 1

query
SELECT v, w, GROUPING(v, w), (SELECT GROUPING(t.v, t.w) * 10 + count(*) FROM u WHERE u.k = t.v) FROM t GROUP BY CUBE (v, w) ORDER BY 1, 2
----
v:int4 | w:int4 | grouping:int4 | ?column?:int8
1 | 10 | 0 | 1
1 | NULL | 1 | 11
2 | 5 | 0 | 2
2 | 20 | 0 | 2
2 | NULL | 1 | 12
3 | 30 | 0 | 0
3 | NULL | 1 | 10
NULL | 5 | 2 | 20
NULL | 10 | 2 | 20
NULL | 20 | 2 | 20
NULL | 30 | 2 | 20
NULL | NULL | 3 | 30

# Ungrouped outer references, and aggregates in clauses that do not allow them.
statement error 42803 subquery uses ungrouped column "t.w" from outer query
SELECT v, (SELECT w) FROM t GROUP BY v

statement error 42803 subquery uses ungrouped column "t.w" from outer query
SELECT v, (SELECT (SELECT t.w) FROM u LIMIT 1) FROM t GROUP BY v

statement error 42803 subquery uses ungrouped column "t.w" from outer query
SELECT v, (SELECT 1 FROM u WHERE u.k = t.w LIMIT 1) FROM t GROUP BY v

statement error 42803 subquery uses ungrouped column "t.w" from outer query
SELECT v, (SELECT x FROM generate_series(1, 2) x WHERE x = t.w) FROM t GROUP BY v

statement error 42803 subquery uses ungrouped column "t.w" from outer query
SELECT v FROM t GROUP BY v HAVING EXISTS (SELECT t.w)

statement error 42803 subquery uses ungrouped column "t.w" from outer query
SELECT v, (SELECT t.w) FROM t GROUP BY ROLLUP (v)

statement error 42803 subquery uses ungrouped column "t.v" from outer query
SELECT v + 1, (SELECT t.v + 1) FROM t GROUP BY v + 1

statement error 42803 subquery uses ungrouped column "t.w" from outer query
SELECT v, (SELECT sum(t.w + u.z) FROM u) FROM t GROUP BY v

statement error 42803 column "t.w" must appear in the GROUP BY clause or be used in an aggregate function
SELECT (SELECT sum(t.w)), w FROM t

statement error 42803 aggregate functions are not allowed in WHERE
SELECT count(*), (SELECT max(z) FROM u WHERE z > count(*)) FROM t

statement error 42803 aggregate function calls cannot be nested
SELECT v, (SELECT max(sum(t.w)) FROM u) FROM t GROUP BY v

statement error 42803 aggregate functions are not allowed in FROM clause of their own query level
SELECT * FROM t, LATERAL (SELECT sum(t.w)) s

statement error 42803 aggregate functions are not allowed in WHERE
SELECT * FROM t WHERE (SELECT sum(t.w)) > 0

statement error 42803 aggregate functions are not allowed in GROUP BY
SELECT v FROM t GROUP BY (SELECT sum(t.w)), v

statement error 42803 aggregate function calls cannot be nested
SELECT sum((SELECT sum(t.w))) FROM t

# EXISTS does not evaluate its subquery's select list, ORDER BY or DISTINCT.
query
SELECT 1 WHERE EXISTS (SELECT nextval('s3'))
----
?column?:int4
1

query
SELECT EXISTS (SELECT nextval('s3') FROM generate_series(1, 3) ORDER BY 1)
----
exists:bool
t

query
SELECT EXISTS (SELECT DISTINCT nextval('s3') FROM generate_series(1, 3))
----
exists:bool
t

query
SELECT EXISTS (SELECT nextval('s3') FROM generate_series(1, 3) LIMIT 1)
----
exists:bool
t

statement error 55000 currval of sequence "s3" is not yet defined in this session
SELECT currval('s3')

query
SELECT EXISTS (SELECT max(nextval('s3')) FROM generate_series(1, 3))
----
exists:bool
t

query
SELECT currval('s3')
----
currval:int8
3
