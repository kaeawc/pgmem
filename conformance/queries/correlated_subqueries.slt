# Subqueries correlated only through their FROM clause, LIMIT / OFFSET, ORDER BY, GROUP BY,
# HAVING, windows, CTEs or nested subqueries run once per outer row; uncorrelated ones run once.
statement ok
CREATE TABLE t (v int)

statement ok
INSERT INTO t VALUES (1), (2), (3)

statement ok
CREATE TABLE u (w int)

statement ok
INSERT INTO u VALUES (1), (2), (3)

query
SELECT v, (SELECT x FROM generate_series(v, v) x) FROM (VALUES (1), (2)) s(v)
----
v:int4 | x:int4
1 | 1
2 | 2

query
SELECT v, (SELECT x FROM generate_series(v, v) x) FROM t ORDER BY v
----
v:int4 | x:int4
1 | 1
2 | 2
3 | 3

query
SELECT v, (SELECT sum(x) FROM unnest(ARRAY[v, v * 2]) x) FROM t ORDER BY v
----
v:int4 | sum:int8
1 | 3
2 | 6
3 | 9

query
SELECT v, (SELECT x FROM abs(-v) x) FROM t ORDER BY v
----
v:int4 | x:int4
1 | 1
2 | 2
3 | 3

query
SELECT v, (SELECT y FROM u, LATERAL (SELECT w + v AS y) l WHERE w = 1) FROM t ORDER BY v
----
v:int4 | y:int4
1 | 2
2 | 3
3 | 4

query
SELECT v, (SELECT sum(x) FROM u, LATERAL generate_series(w, v) x) FROM t ORDER BY v
----
v:int4 | sum:int8
1 | 1
2 | 5
3 | 14

query
SELECT v, (SELECT z FROM (SELECT 1) a(q), LATERAL (SELECT x AS z FROM generate_series(v, v) x) l) FROM t ORDER BY v
----
v:int4 | z:int4
1 | 1
2 | 2
3 | 3

query
SELECT v, (SELECT y FROM (SELECT v * 10 AS y) d) FROM t ORDER BY v
----
v:int4 | y:int4
1 | 10
2 | 20
3 | 30

query
SELECT v, (SELECT y FROM (VALUES (v)) vv(y)) FROM t ORDER BY v
----
v:int4 | y:int4
1 | 1
2 | 2
3 | 3

query
SELECT v, (SELECT count(*) FROM u a JOIN u b ON a.w = b.w AND a.w <= v) FROM t ORDER BY v
----
v:int4 | count:int8
1 | 1
2 | 2
3 | 3

query
SELECT v, (SELECT count(*) FROM u JOIN generate_series(1, v) x ON x = w) FROM t ORDER BY v
----
v:int4 | count:int8
1 | 1
2 | 2
3 | 3

query
SELECT v, (SELECT sum(w) FROM (SELECT w FROM u ORDER BY w LIMIT v) s) FROM t ORDER BY v
----
v:int4 | sum:int8
1 | 1
2 | 3
3 | 6

query
SELECT v, (SELECT w FROM u ORDER BY w LIMIT 1 OFFSET v - 1) FROM t ORDER BY v
----
v:int4 | w:int4
1 | 1
2 | 2
3 | 3

query
SELECT v, (SELECT w FROM u ORDER BY abs(w - v) LIMIT 1) FROM t ORDER BY v
----
v:int4 | w:int4
1 | 1
2 | 2
3 | 3

query
SELECT v, (SELECT count(*) FROM (SELECT 1 FROM u GROUP BY w < v) g) FROM t ORDER BY v
----
v:int4 | count:int8
1 | 1
2 | 2
3 | 2

query
SELECT v, (SELECT count(*) FROM u HAVING count(*) > v) FROM t ORDER BY v
----
v:int4 | count:int8
1 | 3
2 | 3
3 | NULL

query
SELECT v, (SELECT max(r) FROM (SELECT sum(w) OVER (PARTITION BY w < v) r FROM u) s) FROM t ORDER BY v
----
v:int4 | max:int8
1 | 6
2 | 5
3 | 3

query
SELECT v, (SELECT max(r) FROM (SELECT sum(w) OVER (ORDER BY w ROWS BETWEEN v PRECEDING AND CURRENT ROW) r FROM u) s) FROM t ORDER BY v
----
v:int4 | max:int8
1 | 5
2 | 6
3 | 6

query
SELECT v, (WITH c AS (SELECT x FROM generate_series(v, v) x) SELECT x FROM c) FROM t ORDER BY v
----
v:int4 | x:int4
1 | 1
2 | 2
3 | 3

query
SELECT v, (SELECT x FROM generate_series(v, v) x UNION ALL SELECT 0 LIMIT 1) FROM t ORDER BY v
----
v:int4 | x:int4
1 | 1
2 | 2
3 | 3

query
SELECT v, (SELECT (SELECT x FROM generate_series(v, v) x) FROM u WHERE w = 1) AS s FROM t ORDER BY v
----
v:int4 | s:int4
1 | 1
2 | 2
3 | 3

query
SELECT v, (SELECT count(*) FROM u WHERE w IN (SELECT x FROM generate_series(1, v) x)) FROM t ORDER BY v
----
v:int4 | count:int8
1 | 1
2 | 2
3 | 3

query
SELECT v, l.y FROM t, LATERAL (SELECT (SELECT x FROM generate_series(v, v) x) AS y) l ORDER BY v
----
v:int4 | y:int4
1 | 1
2 | 2
3 | 3

query
SELECT v FROM t WHERE EXISTS (SELECT 1 FROM generate_series(v, 2) x) ORDER BY v
----
v:int4
1
2

query
SELECT v FROM t WHERE 2 IN (SELECT x FROM generate_series(v, 2) x) ORDER BY v
----
v:int4
1
2

query
SELECT v FROM t WHERE 2 = ANY (SELECT x FROM generate_series(v, v) x) ORDER BY v
----
v:int4
2

query
SELECT v FROM t WHERE 2 <= ALL (SELECT x FROM generate_series(v, 3) x) ORDER BY v
----
v:int4
2
3

query
SELECT v FROM t WHERE (v, v) IN (SELECT x, x FROM generate_series(v, v) x) ORDER BY v
----
v:int4
1
2
3

query
SELECT v, ARRAY(SELECT x FROM generate_series(1, v) x) FROM t ORDER BY v
----
v:int4 | array:_int4
1 | {1}
2 | {1,2}
3 | {1,2,3}

query
SELECT v, w FROM t JOIN u ON w = (SELECT x FROM generate_series(v, v) x) ORDER BY v
----
v:int4 | w:int4
1 | 1
2 | 2
3 | 3

# UPDATE SET and DELETE WHERE
statement ok
CREATE TABLE m (k int, a int, b int, d int[])

statement ok
INSERT INTO m VALUES (1, 0, 0, NULL), (2, 0, 0, NULL), (3, 0, 0, NULL)

statement ok
UPDATE m SET a = (SELECT x FROM generate_series(k, k) x), d = ARRAY(SELECT x FROM generate_series(1, k) x)

statement ok
UPDATE m SET (b) = (SELECT x * 10 FROM generate_series(k, k) x)

statement ok
DELETE FROM m WHERE EXISTS (SELECT 1 FROM generate_series(k, k) x WHERE x = 2)

query
SELECT k, a, b, d FROM m ORDER BY k
----
k:int4 | a:int4 | b:int4 | d:_int4
1 | 1 | 10 | {1}
3 | 3 | 30 | {1,2,3}

# Volatile functions in an uncorrelated subquery run once; correlated, once per row
query
SELECT count(DISTINCT r) FROM (SELECT (SELECT random()) r FROM t) s
----
count:int8
1

query
SELECT count(DISTINCT r) FROM (SELECT (SELECT random() FROM generate_series(v, v)) r FROM t) s
----
count:int8
3

statement ok
CREATE SEQUENCE sq

query
SELECT v, (SELECT nextval('sq')) FROM t ORDER BY v
----
v:int4 | nextval:int8
1 | 1
2 | 1
3 | 1

query
SELECT v, (SELECT nextval('sq') FROM generate_series(v, v)) FROM t ORDER BY v
----
v:int4 | nextval:int8
1 | 2
2 | 3
3 | 4
