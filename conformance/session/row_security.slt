statement ok
DROP ROLE conf_rlsp_a

# Moved partition rows, UPDATE ... FROM, DELETE ... USING, ON CONFLICT DO NOTHING, and a view
# owned by the superuser (no policies through it).

statement ok
DROP ROLE IF EXISTS conf_rlsq_a

statement ok
CREATE ROLE conf_rlsq_a

statement ok
CREATE TABLE pt (id int, who name, v int) PARTITION BY RANGE (id)

statement ok
CREATE TABLE pt1 PARTITION OF pt FOR VALUES FROM (0) TO (10)

statement ok
CREATE TABLE pt2 PARTITION OF pt FOR VALUES FROM (10) TO (20)

statement ok
GRANT ALL ON pt, pt1, pt2 TO PUBLIC

statement ok
INSERT INTO pt VALUES (1, 'conf_rlsq_a', 1), (2, 'x', 2)

statement ok
ALTER TABLE pt ENABLE ROW LEVEL SECURITY

statement ok
CREATE POLICY p ON pt USING (who = current_user) WITH CHECK (v < 50)

statement ok
SET ROLE conf_rlsq_a

statement error 42501 new row violates row-level security policy for table "pt"
UPDATE pt SET id = 15, v = 60 WHERE id = 1

query
UPDATE pt SET id = 15 WHERE id = 1 RETURNING *
----
id:int4 | who:name | v:int4
15 | conf_rlsq_a | 1

statement error 42501 new row violates row-level security policy for table "pt"
INSERT INTO pt VALUES (3, 'conf_rlsq_a', 99)

statement ok
RESET ROLE

statement ok
CREATE TABLE u (id int PRIMARY KEY, who name, v int)

statement ok
CREATE TABLE src (id int, v int)

statement ok
GRANT ALL ON u, src TO PUBLIC

statement ok
INSERT INTO u VALUES (1, 'conf_rlsq_a', 1), (2, 'x', 2)

statement ok
INSERT INTO src VALUES (1, 10), (2, 20)

statement ok
ALTER TABLE u ENABLE ROW LEVEL SECURITY

statement ok
CREATE POLICY p ON u USING (who = current_user)

statement ok
CREATE POLICY ins ON u FOR INSERT WITH CHECK (true)

statement ok
CREATE VIEW uv AS SELECT * FROM u WHERE v < 100 WITH CHECK OPTION

statement ok
GRANT ALL ON uv TO PUBLIC

statement ok
SET ROLE conf_rlsq_a

query
UPDATE u SET v = src.v FROM src WHERE u.id = src.id RETURNING u.id, u.v
----
id:int4 | v:int4
1 | 10

query
DELETE FROM u USING src WHERE u.id = src.id AND src.v = 20 RETURNING u.id
----
id:int4

statement ok
INSERT INTO u VALUES (2, 'x', 5) ON CONFLICT DO NOTHING

statement error 42501 new row violates row-level security policy for table "u"
INSERT INTO u VALUES (3, 'x', 5) ON CONFLICT DO NOTHING RETURNING id

query
SELECT id FROM u FOR UPDATE
----
id:int4
1

statement ok
INSERT INTO uv VALUES (4, 'x', 1)

statement error 44000 new row violates check option for view "uv"
