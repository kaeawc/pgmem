statement ok
DROP VIEW uv

statement ok
DROP TABLE pt, u, src

statement ok
DROP ROLE conf_rlsq_a

# SELECT ... FOR UPDATE / SHARE adds the UPDATE policies of the tables it locks; policy
# expressions keep the search_path they were created with and pin the relations they read;
# INSTEAD OF triggers see rows through the view owner's policies; EXECUTE / CALL refuse
# subqueries.

statement ok
DROP ROLE IF EXISTS conf_rlsx_a

statement ok
CREATE ROLE conf_rlsx_a

statement ok
CREATE TABLE lk (id int, who name)

statement ok
INSERT INTO lk VALUES (1, 'conf_rlsx_a'), (2, 'x')

statement ok
CREATE TABLE lk2 (id int)

statement ok
INSERT INTO lk2 VALUES (1), (2)

statement ok
GRANT ALL ON lk, lk2 TO PUBLIC

statement ok
ALTER TABLE lk ENABLE ROW LEVEL SECURITY

statement ok
CREATE POLICY lk_sel ON lk FOR SELECT USING (true)

statement ok
CREATE POLICY lk_upd ON lk FOR UPDATE USING (who = current_user)

statement ok
SET ROLE conf_rlsx_a

query
SELECT id FROM lk ORDER BY id
----
id:int4
1
2

query
SELECT id FROM lk ORDER BY id FOR UPDATE
----
id:int4
1

query
SELECT id FROM lk ORDER BY id FOR KEY SHARE
----
id:int4
1

query
SELECT lk.id FROM lk, lk2 WHERE lk.id = lk2.id ORDER BY 1 FOR UPDATE OF lk2
----
id:int4
1
2

query
SELECT x.id FROM lk x JOIN lk2 USING (id) ORDER BY 1 FOR NO KEY UPDATE OF x
----
id:int4
1

query
SELECT id FROM (SELECT * FROM lk) s ORDER BY 1 FOR SHARE
----
id:int4
1

query
SELECT (SELECT count(*) FROM lk) AS n FROM lk2 FOR UPDATE
----
n:int8
2
2

statement ok
RESET ROLE

statement ok
CREATE SCHEMA conf_rlsx_app

statement ok
CREATE FUNCTION conf_rlsx_app.lim() RETURNS int LANGUAGE sql AS 'SELECT 1'

statement ok
GRANT USAGE ON SCHEMA conf_rlsx_app TO PUBLIC

statement ok
CREATE TABLE pin (id int)

statement ok
INSERT INTO pin VALUES (2)

statement ok
GRANT ALL ON pin TO PUBLIC

statement ok
SET search_path = conf_rlsx_app, public

statement ok
CREATE POLICY lk_pin ON lk FOR SELECT TO conf_rlsx_a USING (lk.id = lim() OR id IN (SELECT id FROM pin))

statement ok
RESET search_path

statement ok
DROP POLICY lk_sel ON lk

statement ok
CREATE FUNCTION public.lim() RETURNS int LANGUAGE sql AS 'SELECT 0'

statement ok
SET ROLE conf_rlsx_a

query
SELECT id FROM lk ORDER BY id
----
id:int4
1
2

statement ok
RESET ROLE

statement ok
ALTER TABLE pin RENAME TO pin2

statement ok
ALTER TABLE lk RENAME TO lk3

statement ok
SET ROLE conf_rlsx_a

query
SELECT id FROM lk3 ORDER BY id
----
id:int4
1
2

statement ok
RESET ROLE

statement error 2BP01 cannot drop table pin2 because other objects depend on it
DROP TABLE pin2

statement ok
DROP TABLE pin2 CASCADE

query
SELECT count(*) FROM pg_policy WHERE polname = 'lk_pin'
----
count:int8
0

statement ok
CREATE VIEW lkv AS SELECT * FROM lk3

statement ok
ALTER VIEW lkv OWNER TO conf_rlsx_a

statement ok
CREATE TABLE lklog (id int)

statement ok
GRANT ALL ON lklog TO PUBLIC

statement ok
CREATE FUNCTION lklog_f() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN INSERT INTO lklog VALUES (OLD.id); RETURN OLD; END $$

statement ok
CREATE TRIGGER lkv_del INSTEAD OF DELETE ON lkv FOR EACH ROW EXECUTE FUNCTION lklog_f()

statement ok
CREATE POLICY lk_del ON lk3 FOR SELECT TO conf_rlsx_a USING (id = 2)

statement ok
DELETE FROM lkv

query
SELECT id FROM lklog
----
id:int4
2

statement ok
PREPARE lk_p(text) AS SELECT $1

statement error 0A000 cannot use subquery in EXECUTE parameter
EXECUTE lk_p((SELECT 'x'))

statement error 42803 aggregate functions are not allowed in EXECUTE parameters
EXECUTE lk_p(count(*)::text)

statement ok
CREATE PROCEDURE lk_proc(INOUT x text) LANGUAGE sql AS $$ SELECT x $$

statement error 0A000 cannot use subquery in CALL argument
CALL lk_proc((SELECT 'x'))

statement error 0A000 cannot use subquery in CALL argument
CALL lk_proc(EXISTS (SELECT 1)::text)

statement ok
DEALLOCATE lk_p

statement ok
DROP VIEW lkv

statement ok
DROP TABLE lk3, lk2, lklog

statement ok
DROP FUNCTION lklog_f()

statement ok
DROP PROCEDURE lk_proc(text)

statement ok
DROP FUNCTION public.lim()

statement ok
DROP SCHEMA conf_rlsx_app CASCADE

statement ok
DROP ROLE conf_rlsx_a
