# Prepared statements, functions, joins and partitioned tables under policies.

statement ok
DROP ROLE IF EXISTS conf_rlsp_a

statement ok
CREATE ROLE conf_rlsp_a

statement ok
CREATE TABLE t (id int, who name)

statement ok
GRANT ALL ON t TO PUBLIC

statement ok
INSERT INTO t VALUES (1, 'conf_rlsp_a'), (2, 'x')

statement ok
ALTER TABLE t ENABLE ROW LEVEL SECURITY

statement ok
CREATE POLICY p ON t USING (who = current_user)

statement ok
PREPARE q AS SELECT count(*) FROM t

query
EXECUTE q
----
count:int8
2

statement ok
SET ROLE conf_rlsp_a

query
EXECUTE q
----
count:int8
1

query
SELECT count(*) FROM t a JOIN t b ON a.id = b.id
----
count:int8
1

query
SELECT (SELECT count(*) FROM t), EXISTS (SELECT 1 FROM t WHERE id = 2)
----
count:int8 | exists:bool
1 | f

statement ok
RESET ROLE

statement ok
CREATE FUNCTION cnt() RETURNS bigint LANGUAGE sql AS 'SELECT count(*) FROM t'

statement ok
CREATE FUNCTION pcnt() RETURNS bigint LANGUAGE plpgsql AS $$ BEGIN RETURN (SELECT count(*) FROM t); END $$

statement ok
CREATE TABLE log (n bigint)

statement ok
GRANT ALL ON log TO PUBLIC

statement ok
SET ROLE conf_rlsp_a

query
SELECT cnt(), pcnt()
----
cnt:int8 | pcnt:int8
1 | 1

statement ok
INSERT INTO log SELECT count(*) FROM t

query
SELECT * FROM log
----
n:int8
1

statement ok
RESET ROLE

statement ok
CREATE TABLE pt (id int, who name) PARTITION BY RANGE (id)

statement ok
CREATE TABLE pt1 PARTITION OF pt FOR VALUES FROM (0) TO (10)

statement ok
CREATE TABLE pt2 PARTITION OF pt FOR VALUES FROM (10) TO (20)

statement ok
GRANT ALL ON pt, pt1, pt2 TO PUBLIC

statement ok
INSERT INTO pt VALUES (1, 'conf_rlsp_a'), (2, 'x'), (11, 'conf_rlsp_a'), (12, 'x')

statement ok
ALTER TABLE pt ENABLE ROW LEVEL SECURITY

statement ok
CREATE POLICY p ON pt USING (who = current_user)

statement ok
SET ROLE conf_rlsp_a

query rowsort
SELECT * FROM pt
----
id:int4 | who:name
1 | conf_rlsp_a
11 | conf_rlsp_a

query rowsort
SELECT * FROM pt1
----
id:int4 | who:name
1 | conf_rlsp_a
2 | x

