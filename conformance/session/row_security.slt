# Row-level security: ALTER TABLE ... ROW LEVEL SECURITY, CREATE / ALTER / DROP POLICY, the
# pg_policy / pg_policies catalogs, and enforcement under SET ROLE. Roles are cluster-wide on
# PostgreSQL, so names are unique and dropped at the end.

statement ok
DROP ROLE IF EXISTS conf_rls_alice

statement ok
DROP ROLE IF EXISTS conf_rls_bob

statement ok
CREATE ROLE conf_rls_alice

statement ok
CREATE ROLE conf_rls_bob

statement ok
CREATE TABLE notes (id int PRIMARY KEY, author name NOT NULL, body text, private bool DEFAULT false)

statement ok
GRANT SELECT, INSERT, UPDATE, DELETE ON notes TO PUBLIC

statement ok
INSERT INTO notes VALUES (1, 'conf_rls_alice', 'a1', false), (2, 'conf_rls_alice', 'a2', true), (3, 'conf_rls_bob', 'b1', true)

statement ok
ALTER TABLE notes ENABLE ROW LEVEL SECURITY

query
SELECT relrowsecurity, relforcerowsecurity FROM pg_class WHERE relname = 'notes'
----
relrowsecurity:bool | relforcerowsecurity:bool
t | f

query
SELECT tablename, rowsecurity FROM pg_tables WHERE tablename = 'notes'
----
tablename:name | rowsecurity:bool
notes | t

statement ok
SET ROLE conf_rls_alice

query
SELECT count(*) FROM notes
----
count:int8
0

statement error 42501 new row violates row-level security policy for table "notes"
INSERT INTO notes VALUES (4, 'conf_rls_alice', 'a3')

statement ok
RESET ROLE

statement ok
CREATE POLICY own ON notes USING (author = current_user)

statement ok
CREATE POLICY public_read ON notes FOR SELECT USING (NOT private)

statement ok
CREATE POLICY no_shouting ON notes AS RESTRICTIVE FOR INSERT TO conf_rls_alice, conf_rls_bob WITH CHECK (body = lower(body))

statement ok
CREATE POLICY edit_window ON notes AS RESTRICTIVE FOR UPDATE USING (id < 100) WITH CHECK (id < 100)

query
SELECT schemaname, tablename, policyname, permissive, roles, cmd, qual, with_check FROM pg_policies ORDER BY policyname
----
schemaname:name | tablename:name | policyname:name | permissive:text | roles:_name | cmd:text | qual:text | with_check:text
public | notes | edit_window | RESTRICTIVE | {public} | UPDATE | (id < 100) | (id < 100)
public | notes | no_shouting | RESTRICTIVE | {conf_rls_alice,conf_rls_bob} | INSERT | NULL | (body = lower(body))
public | notes | own | PERMISSIVE | {public} | ALL | (author = CURRENT_USER) | NULL
public | notes | public_read | PERMISSIVE | {public} | SELECT | (NOT private) | NULL

query
SELECT polname, polcmd, polpermissive, polroles = '{0}' AS public, pg_get_expr(polqual, polrelid) AS qual, pg_get_expr(polwithcheck, polrelid) AS with_check
FROM pg_policy ORDER BY polname
----
polname:name | polcmd:char | polpermissive:bool | public:bool | qual:text | with_check:text
edit_window | w | f | t | (id < 100) | (id < 100)
no_shouting | a | f | f | NULL | (body = lower(body))
own | * | t | t | (author = CURRENT_USER) | NULL
public_read | r | t | t | (NOT private) | NULL

statement ok
SET ROLE conf_rls_alice

query rowsort
SELECT id, author, body FROM notes
----
id:int4 | author:name | body:text
1 | conf_rls_alice | a1
2 | conf_rls_alice | a2

query
SELECT row_security_active('notes')
----
row_security_active:bool
t

