----
count:int8 | row_security_active:bool
3 | f

statement ok
ALTER POLICY own ON notes RENAME TO mine

statement ok
ALTER POLICY public_read ON notes TO conf_rls_bob USING (NOT private AND id > 0)

query
SELECT policyname, roles, qual FROM pg_policies WHERE tablename = 'notes' AND cmd IN ('ALL', 'SELECT') ORDER BY 1
----
policyname:name | roles:_name | qual:text
mine | {public} | (author = CURRENT_USER)
public_read | {conf_rls_bob} | ((NOT private) AND (id > 0))

statement error 42710 policy "mine" for table "notes" already exists
