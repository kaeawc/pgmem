RESET ROLE

statement ok
SET ROLE conf_dmlp_user

query
SELECT grantee, table_name, privilege_type FROM information_schema.role_table_grants
WHERE table_name IN ('dmlpt', 'dmlps') ORDER BY 1, 2, 3
----
grantee:name | table_name:name | privilege_type:varchar
conf_dmlp_user | dmlps | SELECT

statement ok
RESET ROLE

