{"DateStyle=iso, dmy",statement_timeout=1000,TimeZone=UTC,"application_name=my app"}

statement ok
DO $$ BEGIN EXECUTE format('ALTER ROLE slt_rds_a IN DATABASE %I SET lock_timeout = %L', current_database(), '5s'); END $$

statement ok
DO $$ BEGIN EXECUTE format('ALTER DATABASE %I SET statement_timeout = %L', current_database(), '5s'); END $$

statement ok
DO $$ BEGIN EXECUTE format('ALTER ROLE ALL IN DATABASE %I SET search_path = d, public', current_database()); END $$

query
SELECT setrole::regrole, setconfig FROM pg_db_role_setting WHERE setdatabase = (SELECT oid FROM pg_database WHERE datname = current_database()) ORDER BY 1
----
setrole:regrole | setconfig:_text
- | {statement_timeout=5s,"search_path=d, public"}
slt_rds_a | {lock_timeout=5s}

# psql's \drds
query
SELECT rolname AS "Role", datname = current_database() AS "Database", pg_catalog.array_to_string(setconfig, E'\n') AS "Settings" FROM pg_catalog.pg_db_role_setting s LEFT JOIN pg_catalog.pg_database d ON d.oid = setdatabase LEFT JOIN pg_catalog.pg_roles r ON r.oid = setrole WHERE r.rolname = 'slt_rds_a' OR d.datname = current_database() ORDER BY 1, 2
----
Role:name | Database:bool | Settings:text
slt_rds_a | t | lock_timeout=5s
slt_rds_a | NULL | DateStyle=iso, dmy\nstatement_timeout=1000\nTimeZone=UTC\napplication_name=my app
NULL | t | statement_timeout=5s\nsearch_path=d, public

# A new session starts with the database's settings.
connection other
query
SELECT name, setting, source, reset_val FROM pg_settings WHERE name IN ('search_path', 'statement_timeout', 'lock_timeout') ORDER BY name
----
name:text | setting:text | source:text | reset_val:text
lock_timeout | 0 | default | 0
search_path | d, public | database | d, public
statement_timeout | 5000 | database | 5000

connection other
statement ok
SET search_path = public

connection other
statement ok
RESET search_path

connection other
query
SHOW search_path
----
search_path:text
d, public

statement ok
DO $$ BEGIN EXECUTE format('ALTER DATABASE %I RESET ALL', current_database()); END $$

statement ok
DO $$ BEGIN EXECUTE format('ALTER ROLE slt_rds_a IN DATABASE %I RESET ALL', current_database()); END $$

statement ok
ALTER ROLE slt_rds_a RESET ALL

