# ALTER ROLE / ALTER DATABASE ... SET and RESET: values checked when the statement runs, kept
# as written in pg_db_role_setting (pg_roles.rolconfig), applied to new sessions.

statement ok
CREATE ROLE slt_rds_a

statement ok
ALTER ROLE slt_rds_a SET search_path = 'x', "Y", z

statement ok
ALTER ROLE slt_rds_a SET work_mem = '8MB'

statement ok
ALTER USER slt_rds_a SET datestyle = german

statement ok
ALTER ROLE slt_rds_a SET statement_timeout = 1000

statement ok
ALTER ROLE slt_rds_a SET slt_rds.custom = 1.50

statement ok
ALTER ROLE slt_rds_a SET time zone 'UTC'

statement ok
ALTER ROLE slt_rds_a SET application_name = 'my app'

statement ok
ALTER ROLE slt_rds_a SET datestyle = iso, dmy

query
SELECT setdatabase, setconfig FROM pg_db_role_setting WHERE setrole = 'slt_rds_a'::regrole
----
setdatabase:oid | setconfig:_text
0 | {"search_path=x, \"Y\", z",work_mem=8MB,"DateStyle=iso, dmy",statement_timeout=1000,slt_rds.custom=1.50,TimeZone=UTC,"application_name=my app"}

query
SELECT rolconfig FROM pg_roles WHERE rolname = 'slt_rds_a'
----
rolconfig:_text
{"search_path=x, \"Y\", z",work_mem=8MB,"DateStyle=iso, dmy",statement_timeout=1000,slt_rds.custom=1.50,TimeZone=UTC,"application_name=my app"}

statement error 22023 invalid value for parameter "work_mem": "abc"
ALTER ROLE slt_rds_a SET work_mem = 'abc'

statement error 22023 -5 ms is outside the valid range for parameter "statement_timeout" (0 ms .. 2147483647 ms)
ALTER ROLE slt_rds_a SET statement_timeout = '-5'

statement error 42704 unrecognized configuration parameter "slt_rds_nosuch"
ALTER ROLE slt_rds_a SET slt_rds_nosuch = 1

statement error 42704 unrecognized configuration parameter "slt_rds_nosuch"
ALTER ROLE slt_rds_a RESET slt_rds_nosuch

statement error 55P02 parameter "server_version" cannot be changed
ALTER ROLE slt_rds_a SET server_version = '1'

statement error 55P02 parameter "shared_buffers" cannot be changed without restarting the server
ALTER ROLE slt_rds_a SET shared_buffers = '1MB'

statement error 55P02 parameter "ignore_system_indexes" cannot be set after connection start
ALTER ROLE slt_rds_a SET ignore_system_indexes = on

statement error 55P02 parameter "archive_command" cannot be changed now
ALTER ROLE slt_rds_a SET archive_command = 'x'

statement error 25001 SET TRANSACTION ISOLATION LEVEL must be called before any query
ALTER ROLE slt_rds_a SET transaction_isolation = 'serializable'

statement error 42704 role "slt_rds_nosuch" does not exist
ALTER ROLE slt_rds_nosuch SET work_mem = '1MB'

statement error 42704 role "all" does not exist
ALTER ROLE "all" SET work_mem = '1MB'

statement error 3D000 database "slt_rds_nosuch" does not exist
ALTER DATABASE slt_rds_nosuch SET work_mem = '1MB'

statement error 3D000 database "slt_rds_nosuch" does not exist
ALTER ROLE slt_rds_a IN DATABASE slt_rds_nosuch SET work_mem = '1MB'

statement ok
ALTER ROLE slt_rds_a RESET work_mem

statement ok
ALTER ROLE slt_rds_a RESET lock_timeout

statement ok
ALTER ROLE slt_rds_a SET search_path TO DEFAULT

statement ok
ALTER ROLE slt_rds_a SET slt_rds.custom = DEFAULT

