# EXPLAIN, VACUUM, ANALYZE and other utility statements: acceptance only.

statement ok
CREATE TABLE t (id int PRIMARY KEY, v text)

statement ok
INSERT INTO t SELECT g, 'v' || g FROM generate_series(1, 100) g

# EXPLAIN (output differs between servers, so only acceptance is checked)
statement ok
EXPLAIN SELECT * FROM t WHERE id = 1

statement ok
EXPLAIN (COSTS OFF) SELECT * FROM t ORDER BY v

statement ok
EXPLAIN ANALYZE SELECT count(*) FROM t

statement ok
EXPLAIN (ANALYZE, BUFFERS, FORMAT JSON) SELECT * FROM t WHERE id < 10

statement ok
EXPLAIN (FORMAT YAML) SELECT 1

statement ok
EXPLAIN (VERBOSE, COSTS OFF, SUMMARY OFF) INSERT INTO t VALUES (1000, 'x')

query
SELECT count(*) FROM t WHERE id = 1000
----
count:int8
0

statement ok
EXPLAIN ANALYZE INSERT INTO t VALUES (1001, 'y')

query
SELECT count(*) FROM t WHERE id = 1001
----
count:int8
1

statement error 42P01 relation "missing_table" does not exist
EXPLAIN SELECT * FROM missing_table

# VACUUM / ANALYZE
statement ok
VACUUM

statement ok
VACUUM t

statement ok
VACUUM (VERBOSE, ANALYZE) t

statement ok
VACUUM FULL t

statement ok
ANALYZE

statement ok
ANALYZE t

statement ok
ANALYZE t (v)

statement ok
ANALYZE VERBOSE t

statement error 42P01 relation "missing_table" does not exist
VACUUM missing_table

statement ok
BEGIN

statement error 25001 VACUUM cannot run inside a transaction block
VACUUM t

statement ok
ROLLBACK

# other maintenance commands
statement ok
REINDEX TABLE t

statement ok
CLUSTER t USING t_pkey

statement ok
CHECKPOINT

statement error 25P01 LOCK TABLE can only be used in transaction blocks
LOCK TABLE t IN ACCESS SHARE MODE

statement ok
BEGIN

statement ok
LOCK TABLE t IN ACCESS EXCLUSIVE MODE NOWAIT

statement ok
COMMIT

# session information functions
query
SELECT pg_backend_pid() > 0
----
?column?:bool
t

query
SELECT pg_backend_pid() = pg_backend_pid()
----
?column?:bool
t

query
SELECT current_user = session_user, current_user IS NOT NULL
----
?column?:bool | ?column?:bool
t | t

query
SELECT pg_is_in_recovery()
----
pg_is_in_recovery:bool
f

query
SELECT txid_current() > 0, pg_current_xact_id() IS NOT NULL
----
?column?:bool | ?column?:bool
t | t

query
SELECT now() = transaction_timestamp(), statement_timestamp() >= now()
----
?column?:bool | ?column?:bool
t | t

query
SELECT pg_postmaster_start_time() <= now()
----
?column?:bool
t

query
SELECT inet_server_port() IS NULL OR inet_server_port() > 0
----
?column?:bool
t

query
SELECT pg_sleep(0)
----
pg_sleep:void
(empty)

query
SELECT pg_cancel_backend(0)
----
pg_cancel_backend:bool
f

query
SELECT has_table_privilege('t', 'SELECT'), has_schema_privilege('public', 'USAGE')
----
has_table_privilege:bool | has_schema_privilege:bool
t | t

query
SELECT pg_relation_size('t') >= 0, pg_total_relation_size('t') >= 0
----
?column?:bool | ?column?:bool
t | t

query
SELECT pg_advisory_lock(1), pg_try_advisory_lock(2), pg_advisory_unlock(1), pg_advisory_unlock_all()
----
pg_advisory_lock:void | pg_try_advisory_lock:bool | pg_advisory_unlock:bool | pg_advisory_unlock_all:void
(empty) | t | t | (empty)

query
SELECT pg_try_advisory_xact_lock(7)
----
pg_try_advisory_xact_lock:bool
t

# DO blocks (migration files)
statement ok
DO $$ BEGIN PERFORM 1; END $$

statement ok
DO $$ BEGIN IF NOT EXISTS (SELECT 1 FROM pg_class WHERE relname = 'u') THEN CREATE TABLE u (x int); END IF; END $$

query
SELECT to_regclass('u') IS NOT NULL
----
?column?:bool
t
