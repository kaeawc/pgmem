       has_column_privilege('conf_colp_reader', 'colp', 'id', 'INSERT'),
       has_column_privilege('conf_colp_reader', 'colp', 'email', 'UPDATE WITH GRANT OPTION'),
       has_any_column_privilege('conf_colp_reader', 'colp', 'UPDATE WITH GRANT OPTION'),
       has_any_column_privilege('conf_colp_reader', 'colp', 'INSERT WITH GRANT OPTION')
----
has_column_privilege:bool | has_column_privilege:bool | has_column_privilege:bool | has_any_column_privilege:bool | has_any_column_privilege:bool
f | f | t | t | f

