statement error 42501 permission denied for view colpv
UPDATE colpv SET email = 'w' WHERE id = 1

statement error 42501 permission denied for view colpv
UPDATE colpv SET email = 'w' RETURNING email

statement error 42501 permission denied for view colpv
DELETE FROM colpv

statement ok
INSERT INTO colpw (id) VALUES (12)

statement ok
