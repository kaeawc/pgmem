# Column-level privileges: GRANT / REVOKE with a column list set pg_attribute.attacl (not
# relacl) and are enforced per column. Roles are cluster-wide on PostgreSQL, so names are
# unique and dropped at the end. Grantor names are replaced by U (the session user differs).

statement ok
DROP ROLE IF EXISTS conf_colp_reader

statement ok
CREATE ROLE conf_colp_reader

statement ok
CREATE TABLE colp (id int PRIMARY KEY, email text, secret text)

statement ok
INSERT INTO colp VALUES (1, 'a', 's')

statement ok
GRANT SELECT (id, email), INSERT (id, email), UPDATE (email) ON colp TO conf_colp_reader

statement ok
GRANT REFERENCES (id) ON colp TO conf_colp_reader WITH GRANT OPTION

query
SELECT relacl IS NULL FROM pg_class WHERE relname = 'colp'
----
?column?:bool
t

query
SELECT attname, replace(attacl::text, session_user, 'U') FROM pg_attribute
WHERE attrelid = 'colp'::regclass AND attnum > 0 ORDER BY attnum
----
attname:name | replace:text
id | {conf_colp_reader=arx*/U}
email | {conf_colp_reader=arw/U}
secret | NULL

query
SELECT grantee, column_name, privilege_type, is_grantable FROM information_schema.column_privileges
WHERE table_name = 'colp' AND grantee = 'conf_colp_reader' ORDER BY column_name, privilege_type
----
grantee:name | column_name:name | privilege_type:varchar | is_grantable:varchar
conf_colp_reader | email | INSERT | NO
conf_colp_reader | email | SELECT | NO
conf_colp_reader | email | UPDATE | NO
conf_colp_reader | id | INSERT | NO
conf_colp_reader | id | REFERENCES | YES
conf_colp_reader | id | SELECT | NO

query
SELECT has_column_privilege('conf_colp_reader', 'colp', 'email', 'SELECT'),
       has_column_privilege('conf_colp_reader', 'colp', 'secret', 'SELECT'),
       has_any_column_privilege('conf_colp_reader', 'colp', 'UPDATE'),
       has_table_privilege('conf_colp_reader', 'colp', 'SELECT')
----
has_column_privilege:bool | has_column_privilege:bool | has_any_column_privilege:bool | has_table_privilege:bool
t | f | t | f

