statement ok
REVOKE SELECT, INSERT ON colp FROM conf_colp_reader

query
SELECT attname, replace(attacl::text, session_user, 'U') FROM pg_attribute
WHERE attrelid = 'colp'::regclass AND attnum > 0 ORDER BY attnum
----
attname:name | replace:text
id | {conf_colp_reader=x/U}
email | {conf_colp_reader=w/U}
secret | NULL

# Column privileges on a view used as the INSERT / UPDATE target are checked on the view's
# columns (also with an INSTEAD OF trigger); default privileges cannot have column lists; the
# grant option of column privileges; DROP COLUMN drops the column's grants.
statement ok
CREATE VIEW colpv AS SELECT id, email FROM colp

statement ok
GRANT UPDATE (email), INSERT (id, email) ON colpv TO conf_colp_reader

statement ok
CREATE VIEW colpw AS SELECT id, email || '!' AS e2 FROM colp

statement ok
CREATE FUNCTION colpw_f() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RETURN NEW; END $$

statement ok
CREATE TRIGGER colpw_t INSTEAD OF INSERT OR UPDATE ON colpw FOR EACH ROW EXECUTE FUNCTION colpw_f()

statement ok
GRANT INSERT (id), UPDATE (e2) ON colpw TO conf_colp_reader

statement ok
SET ROLE conf_colp_reader

statement ok
UPDATE colpv SET email = 'v'

statement ok
INSERT INTO colpv (id, email) VALUES (10, 'v')

statement ok
INSERT INTO colpv VALUES (11, 'v')

statement error 42501 permission denied for view colpv
